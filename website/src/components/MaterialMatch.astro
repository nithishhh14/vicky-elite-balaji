---
// "Find your material": a rule-based guide, not an AI engine and not a
// quote. It maps what someone is building and finishing to the material
// categories that suit it, then links to real pages and a pre-filled
// WhatsApp message. The rules are general material knowledge only.
import { business } from "../lib/business";

const building = ["Home", "Villa", "Apartment", "Office", "Hotel", "Restaurant", "Temple", "Commercial", "Renovation"];
const surfaces = [
  { id: "floor", label: "Floor" },
  { id: "wall", label: "Wall" },
  { id: "kitchen", label: "Kitchen" },
  { id: "bathroom", label: "Bathroom" },
  { id: "staircase", label: "Staircase" },
  { id: "facade", label: "Facade" },
  { id: "parking", label: "Parking & outdoor" },
  { id: "countertop", label: "Countertop" },
  { id: "feature", label: "Feature wall" },
];
const looks = ["Marble look", "Natural stone", "Wood look", "Concrete look", "Solid colour", "Decorative"];
const finishes = ["Matte", "Polished", "Textured", "Anti-skid"];
const sizes = ["Standard", "Large format", "Slab"];

// Category catalogue: every href is an existing page.
const categories = {
  granite: { label: "Granite", href: "/granite/", why: "Dense and hard-wearing; takes a polish, leathered or flamed finish." },
  marble: { label: "Marble", href: "/search/?q=marble", why: "Soft, luminous veining for feature floors, walls and counters." },
  tiles: { label: "Tiles & ceramics", href: "/halls/tiles/", why: "Widest choice of looks, sizes and finishes, easy to maintain." },
  largeTiles: { label: "Large-format tiles", href: "/search/?q=600x1200", why: "Fewer joints for a seamless look in large rooms." },
  quartz: { label: "Quartz surfaces", href: "/halls/quartz/", why: "Engineered, non-porous and consistent: ideal for busy kitchens." },
  kota: { label: "Kota stone", href: "/halls/kota-stone/", why: "Calm, fine-grained limestone for hard-wearing and outdoor floors." },
  kadappa: { label: "Kadappa", href: "/halls/kadappa/", why: "Black stone for kitchen platforms, borders and steps." },
  sanitary: { label: "Sanitaryware & fittings", href: "/halls/sanitaryware/", why: "Quartz and steel kitchen sinks, basins and fittings." },
  adhesive: { label: "Adhesives & grout", href: "/halls/adhesive/", why: "The right fixing system so floors don't hollow or lift." },
  custom: { label: "Custom stonecraft", href: "/custom/", why: "Engraving, name plates, tulsi madams and stone furniture, made to order." },
  laying: { label: "Laying & installation", href: "/halls/laying-works/", why: "Site measurement, laying and finishing by our own crews." },
};

const surfaceRules: Record<string, (keyof typeof categories)[]> = {
  floor: ["tiles", "largeTiles", "granite", "marble", "kota"],
  wall: ["tiles", "marble", "granite"],
  kitchen: ["granite", "quartz", "kadappa", "tiles"],
  bathroom: ["tiles", "sanitary", "adhesive"],
  staircase: ["granite", "marble", "kota"],
  facade: ["granite", "tiles", "custom"],
  parking: ["kota", "granite", "tiles"],
  countertop: ["granite", "quartz", "marble", "kadappa"],
  feature: ["marble", "granite", "custom", "tiles"],
};
const buildingRules: Record<string, (keyof typeof categories)[]> = {
  Temple: ["granite", "custom"],
  Commercial: ["largeTiles", "granite"],
  Office: ["largeTiles", "granite"],
  Hotel: ["marble", "largeTiles", "granite"],
  Restaurant: ["tiles", "granite", "quartz"],
  Renovation: ["tiles", "adhesive", "laying"],
  Villa: ["marble", "granite", "largeTiles"],
};
const lookRules: Record<string, (keyof typeof categories)[]> = {
  "Marble look": ["marble", "tiles", "quartz"],
  "Natural stone": ["granite", "kota", "kadappa"],
  "Wood look": ["tiles"],
  "Concrete look": ["tiles", "quartz"],
  "Solid colour": ["quartz", "tiles"],
  Decorative: ["tiles", "custom"],
};

const chip = "min-h-11 border border-paper/20 px-4 py-2 text-xs uppercase tracking-[0.14em] text-paper/80 transition-colors hover:border-brass aria-pressed:border-brass aria-pressed:bg-brass aria-pressed:text-charcoal-deep";
---

<div id="material-match" class="text-paper">
  <div class="grid gap-8 lg:grid-cols-2">
    <fieldset>
      <legend class="text-[0.65rem] uppercase tracking-[0.22em] text-brass">1 · What are you building?</legend>
      <div class="mt-3 flex flex-wrap gap-2" data-group="building">
        {building.map((b) => <button type="button" class={chip} aria-pressed="false" data-value={b}>{b}</button>)}
      </div>
    </fieldset>
    <fieldset>
      <legend class="text-[0.65rem] uppercase tracking-[0.22em] text-brass">2 · What are you finishing?</legend>
      <div class="mt-3 flex flex-wrap gap-2" data-group="surface" data-multi>
        {surfaces.map((s) => <button type="button" class={chip} aria-pressed="false" data-value={s.id}>{s.label}</button>)}
      </div>
    </fieldset>
    <fieldset>
      <legend class="text-[0.65rem] uppercase tracking-[0.22em] text-paper/60">3 · Look (optional)</legend>
      <div class="mt-3 flex flex-wrap gap-2" data-group="look">
        {looks.map((l) => <button type="button" class={chip} aria-pressed="false" data-value={l}>{l}</button>)}
      </div>
    </fieldset>
    <fieldset>
      <legend class="text-[0.65rem] uppercase tracking-[0.22em] text-paper/60">4 · Finish (optional)</legend>
      <div class="mt-3 flex flex-wrap gap-2" data-group="finish">
        {finishes.map((f) => <button type="button" class={chip} aria-pressed="false" data-value={f}>{f}</button>)}
      </div>
    </fieldset>
    <fieldset class="lg:col-span-2">
      <legend class="text-[0.65rem] uppercase tracking-[0.22em] text-paper/60">5 · Size (optional)</legend>
      <div class="mt-3 flex flex-wrap gap-2" data-group="size">
        {sizes.map((s) => <button type="button" class={chip} aria-pressed="false" data-value={s}>{s}</button>)}
      </div>
    </fieldset>
  </div>

  <div class="mt-10 border-t border-paper/15 pt-8" aria-live="polite">
    <p data-empty class="text-sm text-paper/60">Pick what you're finishing to see the materials that suit it.</p>
    <div data-results hidden class="mm-results">
      <p data-brief class="font-display text-2xl text-paper sm:text-3xl"></p>
      <div data-products-wrap class="mt-6" hidden>
        <p class="flex flex-wrap items-baseline gap-x-3 text-[0.65rem] uppercase tracking-[0.22em] text-brass">
          From our catalogue
          <span class="text-paper/60"><span data-mm-count class="font-display text-2xl normal-case tracking-normal text-paper tabular-nums">0</span> <span data-mm-count-label>materials match</span></span>
        </p>
        <ul data-products class="no-scrollbar -mx-5 mt-4 flex snap-x gap-3 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-0"></ul>
      </div>
      <p class="mt-8 text-[0.65rem] uppercase tracking-[0.22em] text-brass">Material categories to explore</p>
      <ul data-list class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></ul>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a data-wa target="_blank" rel="noopener" class="min-h-11 bg-gradient-to-r from-brass to-mustard-dark px-6 py-3 text-xs uppercase tracking-[0.2em] text-paper hover:brightness-110">Ask our team about this</a>
        <p class="text-xs text-paper/50">A quick guide based on general material properties, not a quote.</p>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ categories, surfaceRules, buildingRules, lookRules, phoneWa: business.phoneWa, surfaceLabels: Object.fromEntries(surfaces.map((s) => [s.id, s.label])) }}>
  (function () {
    var root = document.getElementById("material-match");
    if (!root) return;
    var state = { building: [], surface: [], look: [], finish: [], size: [] };
    var catalogue = null;
    var loading = null;
    function loadCatalogue() {
      if (catalogue || loading) return loading;
      loading = fetch("/search-index.json").then(function (r) { return r.json(); }).then(function (items) {
        catalogue = items.filter(function (i) { return i.category !== "Hall" && !/^(service|page)-/.test(i.id); });
        render();
      }).catch(function () { catalogue = []; });
      return loading;
    }
    // Fetch the catalogue as the finder approaches, so the first choice
    // renders results immediately (no late layout jump after the click).
    if ("IntersectionObserver" in window) {
      var preload = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) { loadCatalogue(); preload.disconnect(); }
      }, { rootMargin: "400px 0px" });
      preload.observe(root);
    }
    var surfaceTag = { floor: "flooring", wall: "walls", kitchen: "kitchen", bathroom: "bathroom", staircase: "staircase", facade: "exterior", parking: "exterior", countertop: "countertop", feature: "walls" };
    function productScore(p) {
      var text = (p.name + " " + p.hall + " " + p.category + " " + p.finish + " " + p.size + " " + p.applications.join(" ")).toLowerCase();
      var s = 0;
      var hits = 0;
      state.surface.forEach(function (sf) { if (p.applicationTags.indexOf(surfaceTag[sf]) > -1 || text.indexOf(sf) > -1) { s += 3; hits++; } });
      if (state.look.length && hitsLook(p)) { s += 2; hits++; }
      state.finish.forEach(function (f) {
        var ok = f === "Matte" ? /matt/.test(text) : f === "Polished" ? /polish|gloss/.test(text) : f === "Textured" ? /textur|leather|cleft|carving|rustic/.test(text) : /anti|matt|cleft|parking|outdoor/.test(text);
        if (ok) { s += 1; hits++; }
      });
      state.size.forEach(function (z) {
        var ok = z === "Large format" ? /1200|1600|2400|large/.test(text) : z === "Slab" ? /slab/.test(text) : /300|600 ?x ?600|standard/.test(text);
        if (ok) { s += 1; hits++; }
      });
      // Encode how many of the chosen groups this product satisfies, so items
      // matching the whole brief always rank above partial matches.
      var groupsWanted = (state.surface.length ? 1 : 0) + (state.look.length ? 1 : 0) + (state.finish.length ? 1 : 0) + (state.size.length ? 1 : 0);
      var groupsMet = 0;
      if (state.surface.some(function (sf) { return p.applicationTags.indexOf(surfaceTag[sf]) > -1 || text.indexOf(sf) > -1; })) groupsMet++;
      if (state.look.length) groupsMet += hitsLook(p);
      if (state.finish.length && /matt|polish|gloss|textur|leather|cleft|carving|rustic|anti|parking|outdoor/.test(text)) groupsMet += finishHit(text);
      if (state.size.length && sizeHit(text)) groupsMet++;
      return hits ? groupsMet * 100 + s - (groupsWanted - groupsMet) * 50 : 0;
    }
    function hitsLook(p) {
      // Look is judged on the product's own name/category/finish, never the
      // hall name ("Granite & Marbles" would make every granite "marble look").
      var text = (p.name + " " + p.category + " " + p.finish).toLowerCase();
      var l = state.look[0];
      var ok = l === "Marble look" ? /marble|veined|statuario|carrara|white slab/.test(text) || p.character.indexOf("veined") > -1
        : l === "Natural stone" ? /granite|kota|kadappa|marble/.test(text)
        : l === "Wood look" ? /wood/.test(text)
        : l === "Concrete look" ? /concrete|cement|grey/.test(text)
        : l === "Solid colour" ? /quartz|solid/.test(text)
        : /pattern|athangudi|moroccan|decor|floral/.test(text) || p.character.indexOf("patterned") > -1;
      return ok ? 1 : 0;
    }
    function finishHit(text) {
      var f = state.finish[0];
      return (f === "Matte" ? /matt/ : f === "Polished" ? /polish|gloss/ : f === "Textured" ? /textur|leather|cleft|carving|rustic/ : /anti|matt|cleft|parking|outdoor/).test(text) ? 1 : 0;
    }
    function sizeHit(text) {
      var z = state.size[0];
      return (z === "Large format" ? /1200|1600|2400|large/ : z === "Slab" ? /slab/ : /300|600 ?x ?600|standard/).test(text);
    }
    // The count eases to its new value so narrowing the brief feels live.
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function tweenCount(el, to) {
      if (!el) return;
      var from = Number(el.textContent) || 0;
      if (reduceMotion || from === to) { el.textContent = String(to); return; }
      var start = performance.now();
      (function step(now) {
        var t = Math.min(1, (now - start) / 450);
        el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      })(start);
    }
    function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
    root.querySelectorAll("[data-group]").forEach(function (group) {
      var key = group.getAttribute("data-group");
      var multi = group.hasAttribute("data-multi");
      group.querySelectorAll("button").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var val = btn.getAttribute("data-value");
          var on = btn.getAttribute("aria-pressed") === "true";
          if (!multi) {
            group.querySelectorAll("button").forEach(function (b) { b.setAttribute("aria-pressed", "false"); });
            state[key] = on ? [] : [val];
            btn.setAttribute("aria-pressed", String(!on));
          } else {
            btn.setAttribute("aria-pressed", String(!on));
            state[key] = on ? state[key].filter(function (v) { return v !== val; }) : state[key].concat(val);
          }
          render();
        });
      });
    });

    function render() {
      var empty = root.querySelector("[data-empty]");
      var results = root.querySelector("[data-results]");
      var list = root.querySelector("[data-list]");
      if (!state.surface.length && !state.look.length) {
        empty.hidden = false;
        results.hidden = true;
        return;
      }
      loadCatalogue();
      results.classList.remove("mm-in");
      void results.offsetWidth;
      results.classList.add("mm-in");

      // Live catalogue matches (real products only).
      var pwrap = root.querySelector("[data-products-wrap]");
      var plist = root.querySelector("[data-products]");
      if (catalogue) {
        var allMatches = catalogue.map(function (p) { return { p: p, s: productScore(p) }; }).filter(function (x) { return x.s > 0; })
          .sort(function (a, b) { return b.s - a.s; });
        var matches = allMatches.slice(0, 8);
        pwrap.hidden = matches.length === 0;
        tweenCount(root.querySelector("[data-mm-count]"), allMatches.length);
        root.querySelector("[data-mm-count-label]").textContent = (allMatches.length === 1 ? "material matches" : "materials match") + (allMatches.length > 8 ? " · top 8 shown" : "");
        plist.innerHTML = matches.map(function (x, i) {
          var p = x.p;
          return '<li class="mm-card w-[62vw] max-w-[15rem] flex-shrink-0 snap-start lg:w-auto lg:max-w-none" style="animation-delay:' + (i * 45) + 'ms"><a href="' + p.url + '" class="group block"><span class="block overflow-hidden bg-charcoal"><img src="' + p.image + '" alt="" loading="lazy" class="aspect-[4/3] w-full object-cover eb-img" /></span><span class="mt-2 block text-sm leading-snug text-paper group-hover:text-brass">' + esc(p.name) + '</span><span class="block text-[0.6rem] uppercase tracking-[0.16em] text-paper/50">' + esc(p.hall) + '</span></a></li>';
        }).join("");
      }
      var score = {};
      var add = function (keys, w) { (keys || []).forEach(function (k, i) { score[k] = (score[k] || 0) + w - i * 0.1; }); };
      state.surface.forEach(function (s) { add(surfaceRules[s], 3); });
      state.building.forEach(function (b) { add(buildingRules[b], 1.5); });
      state.look.forEach(function (l) { add(lookRules[l], 2); });
      if (state.surface.indexOf("parking") > -1 || state.finish.indexOf("Anti-skid") > -1) add(["kota", "granite", "tiles"], 0.5);
      var top = Object.keys(score).sort(function (a, b) { return score[b] - score[a]; }).slice(0, 6);
      list.innerHTML = "";
      top.forEach(function (key, i) {
        var c = categories[key];
        var li = document.createElement("li");
        li.className = "mm-card";
        li.style.animationDelay = (120 + i * 50) + "ms";
        li.innerHTML = '<a class="group block h-full border border-paper/15 p-4 transition-colors hover:border-brass" href="' + c.href + '"><span class="block font-display text-2xl">' + c.label + '</span><span class="mt-1 block text-sm text-paper/65">' + c.why + '</span><span class="mt-3 flex items-center gap-2 text-[0.6rem] uppercase tracking-[0.2em] text-brass">Explore <span class="arrow" aria-hidden="true">&rarr;</span></span></a>';
        list.appendChild(li);
      });
      var parts = [];
      if (state.building.length) parts.push("building a " + state.building[0].toLowerCase());
      if (state.surface.length) parts.push("finishing: " + state.surface.map(function (s) { return surfaceLabels[s].toLowerCase(); }).join(", "));
      if (state.look.length) parts.push("look: " + state.look[0].toLowerCase());
      if (state.finish.length) parts.push("finish: " + state.finish[0].toLowerCase());
      if (state.size.length) parts.push("size: " + state.size[0].toLowerCase());
      var briefBits = [
        state.building[0],
        state.surface.map(function (s) { return surfaceLabels[s]; }).join(" & "),
        state.look[0], state.finish[0], state.size[0],
      ].filter(Boolean);
      root.querySelector("[data-brief]").innerHTML = '<span class="text-paper/50">Your brief · </span>' + briefBits.map(esc).join(' <span class="text-brass">→</span> ');
      var msg = "Hi Elite Balaji, I'm " + parts.join("; ") + ". Which materials would you suggest, and what's available?";
      root.querySelector("[data-wa]").href = "https://wa.me/" + phoneWa + "?text=" + encodeURIComponent(msg);
      empty.hidden = true;
      results.hidden = false;
    }
  })();
</script>
