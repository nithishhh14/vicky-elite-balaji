---
import { getCollection } from "astro:content";
import { business } from "../lib/business";
import { materialWorlds, alsoStockedHallIds } from "../lib/material-worlds";

interface Props {
  // Homepage only: header floats transparent over the hero and gains its
  // dark bar once the page scrolls (reference mockup layout).
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const { pathname } = Astro.url;
const halls = await getCollection("halls");
const hallLink = (id: string) => {
  const hall = halls.find((h) => h.id === id);
  return { href: `/halls/${id}/`, label: hall?.data.name ?? id };
};

// Material-first grouping of the real halls, from the single shared config
// in lib/material-worlds.ts -- this powers the PRODUCTS dropdown.
const materialGroups = materialWorlds.map((world) => ({
  slug: world.slug,
  label: world.label,
  items: world.hallIds.map(hallLink),
}));
const alsoStocked = alsoStockedHallIds.map(hallLink);

const productPaths = ["/halls/", "/materials/", "/products/", "/search/", "/custom/", "/granite/"];
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : href === "#products" ? productPaths.some((p) => pathname.startsWith(p)) : pathname.startsWith(href);

// Primary nav, matching the client's reference mockup item-for-item.
const primary = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "#products", label: "Products", dropdown: true },
  { href: "/applications/", label: "Applications" },
  { href: "/gallery/", label: "Gallery" },
  { href: "/resources/", label: "Resources" },
  { href: "/contact/", label: "Contact" },
];

// Secondary strip wording from the reference, each pointing at a real page.
const secondary = [
  { href: "/granite/", label: "Natural Stones" },
  { href: "/materials/surfaces/", label: "Premium Surfaces" },
  { href: "/gallery/", label: "Timeless Spaces" },
];
---

<header
  id="site-header"
  data-overlay={overlay ? "true" : undefined}
  class:list={[
    "z-40 transition-colors duration-300",
    overlay ? "fixed inset-x-0 top-0 bg-transparent" : "sticky top-0 border-b border-paper/10 bg-charcoal-deep/95 backdrop-blur",
  ]}
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-4 lg:px-8">
    <a href="/" class="flex min-w-0 items-center gap-3 leading-none">
      <!-- The client's exact emblem (supplied 2026-09-15), used as-is: only
           cropped, scaled, and the outer teal backdrop made transparent.
           Never redraw or restyle it (client instruction). Full-resolution
           original cutout: /media/brand/logo-emblem.png. -->
      <img
        src="/media/brand/logo-emblem-240.png"
        alt=""
        aria-hidden="true"
        width="59"
        height="56"
        class="h-12 w-auto flex-shrink-0 sm:h-14"
      />
      <span class="flex min-w-0 flex-col">
        <span class="bg-gradient-to-b from-brass to-mustard-dark bg-clip-text font-display text-2xl italic text-transparent whitespace-nowrap sm:text-3xl">Elite Balaji</span>
        <span class="text-[0.55rem] uppercase tracking-[0.3em] text-brass whitespace-nowrap sm:text-[0.6rem]">Stones &amp; Ceramics</span>
        <span class="hidden text-[0.48rem] uppercase tracking-[0.25em] text-paper/50 whitespace-nowrap sm:block">— {business.subTagline} —</span>
      </span>
    </a>

    <nav aria-label="Primary" class="relative hidden items-center gap-7 xl:flex">
      {primary.map((item) =>
        item.dropdown ? (
          <div class="relative">
            <button
              id="materials-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="materials-menu"
              class:list={[
                "flex items-center gap-1.5 whitespace-nowrap py-1 text-xs font-medium uppercase tracking-[0.14em] transition-colors hover:text-brass",
                isActive(item.href) ? "text-brass" : "text-paper/85",
              ]}
            >
              {item.label}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div
              id="materials-menu"
              hidden
              class="absolute left-1/2 top-full z-40 mt-5 w-[600px] -translate-x-1/2 rounded-sm border border-line bg-paper p-8 shadow-lift"
            >
              <div class="mb-6 grid grid-cols-2 gap-3 border-b border-line/60 pb-6">
                <a href="/granite/" class="group flex items-center gap-3">
                  <img src="/media/client/granite/black-galaxy-closeup-720.jpg" alt="" class="h-14 w-14 object-cover" loading="lazy" />
                  <span><span class="block font-display text-xl text-ink group-hover:text-mustard-dark">Granite</span><span class="text-[0.6rem] uppercase tracking-[0.18em] text-ink-soft">From our slab yard</span></span>
                </a>
                <a href="/custom/" class="group flex items-center gap-3">
                  <img src="/media/client/stonecraft/engraved-rose-granite-720.jpg" alt="" class="h-14 w-14 object-cover" loading="lazy" />
                  <span><span class="block font-display text-xl text-ink group-hover:text-mustard-dark">Custom Stonecraft</span><span class="text-[0.6rem] uppercase tracking-[0.18em] text-ink-soft">Engraving &amp; stone furniture</span></span>
                </a>
              </div>
              <div class="grid grid-cols-3 gap-8">
                {materialGroups.map((group) => (
                  <div>
                    <a href={`/materials/${group.slug}/`} class="text-[0.65rem] uppercase tracking-[0.2em] text-terracotta hover:text-terracotta-dark">
                      {group.label} &rarr;
                    </a>
                    <ul class="mt-3 space-y-2">
                      {group.items.map((hall) => (
                        <li><a href={hall.href} class="text-sm text-ink hover:text-terracotta transition-colors">{hall.label}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-line/60 pt-5">
                <div class="flex flex-wrap gap-x-5 gap-y-1">
                  <span class="text-[0.65rem] uppercase tracking-[0.2em] text-ink-soft/60">Also:</span>
                  {alsoStocked.map((hall) => (
                    <a href={hall.href} class="text-xs text-ink-soft hover:text-terracotta transition-colors">{hall.label}</a>
                  ))}
                  <a href="/halls/laying-works/" class="text-xs text-ink-soft hover:text-terracotta transition-colors">Laying Works</a>
                </div>
                <a href="/search/" class="text-xs font-semibold uppercase tracking-wide text-terracotta hover:text-terracotta-dark whitespace-nowrap">
                  Full catalogue &rarr;
                </a>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "relative whitespace-nowrap py-1 text-xs font-medium uppercase tracking-[0.14em] transition-colors hover:text-brass",
              isActive(item.href) ? "text-brass after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px after:bg-brass" : "text-paper/85",
            ]}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="flex flex-shrink-0 items-center gap-1 sm:gap-3">
      <a
        href="/search/"
        class="inline-flex h-10 w-10 items-center justify-center text-paper/85 hover:text-brass transition-colors"
        aria-label="Search the catalogue"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" stroke-linecap="round" />
        </svg>
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        class="inline-flex h-10 w-10 items-center justify-center text-paper hover:text-brass transition-colors"
      >
        <span class="sr-only">Open menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Secondary strip, reference wording, real destinations. -->
  <div class="hidden lg:block">
    <div class="mx-auto flex max-w-7xl items-center justify-end gap-5 px-8 pb-3">
      {secondary.map((link, i) => (
        <>
          {i > 0 && <span class="text-paper/25" aria-hidden="true">|</span>}
          <a href={link.href} class="whitespace-nowrap text-[0.62rem] uppercase tracking-[0.25em] text-paper/55 hover:text-brass transition-colors">
            {link.label}
          </a>
        </>
      ))}
    </div>
  </div>

  <!-- Menu drawer: the reference shows a hamburger at every width, so this
       is available on desktop too (it carries the full hall list). -->
  <nav id="site-menu" aria-label="Site menu" hidden class="max-h-[calc(100svh-5rem)] overflow-y-auto border-t border-paper/10 bg-charcoal-deep px-5 py-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <ul class="flex flex-col gap-3">
        {primary.filter((p) => !p.dropdown).map((item) => (
          <li><a href={item.href} class="text-sm uppercase tracking-[0.14em] text-paper/85 hover:text-brass">{item.label}</a></li>
        ))}
        <li><a href="/granite/" class="text-sm uppercase tracking-[0.14em] text-brass hover:text-paper">Granite</a></li>
        <li><a href="/custom/" class="text-sm uppercase tracking-[0.14em] text-brass hover:text-paper">Custom Stonecraft</a></li>
        <li><a href="/search/" class="text-sm uppercase tracking-[0.14em] text-paper/85 hover:text-brass">Full catalogue</a></li>
      </ul>
      {materialGroups.map((group) => (
        <div>
          <a href={`/materials/${group.slug}/`} class="text-[0.65rem] uppercase tracking-[0.2em] text-brass">{group.label}</a>
          <ul class="mt-3 flex flex-col gap-2">
            {group.items.map((hall) => (
              <li><a href={hall.href} class="text-sm text-paper/80 hover:text-brass">{hall.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <p class="text-[0.65rem] uppercase tracking-[0.2em] text-brass">Also stocked &amp; services</p>
        <ul class="mt-3 flex flex-col gap-2">
          {alsoStocked.map((hall) => (
            <li><a href={hall.href} class="text-sm text-paper/80 hover:text-brass">{hall.label}</a></li>
          ))}
          <li><a href="/halls/laying-works/" class="text-sm text-paper/80 hover:text-brass">Laying Works</a></li>
          <li><a href="/custom/" class="text-sm text-paper/80 hover:text-brass">Custom &amp; Fabrication</a></li>
          <li><a href="/halls/" class="text-sm text-paper/80 hover:text-brass">All halls</a></li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("site-menu");

    // Overlay header: transparent over the hero, solid once scrolled or
    // whenever a menu is open (so menu text never sits on the photo).
    function syncHeader() {
      if (!header || header.dataset.overlay !== "true") return;
      const solid = window.scrollY > 40 || (menu && !menu.hidden);
      header.classList.toggle("bg-charcoal-deep/95", solid);
      header.classList.toggle("backdrop-blur", solid);
      header.classList.toggle("bg-transparent", !solid);
    }
    window.addEventListener("scroll", syncHeader, { passive: true });
    syncHeader();

    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const isOpen = !menu.hidden;
        menu.hidden = isOpen;
        toggle.setAttribute("aria-expanded", String(!isOpen));
        syncHeader();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !menu.hidden) {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          syncHeader();
        }
      });
    }
  })();

  (function () {
    const toggle = document.getElementById("materials-toggle");
    const menu = document.getElementById("materials-menu");
    if (!toggle || !menu) return;

    function close() {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    }
    toggle.addEventListener("click", () => {
      menu.hidden = !menu.hidden;
      toggle.setAttribute("aria-expanded", String(!menu.hidden));
    });
    document.addEventListener("click", (e) => {
      if (!menu.hidden && !menu.contains(e.target) && !toggle.contains(e.target)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) close();
    });
  })();
</script>
