---
import { getCollection } from "astro:content";
import { business, telLink } from "../lib/business";
import { materialWorlds, alsoStockedHallIds } from "../lib/material-worlds";

const { pathname } = Astro.url;
const halls = await getCollection("halls");
const hallLink = (id: string) => {
  const hall = halls.find((h) => h.id === id);
  return { href: `/halls/${id}/`, label: hall?.data.name ?? id };
};

// Material-first grouping of the real halls (not a flat business-category
// list) -- grouped by what a customer is actually shopping for, from the
// single shared config in lib/material-worlds.ts.
const materialGroups = materialWorlds.map((world) => ({
  slug: world.slug,
  label: world.label,
  items: world.hallIds.map(hallLink),
}));
const alsoStocked = alsoStockedHallIds.map(hallLink);

const allHalls = [
  ...materialGroups.flatMap((g) => g.items),
  ...alsoStocked,
  { href: "/halls/laying-works/", label: "Laying Works" },
];
const materialsActive =
  allHalls.some((h) => pathname.startsWith(h.href)) || pathname === "/halls/" || pathname.startsWith("/materials/");
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-3">
    <a href="/" class="flex flex-shrink-0 flex-col leading-none">
      <span class="font-display text-lg font-semibold tracking-wide text-ink whitespace-nowrap">Elite Balaji</span>
      <span class="text-[0.6rem] uppercase tracking-[0.25em] text-terracotta whitespace-nowrap">Stones &amp; Ceramics</span>
    </a>

    <nav aria-label="Primary" class="relative hidden items-center gap-5 text-sm lg:flex">
      <div class="relative">
        <button
          id="materials-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="materials-menu"
          class:list={[
            "flex items-center gap-1.5 whitespace-nowrap text-xs font-medium uppercase tracking-wide hover:text-terracotta transition-colors",
            materialsActive ? "text-terracotta" : "text-ink-soft",
          ]}
        >
          Materials
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          id="materials-menu"
          hidden
          class="absolute left-1/2 top-full z-40 mt-4 w-[560px] -translate-x-1/2 rounded-sm border border-line bg-paper p-8 shadow-lift"
        >
          <div class="grid grid-cols-3 gap-8">
            {materialGroups.map((group) => (
              <div>
                <a href={`/materials/${group.slug}/`} class="text-[0.65rem] uppercase tracking-[0.2em] text-terracotta hover:text-terracotta-dark">
                  {group.label} &rarr;
                </a>
                <ul class="mt-3 space-y-2">
                  {group.items.map((item) => (
                    <li><a href={item.href} class="text-sm text-ink hover:text-terracotta transition-colors">{item.label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-line/60 pt-5">
            <div class="flex flex-wrap gap-x-5 gap-y-1">
              <span class="text-[0.65rem] uppercase tracking-[0.2em] text-ink-soft/60">Also stocked:</span>
              {alsoStocked.map((item) => (
                <a href={item.href} class="text-xs text-ink-soft hover:text-terracotta transition-colors">{item.label}</a>
              ))}
            </div>
            <a href="/halls/" class="text-xs font-semibold uppercase tracking-wide text-terracotta hover:text-terracotta-dark whitespace-nowrap">
              View all halls &rarr;
            </a>
          </div>
        </div>
      </div>
      <a
        href="/halls/laying-works/"
        class:list={[
          "whitespace-nowrap text-xs font-medium uppercase tracking-wide hover:text-terracotta transition-colors",
          pathname.startsWith("/halls/laying-works/") ? "text-terracotta" : "text-ink-soft",
        ]}
      >
        Laying Works
      </a>
      <a
        href="/custom/"
        class:list={[
          "whitespace-nowrap text-xs font-medium uppercase tracking-wide hover:text-terracotta transition-colors",
          pathname.startsWith("/custom/") ? "text-terracotta" : "text-ink-soft",
        ]}
      >
        Custom
      </a>
      <a href="/about/" class="whitespace-nowrap text-xs font-medium uppercase tracking-wide text-ink-soft hover:text-terracotta transition-colors">
        About
      </a>
    </nav>

    <div class="flex flex-shrink-0 items-center gap-2">
      <a
        href="/search/"
        class="inline-flex items-center justify-center rounded-full border border-line p-2.5 text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
        aria-label="Search the catalogue"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" stroke-linecap="round" />
        </svg>
      </a>
      <a
        href={telLink()}
        class="hidden whitespace-nowrap rounded-full border border-terracotta/60 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-terracotta hover:bg-terracotta hover:text-paper transition-colors sm:inline-block"
      >
        Call {business.phoneDisplay}
      </a>
      <a
        href={telLink()}
        class="inline-flex items-center justify-center rounded-full border border-terracotta/60 p-2.5 text-terracotta sm:hidden"
        aria-label={`Call ${business.phoneDisplay}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8Z"/>
        </svg>
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex items-center justify-center rounded-full border border-line p-2.5 text-ink lg:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" hidden class="border-t border-line/60 bg-paper px-5 py-4 lg:hidden">
    <ul class="flex flex-col gap-4 text-sm">
      {materialGroups.map((group) => (
        <li>
          <p class="text-[0.65rem] uppercase tracking-[0.2em] text-terracotta">{group.label}</p>
          <ul class="mt-2 flex flex-col gap-2 pl-1">
            {group.items.map((item) => (
              <li><a href={item.href} class="block text-sm text-ink hover:text-terracotta">{item.label}</a></li>
            ))}
          </ul>
        </li>
      ))}
      <li class="border-t border-line/60 pt-3">
        <p class="text-[0.65rem] uppercase tracking-[0.2em] text-ink-soft/60">Also stocked</p>
        <ul class="mt-2 flex flex-col gap-2 pl-1">
          {alsoStocked.map((item) => (
            <li><a href={item.href} class="block text-sm text-ink hover:text-terracotta">{item.label}</a></li>
          ))}
          <li><a href="/halls/laying-works/" class="block text-sm text-ink hover:text-terracotta">Laying Works</a></li>
        </ul>
      </li>
      <li class="border-t border-line/60 pt-3">
        <a href="/halls/" class="block py-1 text-xs font-medium uppercase tracking-wide text-ink-soft hover:text-terracotta">All halls</a>
      </li>
      <li>
        <a href="/custom/" class="block py-1 text-xs font-medium uppercase tracking-wide text-ink-soft hover:text-terracotta">Custom &amp; Fabrication</a>
      </li>
      <li>
        <a href="/search/" class="block py-1 text-xs font-medium uppercase tracking-wide text-ink-soft hover:text-terracotta">Explore &amp; Filter</a>
      </li>
      <li>
        <a href="/about/" class="block py-1 text-xs font-medium uppercase tracking-wide text-ink-soft hover:text-terracotta">About</a>
      </li>
      <li>
        <a href="/contact/" class="block py-1 text-xs font-medium uppercase tracking-wide text-ink-soft hover:text-terracotta">Contact</a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const toggle = document.getElementById("menu-toggle");
    const nav = document.getElementById("mobile-nav");
    if (!toggle || !nav) return;
    toggle.addEventListener("click", () => {
      const isOpen = !nav.hidden;
      nav.hidden = isOpen;
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });
  })();

  (function () {
    const toggle = document.getElementById("materials-toggle");
    const menu = document.getElementById("materials-menu");
    if (!toggle || !menu) return;

    function close() {
      menu.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
    }
    function open() {
      menu.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
    }

    toggle.addEventListener("click", () => {
      if (menu.hidden) open();
      else close();
    });
    document.addEventListener("click", (e) => {
      if (!menu.hidden && !menu.contains(e.target) && e.target !== toggle) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) close();
    });
  })();
</script>
