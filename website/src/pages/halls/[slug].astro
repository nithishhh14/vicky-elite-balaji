---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaterialField from "../../components/MaterialField.astro";
import SaveButton from "../../components/SaveButton.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, emailQuoteLink, productEnquiryMessage } from "../../lib/business";
import { deriveColours } from "../../lib/facets";
import { imageBadge } from "../../lib/image-badge";
import { metaText, pageTitle } from "../../lib/seo";
import { sanitarywareCategories } from "../../lib/stone-varieties";

export async function getStaticPaths() {
  const halls = await getCollection("halls");
  return halls.map((hall) => ({ params: { slug: hall.id }, props: { hall } }));
}

const { hall } = Astro.props;
const { name, tagline, intro, hasRealContent, heroImage, heroAlt, materialColor, materialTexture, applications, enquiryNote } = hall.data;

const products = (await getCollection("products"))
  .filter((p) => p.data.hallId === hall.id)
  .sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection("services"))
  .filter((s) => s.data.hallId === hall.id)
  .sort((a, b) => a.data.order - b.data.order);

// Explore-by-colour: derived from the same real fields as the search index
// (see src/lib/facets.ts), scoped to this hall's own products only.
const COLOUR_SWATCH: Record<string, string> = {
  white: "#f4f1ea", black: "#1c1a17", grey: "#8a8580", beige: "#cdbfa0",
  brown: "#6b4a34", red: "#8c2f22", mustard: "#c48f2e", green: "#3f5c46",
};
const hallColours = Array.from(
  new Set(products.flatMap((p) => deriveColours(p.data.name, p.data.finish, p.data.imageAlt)))
).sort();

// Tiles is the one hall with real photography from several different real
// brands (Athangudi/BEJ, Adoration, Moroccan Collection, Leverpool...) --
// a single hero photo from just one of them reads as "this brand IS the
// hall" (the exact client complaint this replaces). A small grid of 4 real,
// distinct product photos says "several real lines," honestly, with no new
// photography needed.
const heroGrid = hall.id === "tiles"
  ? [
      { src: "/media/tiles/athangudi-series/lifestyle-petal-red.jpg", alt: "Athangudi Series tile in a traditional veranda" },
      { src: "/media/tiles/moroccan-collection/lifestyle-9613fl.jpg", alt: "Moroccan Collection wall tile in a bathroom" },
      { src: "/media/tiles/leverpool-115/swatch-115.jpg", alt: "Leverpool Glossy Collection tile swatch" },
      { src: "/media/tiles/grace-series/lifestyle-ns9613.jpg", alt: "Grace Series patterned floor tile in a living room" },
    ]
  : null;

// Sanitaryware isn't grouped into a material "world" (see lib/material-
// worlds.ts), so it gets its own honest "ask us to source" breakdown here
// instead of on a /materials/[world]/ page -- same pattern as Natural Stone
// and Surfaces, matched by keyword against real product names since these
// records use one generic "Sanitaryware"/"Sink" category field.
const sanitarywareBreakdown = hall.id === "sanitaryware"
  ? sanitarywareCategories.map((cat) => ({
      ...cat,
      matchedProducts: products.filter((p) => {
        const n = p.data.name.toLowerCase();
        if (cat.slug === "wash-basins") return n.includes("basin");
        if (cat.slug === "kitchen-sinks") return n.includes("sink");
        if (cat.slug === "wc-flush") return n.includes("wc") || n.includes("flush") || n.includes("closet");
        if (cat.slug === "faucets-fittings") return n.includes("faucet") || n.includes("mixer") || n.includes("shower") || n.includes("tap");
        return false;
      }),
    }))
  : [];

const hallUrl = new URL(`/halls/${hall.id}/`, Astro.site).toString();
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name,
  description: intro,
  url: hallUrl,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: products.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/products/${p.id}/`, Astro.site).toString(),
      name: p.data.name,
    })),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "All halls", item: new URL("/halls/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name },
  ],
};
---

<BaseLayout
  title={pageTitle(`${name} in Coimbatore`)}
  description={metaText(intro)}
  enquiryMessage={productEnquiryMessage(name)}
  enquiry={{ label: "Ask for trade rate", category: name }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <section class="relative isolate flex h-[52vh] min-h-[360px] items-end overflow-hidden">
    {heroGrid ? (
      <div class="absolute inset-0 grid grid-cols-2 grid-rows-2">
        {heroGrid.map((img) => (
          <div class="overflow-hidden"><img src={img.src} alt={img.alt} class="h-full w-full object-cover" /></div>
        ))}
      </div>
    ) : heroImage ? (
      <img src={heroImage} alt={heroAlt} class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    ) : (
      <div class="absolute inset-0 h-full w-full">
        <MaterialField color={materialColor} texture={materialTexture} label="" class="h-full w-full" />
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 pb-10 text-paper">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard">{tagline}</p>
      <h1 class="mt-2 font-display text-4xl sm:text-5xl">{name}</h1>
      {heroImage && !hasRealContent && (
        <p class="mt-3 text-xs italic text-paper/50">{imageBadge(heroImage) === "Illustrative image" ? "Illustrative image" : "Reference photo"}, not our stock. Ask us for photos of current stock</p>
      )}
    </div>
  </section>

  {hall.id === "granite-marbles" && (
    <section class="border-b border-line bg-charcoal-deep text-paper">
      <div class="mx-auto grid max-w-6xl gap-px bg-paper/10 sm:grid-cols-2">
        <a href="/granite/" class="group flex items-center gap-4 bg-charcoal-deep p-5 hover:bg-charcoal">
          <img src="/media/client/granite/black-galaxy-closeup-720.jpg" alt="" class="h-16 w-16 object-cover" loading="lazy" />
          <span><span class="block font-display text-2xl group-hover:text-brass">Explore granite</span><span class="text-xs uppercase tracking-[0.16em] text-paper/60">Real slabs, filter by colour & finish</span></span>
        </a>
        <a href="/marble/" class="group flex items-center gap-4 bg-charcoal-deep p-5 hover:bg-charcoal">
          <img src="/media/client/marble/white-slab-veined-720.jpg" alt="" class="h-16 w-16 object-cover" loading="lazy" />
          <span><span class="block font-display text-2xl group-hover:text-brass">Explore marble</span><span class="text-xs uppercase tracking-[0.16em] text-paper/60">Slabs & marble-look tiles</span></span>
        </a>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-12 md:grid-cols-[1.3fr_0.7fr]">
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">{intro}</p>
      <div class="rounded-sm border border-line bg-card p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-mustard-dark">Applications</p>
        <ul class="mt-3 space-y-1.5 text-sm text-ink-soft">
          {applications.map((app) => <li>{app}</li>)}
        </ul>
        <p class="mt-5 text-sm font-medium text-ink">{enquiryNote}</p>
        <div class="mt-4 flex flex-col gap-2">
          <a
            href={waLink(productEnquiryMessage(name))}
            target="_blank"
            rel="noopener"
            aria-label={`Ask for trade rate on ${name} via WhatsApp`}
            class="rounded-full bg-gradient-to-r from-brass to-mustard-dark px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-wide text-paper hover:brightness-110 transition-colors"
          >
            Enquire via WhatsApp
          </a>
          <a
            href={telLink()}
            aria-label={`Call our showroom about ${name}`}
            class="rounded-full border border-brass/60 px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-wide text-mustard-dark hover:bg-brass hover:text-paper transition-colors"
          >
            Call our team
          </a>
          <a
            href={emailQuoteLink(name)}
            aria-label={`Request an email quote for ${name}`}
            class="rounded-full border border-line px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-wide text-ink-soft hover:border-brass hover:text-mustard-dark transition-colors"
          >
            Request Email Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  {hallColours.length > 1 && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <p class="text-xs uppercase tracking-[0.25em] text-mustard-dark">Explore by colour</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {hallColours.map((colour) => (
            <a
              href={`/search/?material=${encodeURIComponent(name)}&colour=${encodeURIComponent(colour)}`}
              class="group flex items-center gap-2 rounded-full border border-line bg-paper py-1.5 pl-1.5 pr-4 hover:border-brass transition-colors"
            >
              <span class="h-6 w-6 rounded-full border border-line/60" style={{ backgroundColor: COLOUR_SWATCH[colour] ?? "#ccc" }} aria-hidden="true"></span>
              <span class="text-sm capitalize text-ink-soft group-hover:text-mustard-dark transition-colors">{colour}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">{hall.id === "tiles" ? "Series in stock" : "Catalogue"}</p>
    <h2 class="mt-2 text-3xl">{hall.id === "tiles" ? "Tile catalogue" : `${name} range`}</h2>
    <div data-gsap-stagger class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <article data-gsap-spotlight class="eb-card group relative overflow-hidden rounded-sm border border-line bg-card shadow-card">
          <div class="absolute right-2 top-2 z-10"><SaveButton product={p} hallName={name} variant="overlay" /></div>
          <a href={`/products/${p.id}/`} class="relative block" aria-label={`View details for ${p.data.name}`}>
            <div class="aspect-[4/3] overflow-hidden">
              <img src={p.data.image} alt={p.data.imageAlt} class="h-full w-full object-cover eb-img" loading="lazy" width="600" height="450" />
            </div>
            {imageBadge(p.data.image) && (
              <span class="absolute bottom-2 left-2 bg-charcoal-deep/75 px-2.5 py-1 text-[0.55rem] uppercase tracking-[0.18em] text-paper backdrop-blur">
                {imageBadge(p.data.image)}
              </span>
            )}
          </a>
          <div class="p-5">
            <p class="text-xs uppercase tracking-[0.15em] text-mustard-dark">{p.data.brand ?? p.data.category}</p>
            <h3 class="mt-1 text-lg">
              <a href={`/products/${p.id}/`} class="hover:text-mustard-dark transition-colors">{p.data.name}</a>
            </h3>
            <p class="mt-2 text-sm text-ink-soft">{[p.data.size, p.data.finish].filter(Boolean).join(" · ")}</p>
            {p.data.kind === "material" && <p class="mt-1 text-sm text-ink-soft">{p.data.applications.join(", ")}</p>}
            {p.data.note && <p class="mt-2 line-clamp-2 text-sm text-ink-soft">{p.data.note}</p>}
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
              <a href={`/products/${p.id}/`} class="inline-block text-sm font-semibold uppercase tracking-wide text-ink hover:text-mustard-dark">
                View details &rarr;
              </a>
              <a
                href={waLink(productEnquiryMessage(p.data.name))}
                target="_blank"
                rel="noopener"
                data-enquire="Ask price & availability"
                data-product={p.data.name}
                data-category={p.data.category ?? name}
                data-url={`/products/${p.id}/`}
                aria-label={`Ask for trade rate on ${p.data.name} via WhatsApp`}
                class="inline-block text-sm font-semibold uppercase tracking-wide text-mustard-dark hover:text-ink"
              >
                WhatsApp &rarr;
              </a>
              <a
                href={emailQuoteLink(p.data.name)}
                aria-label={`Request an email quote for ${p.data.name}`}
                class="inline-block text-sm font-semibold uppercase tracking-wide text-ink-soft hover:text-mustard-dark"
              >
                Email quote &rarr;
              </a>
            </div>
            {p.data.sourceCatalogue && <p class="mt-3 text-[0.7rem] uppercase tracking-wide text-ink-soft/60">{p.data.sourceCatalogue}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  {sanitarywareBreakdown.length > 0 && (
    <section class="border-t border-line/60 bg-paper py-16">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">By category</p>
        <h2 class="mt-2 text-3xl">Basins, sinks &amp; fittings</h2>
        <p class="mt-3 max-w-2xl text-ink-soft">
          Confirmed stock is linked directly below. We work with standard Indian sanitaryware brands for
          everything else here — tell us the fixture, brand preference and quantity and we'll quote it.
        </p>
        <div class="mt-10 flex flex-col gap-10">
          {sanitarywareBreakdown.map((cat) => (
            <div class="border-t border-line/60 pt-8">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="text-2xl">{cat.label}</h3>
                <span class="text-xs uppercase tracking-wide text-ink-soft/60">
                  {cat.matchedProducts.length > 0 ? `${cat.matchedProducts.length} confirmed in stock` : "Sourced on request"}
                </span>
              </div>
              <p class="mt-1 text-sm text-ink-soft">{cat.blurb}</p>

              {cat.matchedProducts.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-4">
                  {cat.matchedProducts.map((p) => (
                    <a href={`/products/${p.id}/`} class="flex items-center gap-3 rounded-sm border border-line bg-card p-3 hover:border-brass transition-colors">
                      <img src={p.data.image} alt={p.data.imageAlt} class="h-12 w-12 rounded object-cover" loading="lazy" />
                      <span class="text-sm">{p.data.name}</span>
                    </a>
                  ))}
                </div>
              )}

              <div class="mt-4 flex flex-wrap gap-2">
                {cat.varieties.map((v) => (
                  <span class="rounded-full border border-line/70 bg-card px-3.5 py-1.5 text-xs text-ink-soft" title={v.note}>
                    {v.name}{v.note ? ` · ${v.note}` : ""}
                  </span>
                ))}
                <a
                  href={waLink(`Hi Elite Balaji, I'm interested in ${cat.label}. Please let me know what's currently available.`)}
                  target="_blank"
                  rel="noopener"
                  class="rounded-full bg-brass/10 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-mustard-dark hover:bg-brass hover:text-paper transition-colors"
                >
                  Ask about {cat.label} &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {services.length > 0 && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Also from this hall</p>
        <h2 class="mt-2 text-3xl">Bespoke &amp; made to order</h2>
        <div data-gsap-stagger class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <div class="rounded-sm border border-line bg-paper p-6">
              <h3 class="text-lg">{service.data.name}</h3>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed">{service.data.description}</p>
              <a
                href={waLink(productEnquiryMessage(service.data.name))}
                target="_blank"
                rel="noopener"
                aria-label={`Ask about ${service.data.name} via WhatsApp`}
                class="mt-4 inline-block text-sm font-semibold uppercase tracking-wide text-mustard-dark hover:text-ink"
              >
                Ask about this &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-line/60 bg-charcoal py-14 text-paper">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <p class="text-lg">Looking for something not shown here in {name}?</p>
      <p class="mt-2 text-sm text-paper/70">
        Tell us the material, colour, size or finish you need. We can help source it beyond what's
        listed in this hall today.
      </p>
      <a
        href={waLink(`Hi Elite Balaji, I'm looking for something in ${name} that isn't shown on the website. Here's what I need:`)}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-block rounded-full bg-mustard px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink hover:bg-mustard-dark transition-colors"
      >
        Ask us to source it
      </a>
    </div>
  </section>
</BaseLayout>
