---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, emailQuoteLink, productEnquiryMessage } from "../../lib/business";
import { similarGroups } from "../../lib/similarity";
import SaveButton from "../../components/SaveButton.astro";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { name, image, imageAlt, hallId } = product.data;

// Most products still have exactly one verified photo -- fall back to it as
// a single-item gallery so the thumbnail strip only appears when there's
// genuinely more than one real image to show.
const gallery = product.data.images && product.data.images.length > 0
  ? product.data.images
  : [{ src: image, alt: imageAlt }];

const specRows = [
  { label: "Thickness", value: product.data.thickness },
  { label: "Qty / box", value: product.data.qtyPerBox },
  { label: "Coverage", value: product.data.coverageArea },
  { label: "Weight / box", value: product.data.weight },
].filter((row): row is { label: string; value: string } => Boolean(row.value));

const halls = await getCollection("halls");
const hall = halls.find((h) => h.id === hallId);
const hallName = hall?.data.name ?? hallId;

// Find similar: related materials grouped by why they're related (material,
// look, colour, size/use), across the whole catalogue, from real fields only.
const allProducts = await getCollection("products");
const similar = similarGroups(product, allProducts);
const hallNameOf = (id: string) => halls.find((h) => h.id === id)?.data.name ?? id;

const what = product.data.category ? `${name} (${product.data.category})` : name;
const intents = [
  { label: "Do you have this in stock?", message: `Hi Elite Balaji, do you have ${what} in stock right now?` },
  { label: "Can I see a sample or photos?", message: `Hi Elite Balaji, can I see a sample or current photos of ${what}?` },
  { label: "Suggest an alternative", message: `Hi Elite Balaji, I'm interested in ${what}. Can you suggest alternatives in a similar look or budget?` },
  { label: "I need this for my project", message: `Hi Elite Balaji, I need ${what} for my project. Location: ___, area/quantity: ___, timeline: ___.` },
];

// No "offers" block: this site never publishes prices (trade rates are
// quoted by WhatsApp/call), and Offer structured data without a real price
// is exactly the kind of incomplete markup Google flags -- omitting it
// entirely is more honest than shipping a placeholder.
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  url: new URL(`/products/${product.id}/`, Astro.site).toString(),
  image: image.startsWith("http") ? image : new URL(image, Astro.site).toString(),
  description: product.data.note ?? `${name}: ${product.data.finish}.`,
  category: hallName,
  ...(product.data.brand ? { brand: { "@type": "Brand", name: product.data.brand } } : {}),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "All halls", item: new URL("/halls/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: hallName, item: new URL(`/halls/${hallId}/`, Astro.site).toString() },
    { "@type": "ListItem", position: 3, name },
  ],
};
---

<BaseLayout
  title={`${name} | ${hallName} | Elite Balaji Stones & Ceramics`}
  description={`${name}: ${[product.data.category, product.data.finish].filter(Boolean).join(", ")}. Ask for trade rate.`}
  enquiryMessage={productEnquiryMessage(name, product.data.category)}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-5 pt-6 text-xs uppercase tracking-wide text-ink-soft">
    <a href="/halls/" class="hover:text-terracotta">All halls</a>
    <span class="mx-2">/</span>
    <a href={`/halls/${hallId}/`} class="hover:text-terracotta">{hallName}</a>
    <span class="mx-2">/</span>
    <span class="text-ink">{name}</span>
  </nav>

  <!-- Let the material occupy the screen: one large image, not a boxed
       half-width thumbnail next to a wall of UI. object-contain on a mat
       background (not object-cover) because the real catalogue assets are a
       mix of full-bleed lifestyle photos and small swatch cards with their
       own white borders -- cropping the swatch cards to fill the frame would
       cut off real card content, not just empty space. -->
  <section class="mx-auto max-w-6xl px-5 pt-6">
    <div class="flex h-[50vh] min-h-[340px] items-center justify-center overflow-hidden rounded-sm bg-card">
      <img
        id="product-main-image"
        src={gallery[0].src}
        alt={gallery[0].alt}
        class="h-full w-full object-contain"
        width="1600"
        height="1000"
        fetchpriority="high"
      />
    </div>

    {gallery.length > 1 && (
      <div class="mt-3 flex justify-center gap-3">
        {gallery.map((img, i) => (
          <button
            type="button"
            class="product-thumb h-16 w-16 overflow-hidden rounded-sm border-2 transition-colors"
            class:list={[i === 0 ? "border-terracotta" : "border-line"]}
            data-src={img.src}
            data-alt={img.alt}
            aria-label={`Show image ${i + 1} of ${name}`}
          >
            <img src={img.src} alt="" class="h-full w-full object-cover" loading="lazy" />
          </button>
        ))}
      </div>
    )}
  </section>

  {gallery.length > 1 && (
    <script>
      // Plain DOM swap, no framework -- one product page never needs a React
      // island just to change an <img> src on click.
      const main = document.getElementById("product-main-image") as HTMLImageElement | null;
      document.querySelectorAll<HTMLButtonElement>(".product-thumb").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!main) return;
          main.src = btn.dataset.src ?? main.src;
          main.alt = btn.dataset.alt ?? main.alt;
          document.querySelectorAll(".product-thumb").forEach((b) => b.classList.remove("border-terracotta"));
          document.querySelectorAll(".product-thumb").forEach((b) => b.classList.add("border-line"));
          btn.classList.remove("border-line");
          btn.classList.add("border-terracotta");
        });
      });
    </script>
  )}

  <section class="mx-auto max-w-3xl px-5 py-10 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-terracotta">{hallName}</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">{name}</h1>

    <div class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-ink-soft">
      {product.data.brand && <span><span class="text-ink-soft/60">Brand</span> · {product.data.brand}</span>}
      {product.data.category && <span><span class="text-ink-soft/60">Category</span> · {product.data.category}</span>}
      {product.data.size && <span><span class="text-ink-soft/60">Size</span> · {product.data.size}</span>}
      <span><span class="text-ink-soft/60">Finish</span> · {product.data.finish}</span>
    </div>
    <p class="mt-3 text-sm text-ink-soft">{product.data.applications.join(" · ")}</p>

    {specRows.length > 0 && (
      <div class="mx-auto mt-6 grid max-w-lg grid-cols-2 gap-x-6 gap-y-2 border-t border-line/60 pt-5 text-left text-sm sm:grid-cols-4">
        {specRows.map((row) => (
          <div>
            <p class="text-xs uppercase tracking-wide text-ink-soft/50">{row.label}</p>
            <p class="text-ink">{row.value}</p>
          </div>
        ))}
      </div>
    )}

    {product.data.sourceCatalogue && <p class="mt-4 text-xs uppercase tracking-wide text-ink-soft/50">{product.data.sourceCatalogue}</p>}

    {product.data.note && <p class="mx-auto mt-5 max-w-md text-sm italic text-ink-soft">{product.data.note}</p>}

    <p class="mt-8 text-xs uppercase tracking-[0.22em] text-mustard-dark">Enquire for current price &amp; availability</p>
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a
        href={waLink(productEnquiryMessage(name, product.data.category))}
        target="_blank"
        rel="noopener"
        aria-label={`Ask price and availability for ${name} on WhatsApp`}
        data-gsap-magnetic
        class="inline-flex min-h-12 items-center bg-gradient-to-r from-brass to-mustard-dark px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-paper hover:brightness-110 transition"
      >
        Ask price &amp; availability
      </a>
      <SaveButton product={product} hallName={hallName} variant="button" />
      <a href="#similar" class="inline-flex min-h-12 items-center border border-line px-6 py-3 text-xs uppercase tracking-[0.18em] text-ink-soft hover:border-brass hover:text-ink transition-colors">Find similar</a>
    </div>

    <!-- Contextual enquiries: each opens WhatsApp with a message that already
         names this product and what the customer wants. -->
    <div class="mx-auto mt-8 max-w-2xl border-t border-line pt-6">
      <p class="text-[0.65rem] uppercase tracking-[0.22em] text-ink-soft">Or tell us exactly what you need</p>
      <ul class="mt-4 grid gap-2 text-left sm:grid-cols-2">
        {intents.map((intent) => (
          <li>
            <a href={waLink(intent.message)} target="_blank" rel="noopener" class="group flex min-h-12 items-center justify-between gap-3 border border-line bg-card px-4 py-3 text-sm transition-colors hover:border-brass">
              <span>{intent.label}</span>
              <span aria-hidden="true" class="text-brass transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-2 flex flex-wrap justify-center gap-x-6 text-xs uppercase tracking-[0.16em] text-ink-soft">
        <a href={telLink()} class="inline-flex min-h-11 items-center hover:text-ink">Call our team</a>
        <a href={emailQuoteLink(name)} class="inline-flex min-h-11 items-center hover:text-ink">Email a quote request</a>
        <a href="/shortlist/" class="inline-flex min-h-11 items-center hover:text-ink">Compare in My Materials</a>
      </div>
    </div>
  </section>

  {similar.length > 0 && (
    <section id="similar" class="scroll-mt-24 border-t border-line/60 bg-card">
      <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Find similar</p>
            <h2 class="mt-2 font-display text-4xl">If you like {name}</h2>
          </div>
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Ways this is similar">
            {similar.map((g, i) => (
              <button type="button" role="tab" id={`tab-${g.key}`} aria-controls={`panel-${g.key}`} aria-selected={i === 0 ? "true" : "false"} data-similar-tab={g.key} class="min-h-11 border border-line px-4 py-2 text-xs uppercase tracking-[0.14em] text-ink-soft transition-colors hover:border-brass aria-selected:border-brass aria-selected:bg-brass aria-selected:text-paper">
                {g.title}
              </button>
            ))}
          </div>
        </div>
        {similar.map((g, i) => (
          <div role="tabpanel" id={`panel-${g.key}`} aria-labelledby={`tab-${g.key}`} data-similar-panel={g.key} hidden={i !== 0} class="mt-8">
            <p class="text-xs uppercase tracking-[0.18em] text-ink-soft">{g.reason}</p>
            <ul class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
              {g.items.map((r) => (
                <li class="group relative">
                  <a href={`/products/${r.id}/`} class="block overflow-hidden bg-charcoal-deep">
                    <img src={r.data.image} alt={r.data.imageAlt} class="aspect-[4/3] w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                  </a>
                  <div class="absolute right-2 top-2"><SaveButton product={r} hallName={hallNameOf(r.data.hallId)} variant="overlay" /></div>
                  <a href={`/products/${r.id}/`} class="mt-3 block font-display text-xl leading-tight hover:text-mustard-dark">{r.data.name}</a>
                  <p class="text-xs text-ink-soft">{[hallNameOf(r.data.hallId), r.data.finish].join(" · ")}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <a href={waLink(`Hi Elite Balaji, I like ${name}. Can you suggest similar options or alternatives that are available now?`)} target="_blank" rel="noopener" class="mt-10 inline-flex min-h-12 items-center border-b border-brass text-xs uppercase tracking-[0.2em] hover:text-mustard-dark">Ask us for more like this &rarr;</a>
      </div>
    </section>
  )}

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-similar-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        const key = tab.dataset.similarTab;
        document.querySelectorAll<HTMLButtonElement>("[data-similar-tab]").forEach((t) => t.setAttribute("aria-selected", String(t === tab)));
        document.querySelectorAll<HTMLElement>("[data-similar-panel]").forEach((p) => (p.hidden = p.dataset.similarPanel !== key));
      });
    });
  </script>
</BaseLayout>
