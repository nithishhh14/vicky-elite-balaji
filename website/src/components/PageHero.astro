---
// Inner-page header band in the homepage hero's language (reference mockup):
// dark marble zone carrying the type, the showroom render bleeding in from
// the right. Keeps every top-level page visually part of the same showroom.
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  // A real photo for this page (a product or client image). Falls back to the
  // client-approved showroom render, which is labelled as such.
  image?: string;
  imageAlt?: string;
  credit?: string;
}
const { eyebrow, title, intro, image, imageAlt = "", credit } = Astro.props;
const src = image ?? "/media/reference/hero-interior.jpg";
const label = credit ?? (image ? undefined : "Illustrative showroom concept");
---

<section class="relative isolate overflow-hidden bg-charcoal-deep text-paper">
  <img
    src={src}
    alt={imageAlt}
    aria-hidden={imageAlt ? undefined : "true"}
    class="absolute inset-y-0 right-0 h-full w-full object-cover object-center opacity-60 lg:w-[55%]"
    loading="eager"
  />
  <div class="marble-veins pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,_var(--color-charcoal-deep)_0%,_var(--color-bottle-dark)_55%,_transparent_100%)]" aria-hidden="true"></div>
  <div data-gsap-hero class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <p class="text-xs uppercase tracking-[0.45em] text-brass">{eyebrow}</p>
    <h1 class="mt-5 max-w-3xl font-display text-5xl font-medium uppercase leading-[0.95] sm:text-6xl">{title}</h1>
    {intro && <p class="mt-6 max-w-xl text-paper/80 leading-relaxed">{intro}</p>}
  </div>
  {label && <p class="absolute bottom-3 right-4 text-[0.55rem] uppercase tracking-[0.18em] text-paper/40">{label}</p>}
</section>
