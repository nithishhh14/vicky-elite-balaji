---
import BaseLayout from "../layouts/BaseLayout.astro";
import SaveButton from "../components/SaveButton.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, productEnquiryMessage } from "../lib/business";
import { mediaLibrary, provenanceLabel } from "../lib/media-library";
import { stoneCategories } from "../lib/stone-varieties";
import { imageBadge } from "../lib/image-badge";

// Marble, and the marble look. Real white slabs from our yard, real
// marble-look tiles from the Mozzato Endless catalogue, marble stonecraft,
// and the varieties we can source. Stock-photo records are not featured.
const products = await getCollection("products");
const isStock = (src: string) => imageBadge(src) !== null;
const slabs = products.filter((p) => p.data.category === "Natural marble slab" && !isStock(p.data.image)).sort((a, b) => a.data.order - b.data.order);
// Statement marbles (Black Gold, Emerald Gold…): illustrative images until
// the client sends slab photos, so they get their own labelled section.
const statement = products
  .filter((p) => p.data.category === "Natural marble slab" && imageBadge(p.data.image) === "Illustrative image")
  .sort((a, b) => b.data.order - a.data.order);
const looks = products.filter((p) => /marble-look/i.test(p.data.category ?? "") || (/marble/i.test(p.data.name) && p.data.kind === "tile")).sort((a, b) => a.data.order - b.data.order);
const craft = mediaLibrary.find((m) => m.slug === "tulsi-madam-white-marble");
const rooms = [
  { src: "/media/concepts/living-960.jpg", alt: "Concept: living room with large-format white marble-look floor", label: "Application concept" },
  { src: "/media/tiles/mozzato-endless/azzuro-room.jpg", alt: "Azzuro Crema and Azzuro Nero in a bathroom", label: "Supplier catalogue · Mozzato" },
  { src: "/media/tiles/mozzato-endless/marvel-room.jpg", alt: "Marvel Bianco and Marvel Grey in a retail interior", label: "Supplier catalogue · Mozzato" },
  { src: "/media/tiles/mozzato-endless/calipso-room.jpg", alt: "Calipso Sage and Calipso Light in a café", label: "Supplier catalogue · Mozzato" },
];
const source = stoneCategories.find((c) => c.slug === "marble");
const hero = slabs[0];

const compare = [
  { label: "Look", marble: "Soft, luminous veining; every slab unique", tile: "Marble veining printed on vitrified tile; consistent from box to box", granite: "Speckled or crystalline; bolder pattern" },
  { label: "Care", marble: "Seal and wipe spills quickly; can etch with acids", tile: "Very low maintenance; stain resistant", granite: "Hard-wearing and heat tolerant; low upkeep" },
  { label: "Best for", marble: "Feature floors, walls, pooja rooms, statement counters", tile: "Large floors, bathrooms, commercial spaces", granite: "Kitchen countertops, stairs, heavy-use floors" },
  { label: "Budget", marble: "Ask us: varies widely by variety", tile: "Usually the most economical marble look", granite: "Ask us: varies by variety and finish" },
];
---

<BaseLayout
  title="Marble & Marble-look Tiles, Coimbatore | Elite Balaji"
  description="White marble slabs from our Karamadai yard, gold-veined statement marbles, Mozzato marble-look tiles, and varieties we can source for Coimbatore projects."
  enquiryMessage="Hi Elite Balaji, I'm looking for marble or a marble-look tile. Can you share what's available?"
  enquiry={{ label: "Ask about marble", shortLabel: "Marble", category: "Marble", intent: "Request a sample or photos" }}
>
  <section class="relative isolate flex min-h-[70svh] items-end overflow-hidden bg-charcoal-deep text-paper">
    {hero && <img src={hero.data.image} alt={hero.data.imageAlt} class="absolute inset-0 h-full w-full object-cover opacity-80" fetchpriority="high" />}
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep via-charcoal-deep/50 to-charcoal-deep/10" aria-hidden="true"></div>
    <div data-gsap-hero class="relative mx-auto w-full max-w-7xl px-5 pb-14 pt-40 lg:px-8">
      <p class="text-xs uppercase tracking-[0.45em] text-brass">02 · Material world</p>
      <h1 class="mt-5 font-display text-[clamp(3.25rem,11vw,8rem)] font-medium leading-[0.9]">Marble</h1>
      <p class="mt-5 max-w-xl text-lg text-paper/85 leading-relaxed">Natural marble slabs from our yard, and marble-look tiles when you want the veining without the upkeep.</p>
      <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-2 text-xs uppercase tracking-[0.18em]">
        <a href="#slabs" class="inline-flex min-h-11 items-center border border-paper/30 px-4 hover:border-brass">Marble slabs · {slabs.length}</a>
        <a href="#statement" class="inline-flex min-h-11 items-center border border-paper/30 px-4 hover:border-brass">Gold-veined marbles · {statement.length}</a>
        <a href="#marble-look" class="inline-flex min-h-11 items-center border border-paper/30 px-4 hover:border-brass">Marble-look tiles · {looks.length}</a>
        <a href="#compare" class="inline-flex min-h-11 items-center border border-paper/30 px-4 hover:border-brass">Which one suits you?</a>
        <a href="#source" class="inline-flex min-h-11 items-center border border-paper/30 px-4 hover:border-brass">Varieties we source</a>
      </nav>
      {hero && <p class="mt-8 text-[0.6rem] uppercase tracking-[0.2em] text-paper/45">{provenanceLabel.stock} · {hero.data.name}</p>}
    </div>
  </section>

  <section id="slabs" class="scroll-mt-24 bg-paper py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">From our slab yard</p>
      <h2 class="mt-3 font-display text-4xl sm:text-5xl">Marble slabs</h2>
      <p class="mt-3 max-w-2xl text-ink-soft">Photographed in our yard. White veined slabs can be natural marble or engineered quartz, so we confirm the exact material with you.</p>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {slabs.map((p) => (
          <article class="group relative">
            <div class="absolute right-3 top-3 z-10"><SaveButton product={p} hallName="Granite & Marbles" variant="overlay" /></div>
            <a href={`/products/${p.id}/`} class="block overflow-hidden bg-charcoal-deep">
              <img src={p.data.image} alt={p.data.imageAlt} class="aspect-[4/3] w-full object-cover eb-img" loading="lazy" />
            </a>
            <h3 class="mt-4 font-display text-2xl"><a href={`/products/${p.id}/`} class="hover:text-mustard-dark">{p.data.name}</a></h3>
            <p class="text-xs uppercase tracking-[0.16em] text-ink-soft">{p.data.finish}</p>
            <a href={waLink(productEnquiryMessage(p.data.name, p.data.category))} target="_blank" rel="noopener" data-enquire="Ask price & availability" data-product={p.data.name} data-category={p.data.category} data-url={`/products/${p.id}/`} class="inline-flex min-h-11 items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-mustard-dark hover:text-ink">Check availability <span class="arrow" aria-hidden="true">&rarr;</span></a>
          </article>
        ))}
        {craft && (
          <article class="group relative">
            <a href="/custom/#devotional" class="block overflow-hidden bg-charcoal-deep">
              <img src={craft.src} alt={craft.alt} class="aspect-[4/3] w-full object-cover eb-img" loading="lazy" />
            </a>
            <h3 class="mt-4 font-display text-2xl"><a href="/custom/#devotional" class="hover:text-mustard-dark">Carved in marble</a></h3>
            <p class="text-xs uppercase tracking-[0.16em] text-ink-soft">{provenanceLabel.work} · {craft.title}</p>
            <a href="/custom/" class="inline-flex min-h-11 items-center text-xs font-medium uppercase tracking-[0.16em] text-mustard-dark hover:text-ink">See our stonecraft &rarr;</a>
          </article>
        )}
      </div>
    </div>
  </section>

  {statement.length > 0 && (
    <section id="statement" class="scroll-mt-24 marble-veins bg-charcoal-deep py-20 text-paper">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-brass">Statement marbles</p></div>
            <h2 class="mt-3 font-display text-4xl sm:text-5xl"><span class="gold-engraved">Gold-veined</span> &amp; dramatic</h2>
            <p class="mt-3 max-w-xl text-paper/70">Black Gold, Emerald Gold and other bold marbles for feature walls, receptions and pooja rooms. Ask us for today's slabs and rates.</p>
          </div>
          <a href={waLink("Hi Elite Balaji, please share photos and rates for Black Gold, Emerald Gold and other statement marbles.")} target="_blank" rel="noopener" data-enquire="Request a sample or photos" data-product="Statement marbles" data-category="Marble" class="btn-arrow inline-flex min-h-12 items-center gap-3 border border-brass px-6 py-3 text-xs uppercase tracking-[0.2em] hover:bg-brass hover:text-charcoal-deep">
            Ask for slab photos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div data-gsap-stagger class="mt-10 grid gap-5 md:grid-cols-3">
          {statement.map((p) => (
            <article class="group relative">
              <div class="absolute right-3 top-3 z-10"><SaveButton product={p} hallName="Granite & Marbles" variant="overlay" /></div>
              <a href={`/products/${p.id}/`} class="relative block overflow-hidden bg-charcoal">
                <img src={p.data.image} alt={p.data.imageAlt} class="eb-img aspect-[4/5] w-full object-cover" loading="lazy" />
                <span class="absolute bottom-3 left-3 bg-charcoal-deep/75 px-2.5 py-1 text-[0.55rem] uppercase tracking-[0.18em] text-paper backdrop-blur">{imageBadge(p.data.image)}</span>
              </a>
              <span class="eb-rule mt-4" aria-hidden="true"></span>
              <h3 class="mt-2 font-display text-3xl"><a href={`/products/${p.id}/`} class="hover:text-brass">{p.data.name.replace(" Marble", "")}</a></h3>
              <p class="text-xs uppercase tracking-[0.16em] text-paper/60">{p.data.finish} · {p.data.applications.slice(0, 2).join(" · ")}</p>
              <a href={waLink(productEnquiryMessage(p.data.name, p.data.category))} target="_blank" rel="noopener" data-enquire="Ask price & availability" data-product={p.data.name} data-category={p.data.category} data-url={`/products/${p.id}/`} class="inline-flex min-h-11 items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-brass hover:text-paper">Ask availability <span class="arrow" aria-hidden="true">&rarr;</span></a>
            </article>
          ))}
        </div>
        <p class="mt-6 text-xs text-paper/45">Illustrative images show the look of each variety, not a specific slab in our yard. Natural marble varies from block to block.</p>
      </div>
    </section>
  )}

  <section id="marble-look" class="scroll-mt-24 bg-charcoal-deep py-20 text-paper">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-brass">Mozzato Endless Collection · 600 × 1200 mm</p>
          <h2 class="mt-3 font-display text-4xl sm:text-5xl">Marble-look tiles</h2>
          <p class="mt-3 max-w-2xl text-paper/70">Large-format vitrified tiles with marble veining in a matt carving finish, four random faces per design so the floor doesn't repeat.</p>
        </div>
        <a href="/search/?q=marble%20look" class="inline-flex min-h-11 items-center text-xs uppercase tracking-[0.18em] text-brass hover:text-paper">All marble-look options &rarr;</a>
      </div>
      <ul data-gsap-stagger class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {looks.map((p) => (
          <li class="group relative">
            <div class="absolute right-2 top-2 z-10"><SaveButton product={p} hallName="Tiles" variant="overlay" /></div>
            <a href={`/products/${p.id}/`} class="block overflow-hidden bg-charcoal">
              <img src={p.data.image} alt={p.data.imageAlt} class="aspect-[2/1] w-full object-cover eb-img" loading="lazy" />
            </a>
            <a href={`/products/${p.id}/`} class="mt-3 block font-display text-xl leading-tight hover:text-brass">{p.data.name.replace(" Marble-look Tile", "")}</a>
            <p class="text-[0.6rem] uppercase tracking-[0.16em] text-paper/50">{[p.data.brand, p.data.size, p.data.finish].filter(Boolean).join(" · ")}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-paper py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">In a space</p>
      <h2 class="mt-3 font-display text-4xl">How the marble look lives in a room</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {rooms.map((r, i) => (
          <figure class:list={["relative overflow-hidden bg-charcoal-deep", i === 0 && "md:col-span-2"]}>
            <img data-gsap-reveal src={r.src} alt={r.alt} class:list={["w-full object-cover", i === 0 ? "aspect-[21/9]" : "aspect-[4/3]"]} loading="lazy" />
            <figcaption class="absolute bottom-3 left-3 bg-charcoal-deep/70 px-3 py-1.5 text-[0.55rem] uppercase tracking-[0.2em] text-paper/80 backdrop-blur">{r.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="compare" class="scroll-mt-24 bg-card py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Which one suits you?</p>
      <h2 class="mt-3 font-display text-4xl">Marble, marble-look tile or granite</h2>
      <div class="mt-8 overflow-x-auto border border-line bg-paper" tabindex="0" role="region" aria-label="Marble, marble-look tile and granite compared">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <thead>
            <tr class="text-left">
              <th class="w-32 border-b border-line p-4"></th>
              <th scope="col" class="border-b border-l border-line p-4 font-display text-2xl font-medium">Natural marble</th>
              <th scope="col" class="border-b border-l border-line p-4 font-display text-2xl font-medium">Marble-look tile</th>
              <th scope="col" class="border-b border-l border-line p-4 font-display text-2xl font-medium">Granite</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr>
                <th scope="row" class="border-b border-line p-4 text-left text-[0.65rem] font-medium uppercase tracking-[0.16em] text-ink-soft">{row.label}</th>
                <td class="border-b border-l border-line p-4 align-top">{row.marble}</td>
                <td class="border-b border-l border-line p-4 align-top">{row.tile}</td>
                <td class="border-b border-l border-line p-4 align-top">{row.granite}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/granite/" class="inline-flex min-h-12 items-center border border-ink px-6 text-xs uppercase tracking-[0.18em] hover:bg-ink hover:text-paper">Explore granite</a>
        <a href="/materials/tiles-ceramics/" class="inline-flex min-h-12 items-center border border-line px-6 text-xs uppercase tracking-[0.18em] hover:border-brass">Tile types explained</a>
      </div>
    </div>
  </section>

  {source && (
    <section id="source" class="scroll-mt-24 bg-paper py-16">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <h2 class="font-display text-3xl">Marble varieties we can source</h2>
        <p class="mt-2 max-w-2xl text-ink-soft">Not in the photos above? Tap a variety to ask us about current availability.</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {source.varieties.map((v) => (
            <li><a href={waLink(`Hi Elite Balaji, can you source ${v.name} marble? Please share availability and photos.`)} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center rounded-full border border-line px-4 text-sm text-ink-soft hover:border-brass hover:text-ink">{v.name} &rarr;</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="marble-veins bg-charcoal py-20 text-center text-paper">
    <h2 class="font-display text-4xl sm:text-5xl">Seen a marble you love elsewhere?</h2>
    <p class="mx-auto mt-4 max-w-xl text-paper/75">Send us the photo or name. We'll find the closest real slab or tile and share a rate.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={waLink("Hi Elite Balaji, I'm looking for this marble (photo/name attached):")} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center bg-gradient-to-r from-brass to-mustard-dark px-8 text-xs uppercase tracking-[0.2em] hover:brightness-110">Send the photo</a>
      <a href={telLink()} class="inline-flex min-h-12 items-center border border-paper/40 px-8 text-xs uppercase tracking-[0.2em] hover:border-brass">Call us</a>
    </div>
  </section>
</BaseLayout>
