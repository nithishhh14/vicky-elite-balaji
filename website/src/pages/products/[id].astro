---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, emailQuoteLink, productEnquiryMessage } from "../../lib/business";
import { deriveColours, deriveCharacterTags, deriveApplicationTags } from "../../lib/facets";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { name, image, imageAlt, hallId } = product.data;

const halls = await getCollection("halls");
const hall = halls.find((h) => h.id === hallId);
const hallName = hall?.data.name ?? hallId;

// Related: other real products in the same hall, ranked by shared derived
// facets (colour/character/application) so "related" means genuinely
// similar, not just "next in the list" -- still entirely computed from
// real fields, nothing invented.
function facetSetFor(p: typeof product): Set<string> {
  return new Set([
    ...deriveColours(p.data.name, p.data.finish, p.data.imageAlt),
    ...deriveCharacterTags(p.data.name, p.data.finish, p.data.imageAlt),
    ...deriveApplicationTags(p.data.applications),
  ]);
}

const productFacets = facetSetFor(product);
function overlapScore(p: typeof product): number {
  const other = facetSetFor(p);
  let score = 0;
  other.forEach((tag) => { if (productFacets.has(tag)) score += 1; });
  return score;
}

const allProducts = await getCollection("products");
const candidates = allProducts.filter((p) => p.data.hallId === hallId && p.id !== product.id);
const related = candidates
  .map((p) => ({ p, score: overlapScore(p) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ p }) => p);

// No "offers" block: this site never publishes prices (trade rates are
// quoted by WhatsApp/call), and Offer structured data without a real price
// is exactly the kind of incomplete markup Google flags -- omitting it
// entirely is more honest than shipping a placeholder.
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  url: new URL(`/products/${product.id}/`, Astro.site).toString(),
  image: image.startsWith("http") ? image : new URL(image, Astro.site).toString(),
  description: product.data.note ?? `${name}: ${product.data.finish}.`,
  category: hallName,
  ...(product.data.brand ? { brand: { "@type": "Brand", name: product.data.brand } } : {}),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "All halls", item: new URL("/halls/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: hallName, item: new URL(`/halls/${hallId}/`, Astro.site).toString() },
    { "@type": "ListItem", position: 3, name },
  ],
};
---

<BaseLayout
  title={`${name} | ${hallName} | Elite Balaji Stones & Ceramics`}
  description={`${name}: ${[product.data.category, product.data.finish].filter(Boolean).join(", ")}. Ask for trade rate.`}
  enquiryMessage={productEnquiryMessage(name)}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-5 pt-6 text-xs uppercase tracking-wide text-ink-soft">
    <a href="/halls/" class="hover:text-terracotta">All halls</a>
    <span class="mx-2">/</span>
    <a href={`/halls/${hallId}/`} class="hover:text-terracotta">{hallName}</a>
    <span class="mx-2">/</span>
    <span class="text-ink">{name}</span>
  </nav>

  <!-- Let the material occupy the screen: one large image, not a boxed
       half-width thumbnail next to a wall of UI. object-contain on a mat
       background (not object-cover) because the real catalogue assets are a
       mix of full-bleed lifestyle photos and small swatch cards with their
       own white borders -- cropping the swatch cards to fill the frame would
       cut off real card content, not just empty space. -->
  <section class="mx-auto max-w-6xl px-5 pt-6">
    <div class="flex h-[50vh] min-h-[340px] items-center justify-center overflow-hidden rounded-sm bg-card">
      <img src={image} alt={imageAlt} class="h-full w-full object-contain" width="1600" height="1000" fetchpriority="high" />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-10 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-terracotta">{hallName}</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">{name}</h1>

    <div class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-ink-soft">
      {product.data.brand && <span><span class="text-ink-soft/60">Brand</span> · {product.data.brand}</span>}
      {product.data.category && <span><span class="text-ink-soft/60">Category</span> · {product.data.category}</span>}
      {product.data.size && <span><span class="text-ink-soft/60">Size</span> · {product.data.size}</span>}
      <span><span class="text-ink-soft/60">Finish</span> · {product.data.finish}</span>
    </div>
    <p class="mt-3 text-sm text-ink-soft">{product.data.applications.join(" · ")}</p>
    {product.data.sourceCatalogue && <p class="mt-1 text-xs uppercase tracking-wide text-ink-soft/50">{product.data.sourceCatalogue}</p>}

    {product.data.note && <p class="mx-auto mt-5 max-w-md text-sm italic text-ink-soft">{product.data.note}</p>}

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={waLink(productEnquiryMessage(name))}
        target="_blank"
        rel="noopener"
        aria-label={`Ask for trade rate on ${name} via WhatsApp`}
        class="rounded-full bg-terracotta px-6 py-3 text-sm font-semibold uppercase tracking-wide text-paper hover:bg-terracotta-dark transition-colors"
      >
        Enquire via WhatsApp
      </a>
      <a
        href={telLink()}
        aria-label="Call our showroom"
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
      >
        Call Showroom
      </a>
      <a
        href={emailQuoteLink(name)}
        aria-label={`Request an email quote for ${name}`}
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
      >
        Request Email Quote
      </a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <p class="text-xs uppercase tracking-[0.25em] text-terracotta">Related in {hallName}</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {related.map((r) => (
            <a href={`/products/${r.id}/`} class="group block overflow-hidden rounded-sm border border-line bg-paper">
              <div class="aspect-[4/3] overflow-hidden">
                <img src={r.data.image} alt={r.data.imageAlt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              </div>
              <div class="p-4">
                <h3 class="text-sm group-hover:text-terracotta transition-colors">{r.data.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
