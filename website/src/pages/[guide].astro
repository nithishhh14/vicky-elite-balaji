---
// Local search landing pages, one per entry in src/lib/guides.ts. Static
// routes (/about/, /granite/...) win over this dynamic route, and every slug
// ends in -coimbatore, so there is no collision with the rest of the site.
//
// Unlike the competitor pages that rank for these phrases, every page here
// shows the real products we actually hold, and says plainly when we have to
// source something instead.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SaveButton from "../components/SaveButton.astro";
import { getCollection } from "astro:content";
import { guides } from "../lib/guides";
import { business, waLink, telLink } from "../lib/business";
import { imageBadge } from "../lib/image-badge";
import { metaText } from "../lib/seo";

export async function getStaticPaths() {
  return guides.map((guide) => ({ params: { guide: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;

const halls = await getCollection("halls");
const hallName = (id: string) => halls.find((h) => h.id === id)?.data.name ?? id;
const all = (await getCollection("products")).sort((a, b) => a.data.order - b.data.order);

const haystack = (p: (typeof all)[number]) =>
  [p.data.name, p.data.category, p.data.finish, p.data.size, p.data.series, p.data.imageAlt, ...p.data.applications]
    .filter(Boolean)
    .join(" ");

const matches = all.filter((p) => {
  if (guide.match.halls && !guide.match.halls.includes(p.data.hallId)) return false;
  if (guide.match.kind && p.data.kind !== guide.match.kind) return false;
  return guide.match.rx.test(haystack(p));
});
const shown = matches.slice(0, 12);
const byHall = [...new Set(matches.map((p) => p.data.hallId))].map((id) => ({ id, name: hallName(id), count: matches.filter((p) => p.data.hallId === id).length }));
const related = guide.related.map((slug) => guides.find((g) => g.slug === slug)).filter(Boolean);

// Hero image: the first real (non-illustrative) product photo on this page,
// so each landing page opens with material we actually hold.
const heroProduct = matches.find((p) => !imageBadge(p.data.image)) ?? matches[0];
const heroCredit = heroProduct
  ? imageBadge(heroProduct.data.image) ?? (heroProduct.data.sourceCatalogue ? "Supplier catalogue" : "From our stock")
  : undefined;

const url = new URL(`/${guide.slug}/`, Astro.site).toString();
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: guide.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: guide.h1, item: url },
  ],
};
---

<BaseLayout
  title={guide.title}
  description={metaText(guide.description)}
  enquiryMessage={guide.enquiry}
  enquiry={{ label: "Ask about this", category: guide.eyebrow.split("·").pop()?.trim(), intent: "Ask price & availability" }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <PageHero
    eyebrow={guide.eyebrow}
    title={guide.h1}
    intro={guide.intro[0]}
    image={heroProduct?.data.image}
    imageAlt={heroProduct?.data.imageAlt ?? ""}
    credit={heroCredit}
  />

  <section class="bg-paper py-14">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[1.15fr_0.85fr] lg:px-8">
      <div>
        {guide.intro.slice(1).map((p) => <p class="mt-4 text-lg leading-relaxed text-ink-soft first:mt-0">{p}</p>)}
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={waLink(guide.enquiry)}
            target="_blank"
            rel="noopener"
            data-enquire="Ask price & availability"
            data-category={guide.eyebrow.split("·").pop()?.trim()}
            class="btn-arrow inline-flex min-h-12 items-center gap-3 bg-gradient-to-r from-brass to-mustard-dark px-7 text-xs uppercase tracking-[0.2em] text-paper hover:brightness-110"
          >
            Ask for availability &amp; rate
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href={telLink()} class="inline-flex min-h-12 items-center border border-line px-6 text-xs uppercase tracking-[0.18em] text-ink-soft hover:border-brass hover:text-ink">Call {business.phoneDisplay}</a>
        </div>
      </div>

      <aside class="border border-line bg-card p-6">
        <p class="text-[0.65rem] uppercase tracking-[0.22em] text-mustard-dark">In our catalogue</p>
        {matches.length > 0 ? (
          <>
            <p class="mt-3 font-display text-4xl">{matches.length}<span class="ml-2 text-lg text-ink-soft">{matches.length === 1 ? "match" : "matches"}</span></p>
            <ul class="mt-4 space-y-1.5 text-sm text-ink-soft">
              {byHall.map((h) => (
                <li class="flex items-center justify-between gap-3 border-b border-line/60 pb-1.5">
                  <a href={`/halls/${h.id}/`} class="link-gold">{h.name}</a>
                  <span class="tabular-nums">{h.count}</span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="mt-3 text-sm text-ink-soft">
            We don't have this on the shelf right now, but we source it regularly. Tell us the size and
            quantity and we'll come back with options and a rate.
          </p>
        )}
        <p class="mt-5 text-xs leading-relaxed text-ink-soft/80">
          Serving {business.serviceHubs.slice(0, 6).join(", ")} and the surrounding areas from our
          Karamadai showroom on Mettupalayam Main Road.
        </p>
      </aside>
    </div>
  </section>

  {shown.length > 0 && (
    <section class="border-y border-line bg-card py-16">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">From our catalogue</p></div>
            <h2 class="mt-3 font-display text-4xl sm:text-5xl">What we have for this</h2>
          </div>
          {matches.length > shown.length && (
            <a href="/search/" class="btn-arrow inline-flex min-h-11 items-center gap-2 text-xs uppercase tracking-[0.18em] text-mustard-dark hover:text-ink">
              See all {matches.length}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </div>
        <div data-gsap-stagger class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {shown.map((p) => (
            <article class="eb-card group relative border border-line bg-paper">
              <div class="absolute right-2 top-2 z-10"><SaveButton product={p} hallName={hallName(p.data.hallId)} variant="overlay" /></div>
              <a href={`/products/${p.id}/`} class="relative block overflow-hidden bg-charcoal-deep">
                <img src={p.data.image} alt={p.data.imageAlt} class="eb-img aspect-[4/3] w-full object-cover" loading="lazy" />
                {imageBadge(p.data.image) && (
                  <span class="absolute bottom-2 left-2 bg-charcoal-deep/75 px-2.5 py-1 text-[0.55rem] uppercase tracking-[0.18em] text-paper">{imageBadge(p.data.image)}</span>
                )}
              </a>
              <div class="p-4">
                <p class="text-[0.6rem] uppercase tracking-[0.18em] text-mustard-dark">{p.data.brand ?? hallName(p.data.hallId)}</p>
                <h3 class="mt-1 font-display text-2xl leading-tight"><a href={`/products/${p.id}/`} class="hover:text-mustard-dark">{p.data.name}</a></h3>
                <p class="mt-1 text-xs text-ink-soft">{[p.data.size, p.data.finish].filter(Boolean).join(" · ")}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-paper py-16">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8">
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">How to choose</p></div>
        <dl class="mt-8 divide-y divide-line border-y border-line">
          {guide.choose.map((c) => (
            <div class="py-5">
              <dt class="font-display text-2xl">{c.title}</dt>
              <dd class="mt-1 text-ink-soft leading-relaxed">{c.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Questions we get asked</p></div>
        <div class="mt-8 divide-y divide-line border-y border-line">
          {guide.faq.map((f, i) => (
            <details class="group py-4" open={i === 0}>
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-display text-xl">
                {f.q}
                <span class="text-brass transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-2 text-ink-soft leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="border-t border-line bg-card py-14">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Also worth a look</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {related.map((r) => (
            <a href={`/${r!.slug}/`} class="eb-card group block border border-line bg-paper p-5">
              <p class="text-[0.6rem] uppercase tracking-[0.2em] text-mustard-dark">{r!.eyebrow}</p>
              <p class="mt-2 font-display text-2xl leading-tight group-hover:text-mustard-dark">{r!.h1}</p>
              <span class="eb-rule mt-3" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="marble-veins bg-charcoal-deep py-16 text-center text-paper">
    <div class="mx-auto max-w-2xl px-5">
      <h2 class="font-display text-4xl sm:text-5xl">Tell us the room and the size</h2>
      <p class="mt-4 text-paper/75">We'll reply with what's in the showroom this week and a current rate. Fastest on WhatsApp.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={waLink(guide.enquiry)} target="_blank" rel="noopener" data-enquire="Ask price & availability" class="inline-flex min-h-12 items-center bg-gradient-to-r from-brass to-mustard-dark px-8 text-xs uppercase tracking-[0.2em] hover:brightness-110">Send your requirement</a>
        <a href="/contact/" class="inline-flex min-h-12 items-center border border-paper/40 px-8 text-xs uppercase tracking-[0.2em] hover:border-brass">Visit the showroom</a>
      </div>
    </div>
  </section>
</BaseLayout>
