---
import Seo from "../components/Seo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import QuickActions from "../components/QuickActions.astro";
import EnquiryDrawer from "../components/EnquiryDrawer.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
// Fonts are self-hosted (Fontsource): no third-party request on page load.
import "@fontsource/outfit/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  enquiryMessage?: string;
  // Floating CTA context, e.g. { label: "Ask about granite", category: "Granite" }.
  enquiry?: { label?: string; shortLabel?: string; product?: string; category?: string; intent?: string };
  // Homepage: header floats transparent over the full-bleed hero.
  overlayHeader?: boolean;
}

const { title, description, enquiryMessage, enquiry = {}, overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} path={Astro.url.pathname} />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
      Skip to content
    </a>
    <SiteHeader overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <QuickActions message={enquiryMessage} {...enquiry} />
    <EnquiryDrawer />
    <SearchOverlay />
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js-reveal-ready");
        var els = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window) || !els.length) {
          els.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <script is:inline>
      // Synchronous, runs before the deferred GSAP module script below.
      // Mirrors the reveal-ready pattern above: only pre-hide
      // [data-gsap-hero]/[data-gsap-stagger] children via CSS when we know
      // JS is running and the user allows motion, so nothing is ever stuck
      // invisible if a script fails to load.
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.classList.add("js-motion-ready");
      }
    </script>
    <script>
      import "../scripts/motion-gsap";
      import "../scripts/shortlist";
    </script>
  </body>
</html>
