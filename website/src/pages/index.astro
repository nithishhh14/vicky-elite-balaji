---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { business, waLink, telLink, defaultEnquiryMessage } from "../lib/business";

const halls = (await getCollection("halls")).sort((a, b) => a.data.order - b.data.order);
const featured = ["tiles", "granite-marbles", "laying-works"];
const featuredHalls = featured.map((id) => halls.find((h) => h.id === id)!).filter(Boolean);
const restHalls = halls.filter((h) => !featured.includes(h.id));
---

<BaseLayout
  title="Elite Balaji Stones & Ceramics | Virtual Showroom, Karamadai, Coimbatore"
  description="Granite, marble, tiles, sanitaryware and laying works. Wholesale trade supply from Karamadai since 2012. Walk the virtual showroom, then ask for a trade rate."
>
  <!-- 01 — Entrance -->
  <section class="relative isolate flex min-h-[88vh] items-end overflow-hidden">
    <img
      src="/media/tiles/athangudi-series/hero-crop.jpg"
      alt="Patterned red Athangudi-style floor tile in a traditional veranda"
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/15" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-6xl px-5 pb-16 pt-32 text-paper">
      <h1 class="max-w-2xl font-display text-5xl font-semibold leading-[0.95] sm:text-7xl">
        Elite Balaji
      </h1>
      <p class="mt-2 text-sm uppercase tracking-[0.3em] text-paper/80">Stones &amp; Ceramics</p>
      <p class="mt-6 max-w-md font-display text-xl italic text-paper/85">Materials that shape the space.</p>
      <div id="hero-cta" class="mt-8">
        <a href="#materials" class="inline-block rounded-full bg-terracotta px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-paper hover:bg-terracotta-dark transition-colors">
          Explore Materials
        </a>
      </div>
      <p class="mt-10 text-[0.65rem] uppercase tracking-[0.2em] text-paper/50">
        Photo: Athangudi Series, BEJ Ceramic catalogue
      </p>
    </div>
  </section>

  <div class="quatrefoil-divider" aria-hidden="true"></div>

  <!-- 02 — Material introduction -->
  <section id="materials" class="scroll-mt-20 bg-charcoal py-16">
    <div class="mx-auto max-w-6xl px-5 reveal">
      <p class="text-xs uppercase tracking-[0.3em] text-stone-light">The Materials</p>
      <h2 class="mt-2 max-w-md font-display text-3xl text-paper sm:text-4xl">Four surfaces, one yard</h2>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-1 px-1 md:grid-cols-4">
      {[
        { src: "/media/tiles/grace-series/lifestyle-ns9613.jpg", alt: "Mustard patterned tile floor, cross-petal motif", label: "Tile" },
        { src: "https://images.unsplash.com/photo-1604762537333-e60adda0acdc?auto=format&fit=crop&w=900&q=80", alt: "Polished granite slab surface", label: "Granite" },
        { src: "https://images.unsplash.com/photo-1566041510394-cf7c8fe21800?auto=format&fit=crop&w=900&q=80", alt: "White marble surface with veining", label: "Marble" },
        { src: "https://images.unsplash.com/photo-1585314062340-f1a5a7c9328d?auto=format&fit=crop&w=900&q=80", alt: "Dark honed stone texture", label: "Kadappa" },
      ].map((m) => (
        <div class="reveal group relative aspect-[3/4] overflow-hidden">
          <img src={m.src} alt={m.alt} class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/80 via-transparent to-transparent"></div>
          <span class="absolute bottom-4 left-4 text-xs uppercase tracking-[0.25em] text-paper/90">{m.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 03 — Explore showroom -->
  <section id="halls" class="scroll-mt-20 border-y border-line/60 bg-card py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-xl">
        <p class="text-xs uppercase tracking-[0.3em] text-terracotta">What we stock</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Eight product halls</h2>
      </div>

      <div class="mt-14 flex flex-col gap-16">
        {featuredHalls.map((hall, i) => (
          <a
            href={`/halls/${hall.id}/`}
            class:list={["group grid gap-6 md:grid-cols-2 md:items-center md:gap-12", i % 2 === 1 && "md:[&>*:first-child]:order-2"]}
          >
            <div class="aspect-[4/3] overflow-hidden rounded-sm shadow-card">
              {hall.data.heroImage ? (
                <img
                  src={hall.data.heroImage}
                  alt={hall.data.heroAlt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                />
              ) : (
                <div class="h-full w-full" style={{ backgroundColor: hall.data.materialColor }}></div>
              )}
            </div>
            <div>
              <span class="text-xs uppercase tracking-[0.25em] text-terracotta">
                {String(hall.data.order).padStart(2, "0")} · {hall.data.tagline}
              </span>
              <h3 class="mt-2 text-3xl group-hover:text-terracotta transition-colors">{hall.data.name}</h3>
              <p class="mt-3 max-w-md text-ink-soft leading-relaxed">{hall.data.intro}</p>
              <span class="mt-4 inline-block text-sm font-semibold uppercase tracking-wide text-terracotta">
                See what's in stock &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-16 border-t border-line/60 pt-8">
        <p class="text-xs uppercase tracking-[0.25em] text-ink-soft">Also in the showroom</p>
        <nav class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
          {restHalls.map((hall) => (
            <a href={`/halls/${hall.id}/`} class="text-lg text-ink hover:text-terracotta transition-colors">
              {hall.data.name}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- 04 — Athangudi spotlight -->
  <section class="relative isolate overflow-hidden">
    <img
      src="/media/tiles/athangudi-series/lifestyle-bottle-green.jpg"
      alt="Athangudi tile with cross motif on a courtyard floor"
      class="h-[60vh] w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-ink/10" aria-hidden="true"></div>
    <div class="absolute inset-0 flex flex-col items-start justify-end gap-3 px-5 pb-14 sm:px-12">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard">In the Tiles hall</p>
      <h2 class="max-w-lg font-display text-3xl text-paper sm:text-4xl">Athangudi Series</h2>
      <p class="max-w-md text-paper/80">
        Handmade cement tiles in the old Chettinad pattern. It's the line we get asked about most.
      </p>
      <a href="/halls/tiles/" class="mt-2 inline-block rounded-full bg-mustard px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink hover:bg-mustard-dark transition-colors">
        View the range
      </a>
    </div>
  </section>

  <!-- 05 — Why Elite Balaji -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Why contractors choose us</p>
    <h2 class="mt-3 max-w-lg text-3xl sm:text-4xl">Trusted since {business.since}, from Karamadai</h2>
    <p class="mt-5 max-w-xl text-ink-soft leading-relaxed">
      We've supplied granite, marble, tiles and sanitaryware to contractors and homes from Karamadai
      since {business.since}. We also lay it: our own crews do the site measurement, the laying and
      the finishing, so you're not coordinating two separate people. Trade rates move with supply, so
      we quote by WhatsApp or call rather than posting a price list on this site.
    </p>
    <ol class="mt-12 divide-y divide-line/60 border-y border-line/60">
      {business.usps.map((usp, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-6 py-6 sm:grid-cols-[4rem_1fr_2fr]">
          <span class="font-display text-2xl text-terracotta">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-semibold uppercase tracking-wide text-sm self-center">{usp.title}</span>
          <span class="text-ink-soft self-center">{usp.detail}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 06 — Trusted brands -->
  <section class="border-y border-line/60 bg-card py-14">
    <div class="mx-auto max-w-6xl px-5 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Partner brands</p>
      <p class="mt-4 text-lg leading-loose text-ink-soft">
        {business.partnerBrands.join(" · ")}
      </p>
    </div>
  </section>

  <!-- 07 — Service area -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Service area</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Coimbatore &amp; the Nilgiris</h2>
        <p class="mt-5 text-ink-soft leading-relaxed">
          We supply and lay across Coimbatore city and the surrounding hubs. Deliveries and site
          visits run regularly through {business.serviceHubs.slice(0, 6).join(", ")} and the wider
          Nilgiris belt.
        </p>
      </div>
      <div class="flex flex-wrap content-start gap-2">
        {business.serviceHubs.map((hub) => (
          <span class="rounded-full border border-line px-4 py-1.5 text-sm text-ink-soft">{hub}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 08 — Final CTA -->
  <section class="bg-charcoal py-20 text-paper">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="text-3xl sm:text-4xl">Have a site measurement ready?</h2>
      <p class="mt-4 text-paper/80">
        Send us the material, size and quantity, and we'll come back with trade pricing and what's
        available in stock today.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={waLink(defaultEnquiryMessage)} target="_blank" rel="noopener" class="rounded-full bg-mustard px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink hover:bg-mustard-dark transition-colors">
          WhatsApp us
        </a>
        <a href={telLink()} class="rounded-full border border-paper/50 px-6 py-3 text-sm font-semibold uppercase tracking-wide hover:bg-paper/10 transition-colors">
          Call {business.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
