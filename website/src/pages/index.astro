---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { business, waLink, telLink, defaultEnquiryMessage } from "../lib/business";
import { materialWorlds as materialWorldsConfig } from "../lib/material-worlds";
import Magnet from "../components/react-bits/Magnet";
import SpotlightCard from "../components/react-bits/SpotlightCard";

const halls = (await getCollection("halls")).sort((a, b) => a.data.order - b.data.order);
const fabricationServices = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const hallByI = (id: string) => halls.find((h) => h.id === id)!;

// Material worlds: the real halls grouped by what a customer is actually
// looking for (single source of truth in lib/material-worlds.ts, shared
// with SiteHeader's "Materials" menu and the /materials/[world]/ landing
// pages), each led by a real or honestly-disclosed photo, not a stock-photo
// grid of unrelated products.
const materialWorlds = materialWorldsConfig.map((world) => ({
  slug: world.slug,
  label: world.label,
  flagship: hallByI(world.hallIds[0]),
  also: world.hallIds.slice(1).map(hallByI),
}));

// Category strip: the 3 material worlds plus the 2 real halls that aren't
// grouped into a world (Sanitaryware, Laying Works) -- 5 categories total,
// each a real hall/world with real content, not a decorative count chosen
// to match a reference layout. The descriptor line under each label is the
// flagship hall's own existing tagline (content/halls/*.json), not new
// marketing copy written to fill the reference's second line.
const categoryStrip = [
  ...materialWorlds.map((w) => ({ href: `/materials/${w.slug}/`, label: w.label, descriptor: w.flagship.data.tagline, image: w.flagship })),
  { href: "/halls/sanitaryware/", label: "Sanitaryware", descriptor: hallByI("sanitaryware").data.tagline, image: hallByI("sanitaryware") },
  { href: "/halls/laying-works/", label: "Laying Works", descriptor: hallByI("laying-works").data.tagline, image: hallByI("laying-works") },
];

// Single consolidated stat bar (VISUAL_AUDIT_V2.md #12) -- replaces the two
// separate facts/stat bars. Every value is counted from real data or is an
// already-documented business fact; no reference-style invented statistics.
const stats = [
  { value: String(business.since), label: "Founded" },
  { value: String(halls.length), label: "Material halls" },
  { value: String(business.partnerBrands.length), label: "Partner brands" },
  { value: String(business.serviceHubs.length), label: "Service hubs" },
  { value: "India-wide", label: "Transport & supply" },
];

// Real, already-derived facet values (see src/lib/facets.ts / search-index.json.ts)
// used only as clickable text-search shortcuts into /search/ -- not fabricated categories.
const discoveryTerms = ["Grey", "White", "Polished", "Glossy", "Flooring", "Kitchen"];

---

<BaseLayout
  title="Elite Balaji Stones & Ceramics | Virtual Showroom, Karamadai, Coimbatore"
  description="Granite, marble, tiles, sanitaryware and laying works. Wholesale trade supply from Karamadai since 2012. Walk the virtual showroom, then ask for a trade rate."
>
  <!-- 01 — Entrance: no single product photo standing in for the whole
       business (that was the Athangudi-hero problem this replaces) --
       instead a licensed, illustrative reception-lobby photo (not a photo
       of Elite Balaji's own premises -- see the credit line below), colour-
       graded to the site's charcoal/gold palette, plus a strip of real
       photography across every hall further down. -->
  <!-- Text block bottom-weighted (items-end) rather than dead-centre
       (VISUAL_AUDIT_V2.md #6); photo opacity raised and the bottom overlay
       lightened so the colour-graded warmth reads through on the right while
       the left marble panel still carries text contrast (#14). Height is
       viewport minus the ~8rem two-row header, not min-h-screen: with the
       text bottom-weighted, a full-screen section put the feature row a
       header's height below the fold. -->
  <section class="relative isolate flex min-h-[calc(100svh-8rem)] items-end overflow-hidden bg-charcoal-deep pb-16 pt-24 text-paper">
    <img
      src="/media/brand/hero-lobby.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover opacity-95"
      fetchpriority="high"
    />
    <div class="marble-veins pointer-events-none absolute inset-y-0 left-0 w-[55%] bg-[linear-gradient(to_right,_var(--color-charcoal-deep)_0%,_var(--color-bottle-dark)_55%,_transparent_100%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal-deep/90 via-charcoal-deep/20 to-transparent" aria-hidden="true"></div>

    <div data-gsap-hero class="relative z-10 mx-auto w-full max-w-6xl px-5">
      <p class="text-xs uppercase leading-relaxed tracking-[0.4em] text-brass">
        Since {business.since}<br />Karamadai, Coimbatore
      </p>
      <h1 class="mt-6 font-display text-7xl font-semibold leading-[0.9] sm:text-8xl lg:text-9xl">
        <span class="bg-gradient-to-b from-brass to-mustard-dark bg-clip-text text-transparent">Stones &amp;</span><br />
        <span class="text-paper">Ceramics</span>
      </h1>
      <p class="mt-8 max-w-lg font-display text-xl italic text-paper/80">
        Granite, marble, natural stone, tiles and surfaces — sourced, supplied and laid from one yard.
      </p>
      <div id="hero-cta" class="mt-10">
        <Magnet client:load padding={80} magnetStrength={3}>
          <a href="#materials" class="inline-block rounded-full border border-brass/70 px-8 py-4 text-sm font-semibold uppercase tracking-wide text-brass hover:bg-brass hover:text-charcoal-deep transition-colors">
            Explore Materials
          </a>
        </Magnet>
      </div>

      <!-- Minimal supporting indicators only -- 3 real facts, 2-line
           stacked to match the reference's rhythm. Trust stats and
           category imagery now live in their own sections below, not
           stacked into the hero. -->
      <div class="mt-14 flex flex-wrap gap-x-12 gap-y-6">
        <div class="flex items-center gap-3">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" class="flex-shrink-0 text-brass" aria-hidden="true"><path d="M9 12l2 2 4-4M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-xs uppercase leading-snug tracking-wide text-paper/80">Zero-Bubble<br />Laying</span>
        </div>
        <div class="flex items-center gap-3">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" class="flex-shrink-0 text-brass" aria-hidden="true"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5L12 3Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-xs uppercase leading-snug tracking-wide text-paper/80">{business.partnerBrands.length} Partner<br />Brands</span>
        </div>
        <div class="flex items-center gap-3">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" class="flex-shrink-0 text-brass" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-xs uppercase leading-snug tracking-wide text-paper/80">Wholesale<br />Rates</span>
        </div>
      </div>
    </div>

    <!-- Right-side supporting text panel, mirroring the reference image's
         layout -- real copy, no border rule (VISUAL_AUDIT_V2.md #9). -->
    <div class="absolute bottom-32 right-5 hidden max-w-xs text-right text-sm text-paper/75 lg:block xl:right-[max(1.25rem,calc((100vw-72rem)/2))]">
      <p>From Karamadai's finest stone to world-class ceramics, we bring beauty, strength and style to every space.</p>
      <p class="mt-4 text-xs uppercase tracking-[0.3em] text-brass">{business.subTagline}</p>
    </div>

    <p class="absolute bottom-5 left-5 text-[0.6rem] uppercase tracking-[0.15em] text-paper/35">
      Illustrative photography (licensed stock), not Elite Balaji's own premises
    </p>
  </section>

  <!-- 02 — Explore: 5 real categories (3 material worlds + Sanitaryware +
       Laying Works), each a full photographic card with a circular arrow
       button that appears on hover -- inspired by the client's reference
       image and Varmora's own category strip, built from real hall photos
       already used honestly elsewhere on the site. Sits directly under the
       hero, as in the reference. The former 6-image swatch strip that sat
       between them was removed (VISUAL_AUDIT_V2.md #15): it repeated the
       same hall photos this strip already shows, as a second competing band. -->
  <section id="materials" class="marble-veins scroll-mt-20 bg-charcoal py-24 sm:py-28">
    <div class="mx-auto max-w-6xl px-5 reveal">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard">Explore</p>
      <h2 class="mt-3 max-w-lg font-display text-3xl text-paper sm:text-5xl">Five categories, one yard</h2>
      <p class="mt-5 max-w-xl text-paper/70">
        Everything we stock and lay, grouped the way you'd actually go looking for it.
      </p>
    </div>
    <div data-gsap-stagger class="mt-16 grid gap-1 px-1 sm:grid-cols-2 lg:grid-cols-5">
      {categoryStrip.map((cat) => (
        <SpotlightCard
          client:visible
          className="group relative isolate flex aspect-[4/5] flex-col justify-end sm:aspect-[3/4] lg:aspect-[2/3]"
          spotlightColor="rgba(196, 143, 46, 0.35)"
        >
          {cat.image.data.heroImage ? (
            <img
              src={cat.image.data.heroImage}
              alt={cat.image.data.heroAlt}
              style={cat.href === "/materials/tiles-ceramics/" ? { objectPosition: "85% center" } : undefined}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="absolute inset-0 h-full w-full" style={{ backgroundColor: cat.image.data.materialColor }}></div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/90 via-charcoal-deep/10 to-transparent"></div>
          <div class="relative flex items-end justify-between gap-3 p-6">
            <div>
              <h3 class="font-display text-2xl text-paper">{cat.label}</h3>
              <p class="mt-1.5 text-[0.65rem] uppercase leading-snug tracking-[0.2em] text-brass/90">{cat.descriptor}</p>
            </div>
            <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-paper/40 text-paper opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 -translate-x-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
          <a href={cat.href} class="absolute inset-0" aria-label={`Explore ${cat.label}`}></a>
        </SpotlightCard>
      ))}
    </div>
  </section>

  <!-- 02a — The single stat/CTA bar (VISUAL_AUDIT_V2.md #12): 5 real facts +
       1 CTA, vertical divider rules between items, appearing exactly once.
       Never the reference's own "1000+ Products / Trusted by Architects"
       style invented statistics. -->
  <section class="border-y border-paper/10 bg-charcoal-deep py-10 text-paper">
    <div class="mx-auto flex max-w-6xl flex-col items-stretch gap-8 px-5 lg:flex-row lg:items-center">
      <dl class="grid flex-1 grid-cols-2 gap-y-6 sm:grid-cols-3 lg:grid-cols-5 lg:divide-x lg:divide-paper/15">
        {stats.map((s) => (
          <div class="flex flex-col-reverse px-4 text-center">
            <dt class="mt-1.5 text-[0.65rem] uppercase tracking-[0.2em] text-paper/60">{s.label}</dt>
            <dd class="font-display text-2xl text-brass sm:text-3xl">{s.value}</dd>
          </div>
        ))}
      </dl>
      <a
        href={waLink(defaultEnquiryMessage)}
        target="_blank"
        rel="noopener"
        class="inline-flex flex-shrink-0 items-center justify-center gap-2 self-center rounded-full bg-mustard px-7 py-3.5 text-sm font-semibold uppercase tracking-wide text-ink hover:bg-mustard-dark transition-colors"
      >
        Get a Quote
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <!-- 02b — Engraved tagline: the backlit-marble-lettering motif from the
       reference image, built with CSS text-shadow rather than a photo, using
       the business's own real, already-established tagline (business.ts),
       never invented copy. -->
  <section class="marble-veins bg-charcoal-deep py-24 text-center">
    <p class="text-xs uppercase tracking-[0.4em] text-paper/50">{business.tagline}</p>
    <h2 class="engraved-gold mt-4 font-display text-4xl italic sm:text-6xl">
      {business.subTagline}
    </h2>
  </section>

  <!-- 03 — Filter: catalogue discovery -->
  <section class="border-y border-line/60 bg-card py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-xl reveal">
        <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Filter</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Search the full catalogue</h2>
        <p class="mt-4 text-ink-soft leading-relaxed">
          Filter by material, colour, look or application across every hall at once, or jump
          straight to a real result below.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        {discoveryTerms.map((term) => (
          <a
            href={`/search/?q=${encodeURIComponent(term.toLowerCase())}`}
            class="rounded-full border border-line bg-paper px-5 py-2.5 text-sm text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
          >
            {term}
          </a>
        ))}
      </div>
      <a href="/search/" data-gsap-magnetic class="mt-8 inline-block rounded-full bg-terracotta px-6 py-3 text-sm font-semibold uppercase tracking-wide text-paper hover:bg-terracotta-dark transition-colors">
        Open the full catalogue
      </a>

      <div class="mt-16 border-t border-line/60 pt-8">
        <p class="text-xs uppercase tracking-[0.25em] text-ink-soft">All halls</p>
        <nav class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
          {halls.map((hall) => (
            <a href={`/halls/${hall.id}/`} class="text-lg text-ink hover:text-terracotta transition-colors">
              {hall.data.name}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <!-- 04 — Custom & Fabrication -->
  <section class="marble-veins border-y border-line/60 bg-charcoal py-20 text-paper">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-xl reveal">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard">Beyond standard stock</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Custom &amp; fabrication</h2>
        <p class="mt-4 text-paper/75 leading-relaxed">
          Photo-printing on tiles, CNC granite engraving, hand-inlaid slabs, sculptures and name
          boards, all cut and finished to order. Real capabilities, not catalogue photos.
        </p>
      </div>
      <div data-gsap-stagger class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {fabricationServices.map((service) => (
          <div class="rounded-sm border border-paper/15 bg-paper/5 p-5">
            <h3 class="text-base">{service.data.name}</h3>
            <p class="mt-2 text-sm text-paper/70 leading-relaxed">{service.data.description}</p>
          </div>
        ))}
      </div>
      <a href="/custom/" class="mt-8 inline-block text-sm font-semibold uppercase tracking-wide text-mustard hover:text-mustard-dark">
        See all custom &amp; fabrication work &rarr;
      </a>
    </div>
  </section>

  <!-- 05 — Athangudi (one line among several, not the site's identity) -->
  <section class="border-b border-line/60 bg-card py-14">
    <a href="/halls/tiles/" class="group mx-auto flex max-w-6xl flex-col gap-6 px-5 sm:flex-row sm:items-center">
      <div class="h-20 w-28 flex-shrink-0 overflow-hidden rounded-sm sm:h-24 sm:w-32">
        <img
          src="/media/tiles/athangudi-series/swatch-petal-red.jpg"
          alt="Athangudi Series Petal Red tile swatch"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta">In the Tiles hall</p>
        <p class="mt-1 text-lg">
          <span class="font-display">Athangudi Series</span> — handmade heritage cement tiles, one of several lines we stock.
        </p>
      </div>
      <span class="text-sm font-semibold uppercase tracking-wide text-terracotta group-hover:text-terracotta-dark sm:ml-auto">
        View the range &rarr;
      </span>
    </a>
  </section>

  <!-- 06 — Why Elite Balaji -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <!-- The handshake motif from the reference badge, rendered large enough
         to actually read (illegible at header size), standing for the
         "trusted partner" idea this section's copy backs up with real USPs. -->
    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="text-brass">
      <circle cx="28" cy="28" r="26" stroke="currentColor" stroke-width="1"/>
      <path d="M14 30l6 5c1 .8 2.4.8 3.3-.1l1.2-1.2M42 30l-6 5c-1 .8-2.4.8-3.3-.1l-1.2-1.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 27l-6 3 3 6M36 27l6 3-3 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M23 29l3.5 3c.9.8 2.3.8 3.2 0l3.3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <p class="mt-5 text-xs uppercase tracking-[0.3em] text-terracotta">Why contractors choose us</p>
    <h2 class="mt-3 max-w-lg text-3xl sm:text-4xl">Trusted since {business.since}, from Karamadai</h2>
    <p class="mt-5 max-w-xl text-ink-soft leading-relaxed">
      We've supplied granite, marble, tiles and sanitaryware to contractors and homes from Karamadai
      since {business.since}. We also lay it: our own crews do the site measurement, the laying and
      the finishing, so you're not coordinating two separate people. Trade rates move with supply, so
      we quote by WhatsApp or call rather than posting a price list on this site.
    </p>
    <ol class="mt-12 divide-y divide-line/60 border-y border-line/60">
      {business.usps.map((usp, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-6 py-6 sm:grid-cols-[4rem_1fr_2fr]">
          <span class="font-display text-2xl text-terracotta">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-semibold uppercase tracking-wide text-sm self-center">{usp.title}</span>
          <span class="text-ink-soft self-center">{usp.detail}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- 07 — Trusted brands -->
  <section class="border-y border-line/60 bg-card py-14">
    <div class="mx-auto max-w-6xl px-5 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Partner brands</p>
      <p class="mt-4 text-lg leading-loose text-ink-soft">
        {business.partnerBrands.join(" · ")}
      </p>
    </div>
  </section>

  <!-- 08 — Service area -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Service area</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Coimbatore &amp; the Nilgiris</h2>
        <p class="mt-5 text-ink-soft leading-relaxed">
          Site visits and our own laying crews cover Coimbatore city, the Nilgiris and the
          surrounding hubs below. Material orders themselves aren't limited to this belt — we
          supply and transport to any destination in India, ask us for a delivery quote.
        </p>
      </div>
      <div class="flex flex-wrap content-start gap-2">
        {business.serviceHubs.map((hub) => (
          <span class="rounded-full border border-line px-4 py-1.5 text-sm text-ink-soft">{hub}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 09 — Final CTA -->
  <section class="marble-veins bg-charcoal py-20 text-paper">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="text-3xl sm:text-4xl">Have a site measurement ready?</h2>
      <p class="mt-4 text-paper/80">
        Send us the material, size and quantity, and we'll come back with trade pricing and what's
        available in stock today.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={waLink(defaultEnquiryMessage)} target="_blank" rel="noopener" data-gsap-magnetic class="rounded-full bg-mustard px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink hover:bg-mustard-dark transition-colors">
          WhatsApp us
        </a>
        <a href={telLink()} class="rounded-full border border-paper/50 px-6 py-3 text-sm font-semibold uppercase tracking-wide hover:bg-paper/10 transition-colors">
          Call {business.phoneDisplay}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
