---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getCollection } from "astro:content";
import { deriveApplicationTags } from "../lib/facets";
import { waLink } from "../lib/business";

// Applications: the real catalogue regrouped by where the material goes.
// Tags are derived from each product's own `applications` field (lib/facets),
// so nothing is hand-assigned and every future product lands here on its own.
const products = (await getCollection("products")).sort((a, b) => a.data.order - b.data.order);

const applications = [
  { tag: "flooring", label: "Flooring", blurb: "Living rooms, halls, verandas and commercial floors." },
  { tag: "walls", label: "Walls & Cladding", blurb: "Feature walls, cladding and backsplashes." },
  { tag: "kitchen", label: "Kitchens", blurb: "Platforms, backsplashes and kitchen floors." },
  { tag: "countertop", label: "Countertops", blurb: "Worktops, vanity tops and counters." },
  { tag: "bathroom", label: "Bathrooms", blurb: "Wall and floor tiles, basins and fittings." },
  { tag: "staircase", label: "Staircases", blurb: "Treads, risers and steps." },
  { tag: "exterior", label: "Exteriors", blurb: "Courtyards, driveways, pathways and outdoor areas." },
  { tag: "commercial", label: "Commercial", blurb: "Lobbies, retail and high-traffic spaces." },
]
  .map((app) => ({
    ...app,
    items: products.filter((p) => deriveApplicationTags(p.data.applications).includes(app.tag)),
  }))
  .filter((app) => app.items.length > 0);
---

<BaseLayout
  title="Applications | Elite Balaji Stones & Ceramics"
  description="Stone, tiles and surfaces by application: flooring, walls, kitchens, countertops, bathrooms, staircases, exteriors and commercial spaces."
>
  <PageHero
    eyebrow="Applications"
    title="Surfaces for every space"
    intro="Start from the space you're building. Every material below is in our catalogue. WhatsApp us for stock and trade rates."
  />

  <nav aria-label="Applications" class="sticky top-[5.5rem] z-30 border-b border-line/60 bg-paper/95 backdrop-blur lg:top-[7.5rem]">
    <div class="mx-auto flex max-w-7xl gap-6 overflow-x-auto px-5 py-3 lg:px-8">
      {applications.map((app) => (
        <a href={`#${app.tag}`} class="whitespace-nowrap text-xs uppercase tracking-[0.18em] text-ink-soft hover:text-terracotta transition-colors">{app.label}</a>
      ))}
    </div>
  </nav>

  {applications.map((app, i) => (
    <section id={app.tag} class:list={["scroll-mt-40 py-16", i % 2 === 1 && "bg-card"]}>
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="reveal">
            <p class="text-xs uppercase tracking-[0.3em] text-terracotta">{String(i + 1).padStart(2, "0")}</p>
            <h2 class="mt-2 font-display text-4xl uppercase">{app.label}</h2>
            <p class="mt-2 text-ink-soft">{app.blurb}</p>
          </div>
          <a href={`/search/?application=${app.tag}`} class="text-xs font-semibold uppercase tracking-[0.18em] text-terracotta hover:text-terracotta-dark">
            Filter all {app.label.toLowerCase()} &rarr;
          </a>
        </div>
        <div data-gsap-stagger class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
          {app.items.slice(0, 10).map((p) => (
            <a href={`/products/${p.id}/`} class="group block">
              <div class="aspect-square overflow-hidden bg-charcoal-deep">
                <img src={p.data.image} alt={p.data.imageAlt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="400" height="400" />
              </div>
              <p class="mt-3 text-[0.65rem] uppercase tracking-[0.18em] text-terracotta">{p.data.brand ?? p.data.category ?? "Elite Balaji"}</p>
              <h3 class="mt-1 text-sm leading-snug group-hover:text-terracotta transition-colors">{p.data.name}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="marble-veins bg-charcoal py-16 text-center text-paper">
    <h2 class="font-display text-3xl uppercase sm:text-4xl">Not sure what suits your space?</h2>
    <p class="mx-auto mt-3 max-w-xl text-paper/75">Send us the room, size and budget. We'll suggest what's in stock.</p>
    <a href={waLink("Hi Elite Balaji, I need help choosing a material for my space.")} target="_blank" rel="noopener" class="mt-8 inline-block border border-brass px-8 py-4 text-xs uppercase tracking-[0.2em] text-paper hover:bg-brass hover:text-charcoal-deep transition-colors">
      Ask an expert
    </a>
  </section>
</BaseLayout>
