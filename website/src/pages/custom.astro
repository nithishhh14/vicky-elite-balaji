---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, productEnquiryMessage } from "../lib/business";

const halls = await getCollection("halls");
const hallName = (id: string) => halls.find((h) => h.id === id)?.data.name ?? id;
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

// Restrained line-art icon per capability category, not a photo — none of
// this is claimed to be an actual finished job, it's a visual cue for a
// real, described capability. Keyed by category slug (not the display
// name) so a future rename of the service doesn't silently lose its icon.
const icons: Record<string, string> = {
  "tile-printing": "M4 5h16v14H4z M4 15l4-4 3 3 5-6 4 5 M8.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z",
  engraving: "M12 3l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.5-.8z",
  inlay: "M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z",
  "sculpture-signage": "M12 3c2 0 3 2 3 4s-1 3-1 4c1 .5 2 2 2 4v3H8v-3c0-2 1-3.5 2-4 0-1-1-2-1-4s1-4 3-4z",
};
---

<BaseLayout
  title="Custom & Fabrication | Elite Balaji Stones & Ceramics"
  description="Bespoke stone and tile work from Elite Balaji: custom photo-printing on tiles, CNC granite engraving, handcrafted inlay slabs, sculptures and name boards, made to order."
  enquiryMessage="Hi Elite Balaji, I have a requirement for custom tile printing, marble or granite artwork. I would like to discuss the project."
>
  <section class="border-b border-line/60 bg-charcoal py-20 text-paper">
    <div data-gsap-hero class="mx-auto max-w-3xl px-5 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard">Made to order</p>
      <h1 class="mt-3 font-display text-4xl sm:text-5xl">Custom &amp; Fabrication</h1>
      <p class="mt-5 text-lg text-paper/75 leading-relaxed">
        Beyond standard stock, we take on bespoke stone and tile work: custom printing, engraving,
        inlay and made-to-order pieces. Every capability below is real, not a catalogue photo, so
        tell us what you have in mind and we'll confirm what's possible.
      </p>
    </div>
  </section>

  <section class="border-b border-line/60 bg-paper py-16">
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-center text-xs uppercase tracking-[0.3em] text-terracotta">How a custom piece happens</p>
      <div data-gsap-stagger class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {[
          { step: "01", label: "Material", detail: "Pick the stone or tile, from our stock or sourced for you." },
          { step: "02", label: "Design", detail: "Send us the image, pattern or drawing you have in mind." },
          { step: "03", label: "Fabrication", detail: "Printing, CNC engraving or inlay work, cut to your size." },
          { step: "04", label: "Finish", detail: "Polished, honed or matte, finished to match the rest of the job." },
          { step: "05", label: "Installation", detail: "Our own crews fit it on site, same as any other laying job." },
        ].map((s) => (
          <div>
            <span class="font-display text-2xl text-terracotta">{s.step}</span>
            <h3 class="mt-2 text-sm font-semibold uppercase tracking-wide">{s.label}</h3>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-card">
    <div class="mx-auto max-w-6xl px-5 py-16">
      {services.length > 0 ? (
        <div data-gsap-stagger class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <div class="group rounded-sm border border-line bg-paper p-6 transition-colors hover:border-terracotta/60">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-charcoal text-mustard">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icons[service.data.category] ?? "M12 3l9 9-9 9-9-9z"} />
                </svg>
              </div>
              <p class="mt-4 text-xs uppercase tracking-[0.2em] text-terracotta">{hallName(service.data.hallId)}</p>
              <h2 class="mt-1 text-lg">{service.data.name}</h2>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed">{service.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
                <a
                  href={waLink(productEnquiryMessage(service.data.name))}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Ask about ${service.data.name} via WhatsApp`}
                  class="inline-block text-sm font-semibold uppercase tracking-wide text-terracotta hover:text-terracotta-dark"
                >
                  WhatsApp &rarr;
                </a>
                <a href={`/halls/${service.data.hallId}/`} class="inline-block text-sm font-semibold uppercase tracking-wide text-ink-soft hover:text-terracotta">
                  See the hall &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center text-ink-soft">More bespoke work is being added here.</p>
      )}
    </div>
  </section>

  <section class="border-t border-line/60 bg-paper">
    <div class="mx-auto max-w-4xl px-5 py-16 text-center">
      <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Beyond the list above</p>
      <h2 class="mt-3 text-2xl sm:text-3xl">Bring us a stone or tile idea we haven't listed</h2>
      <p class="mt-4 text-ink-soft leading-relaxed">
        If it's granite, marble, tile or ceramic, our team can talk through sourcing, fabrication
        and installation even when it isn't one of the fixed categories above. Nothing here is
        promised until we've confirmed it against your actual site and material.
      </p>
    </div>
  </section>

  <section class="bg-charcoal py-20 text-paper">
    <div class="mx-auto max-w-2xl px-5 text-center">
      <h2 class="font-display text-3xl sm:text-4xl">Have a specific requirement?</h2>
      <p class="mt-4 text-paper/80">
        Tell us what you're looking for. If it involves tiles, stone, marble, granite or ceramics,
        we'll help you find the right solution.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={waLink('Hi Elite Balaji, I have a requirement involving tiles, stone, marble, granite or ceramics. Here are the details:')}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-terracotta px-6 py-3 text-sm font-semibold uppercase tracking-wide text-paper hover:bg-terracotta-dark transition-colors"
        >
          Start a Requirement
        </a>
        <a href={telLink()} class="rounded-full border border-paper/50 px-6 py-3 text-sm font-semibold uppercase tracking-wide hover:bg-paper/10 transition-colors">
          Call Showroom
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
