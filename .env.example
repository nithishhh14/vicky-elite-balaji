# Copy to .env and fill in real values. Never commit .env itself.

# Google Gemini API key used by shared_memory.configure_gemini() for the
# Vicky Executive agent's chat responses.
GEMINI_API_KEY=

# Google service account credentials for Sheets access are a separate file,
# not an env var — see google_creds.json (gitignored, ask for the real file).

# Optional: overrides shared_memory.py's default SHEET_ID. Set this when
# migrating to a new spreadsheet (e.g. once the official Elite Balaji Google
# Business account is verified) instead of editing code.
GOOGLE_SHEET_ID=
