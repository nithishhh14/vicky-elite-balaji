---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaterialField from "../../components/MaterialField.astro";
import MaterialViewer3D from "../../components/MaterialViewer3D.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, emailQuoteLink, productEnquiryMessage } from "../../lib/business";
import { deriveColours } from "../../lib/facets";

export async function getStaticPaths() {
  const halls = await getCollection("halls");
  return halls.map((hall) => ({ params: { slug: hall.id }, props: { hall } }));
}

const { hall } = Astro.props;
const { name, tagline, intro, hasRealContent, heroImage, heroAlt, materialColor, materialTexture, applications, enquiryNote, additionalServices } = hall.data;

const products = hall.id === "tiles"
  ? (await getCollection("tileProducts")).sort((a, b) => a.data.order - b.data.order)
  : (await getCollection("materialProducts")).filter((p) => p.data.hallId === hall.id).sort((a, b) => a.data.order - b.data.order);

// Explore-by-colour: derived from the same real fields as the search index
// (see src/lib/facets.ts), scoped to this hall's own products only.
const COLOUR_SWATCH: Record<string, string> = {
  white: "#f4f1ea", black: "#1c1a17", grey: "#8a8580", beige: "#cdbfa0",
  brown: "#6b4a34", red: "#8c2f22", mustard: "#c48f2e", green: "#3f5c46",
};
const hallColours = Array.from(
  new Set(
    products.flatMap((p) => {
      const n = "brand" in p.data ? `${p.data.series}${p.data.code ? ` ${p.data.code}` : ""}` : p.data.name;
      return deriveColours(n, p.data.finish, p.data.imageAlt);
    })
  )
).sort();
---

<BaseLayout
  title={`${name} | Elite Balaji Stones & Ceramics`}
  description={intro}
  enquiryMessage={productEnquiryMessage(name)}
>
  <section class="relative isolate flex h-[52vh] min-h-[360px] items-end overflow-hidden">
    {heroImage ? (
      <img src={heroImage} alt={heroAlt} class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    ) : (
      <div class="absolute inset-0 h-full w-full">
        <MaterialField color={materialColor} texture={materialTexture} label="" class="h-full w-full" />
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 pb-10 text-paper">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard">{tagline}</p>
      <h1 class="mt-2 font-display text-4xl sm:text-5xl">{name}</h1>
      {heroImage && !hasRealContent && (
        <p class="mt-3 text-[0.65rem] uppercase tracking-[0.2em] text-paper/50">Mood photography, not actual stock</p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-12 md:grid-cols-[1.3fr_0.7fr]">
      <p class="max-w-2xl text-lg leading-relaxed text-ink-soft">{intro}</p>
      <div class="rounded-sm border border-line bg-card p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-terracotta">Applications</p>
        <ul class="mt-3 space-y-1.5 text-sm text-ink-soft">
          {applications.map((app) => <li>{app}</li>)}
        </ul>
        <p class="mt-5 text-sm font-medium text-ink">{enquiryNote}</p>
        <div class="mt-4 flex flex-col gap-2">
          <a
            href={waLink(productEnquiryMessage(name))}
            target="_blank"
            rel="noopener"
            aria-label={`Ask for trade rate on ${name} via WhatsApp`}
            class="rounded-full bg-terracotta px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-wide text-paper hover:bg-terracotta-dark transition-colors"
          >
            Enquire via WhatsApp
          </a>
          <a
            href={telLink()}
            aria-label={`Call our showroom about ${name}`}
            class="rounded-full border border-terracotta/60 px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-wide text-terracotta hover:bg-terracotta hover:text-paper transition-colors"
          >
            Call Showroom
          </a>
          <a
            href={emailQuoteLink(name)}
            aria-label={`Request an email quote for ${name}`}
            class="rounded-full border border-line px-5 py-2.5 text-center text-sm font-semibold uppercase tracking-wide text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
          >
            Request Email Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  {hallColours.length > 1 && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <p class="text-xs uppercase tracking-[0.25em] text-terracotta">Explore by colour</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {hallColours.map((colour) => (
            <a
              href={`/search/?material=${encodeURIComponent(name)}&colour=${encodeURIComponent(colour)}`}
              class="group flex items-center gap-2 rounded-full border border-line bg-paper py-1.5 pl-1.5 pr-4 hover:border-terracotta transition-colors"
            >
              <span class="h-6 w-6 rounded-full border border-line/60" style={{ backgroundColor: COLOUR_SWATCH[colour] ?? "#ccc" }} aria-hidden="true"></span>
              <span class="text-sm capitalize text-ink-soft group-hover:text-terracotta transition-colors">{colour}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {hall.id === "tiles" && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 md:grid-cols-[0.8fr_1.2fr] md:items-center">
        <MaterialViewer3D
          image="/media/tiles/athangudi-series/swatch-petal-red.jpg"
          alt="Athangudi Series Petal Red tile swatch with corner petal motif"
          label="Athangudi Petal Red"
        />
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Real swatch, up close</p>
          <h2 class="mt-2 text-3xl">See the pattern in the round</h2>
          <p class="mt-4 max-w-md text-ink-soft leading-relaxed">
            This is the actual Athangudi Series Petal Red swatch from the BEJ Ceramic catalogue,
            mapped onto a simple tile so you can turn it and see the corner petal motif from an
            angle before it arrives on site. Drag it, or leave it to turn on its own.
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="text-xs uppercase tracking-[0.3em] text-terracotta">{hall.id === "tiles" ? "Series in stock" : "Catalogue"}</p>
    <h2 class="mt-2 text-3xl">{hall.id === "tiles" ? "Tile catalogue" : `${name} range`}</h2>
    <div data-gsap-stagger class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {hall.id === "tiles"
        ? products.map((p) => "data" in p && "brand" in p.data && (
          <article class="overflow-hidden rounded-sm border border-line bg-card shadow-card">
            <a href={`/products/${p.id}/`} class="block" aria-label={`View details for ${p.data.series}`}>
              <div class="aspect-[4/3] overflow-hidden">
                <img src={p.data.image} alt={p.data.imageAlt} class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="600" height="450" />
              </div>
            </a>
            <div class="p-5">
              <p class="text-xs uppercase tracking-[0.15em] text-terracotta">{p.data.brand}</p>
              <h3 class="mt-1 text-lg">
                <a href={`/products/${p.id}/`} class="hover:text-terracotta transition-colors">{p.data.series}{p.data.code ? ` · ${p.data.code}` : ""}</a>
              </h3>
              <p class="mt-2 text-sm text-ink-soft">{p.data.size} · {p.data.finish}</p>
              {p.data.note && <p class="mt-2 text-sm text-ink-soft italic">{p.data.note}</p>}
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
                <a href={`/products/${p.id}/`} class="inline-block text-sm font-semibold uppercase tracking-wide text-ink hover:text-terracotta">
                  View details &rarr;
                </a>
                <a
                  href={waLink(productEnquiryMessage(`${p.data.series}${p.data.code ? " " + p.data.code : ""}`))}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Ask for trade rate on ${p.data.series} via WhatsApp`}
                  class="inline-block text-sm font-semibold uppercase tracking-wide text-terracotta hover:text-terracotta-dark"
                >
                  WhatsApp &rarr;
                </a>
                <a
                  href={emailQuoteLink(`${p.data.series}${p.data.code ? " " + p.data.code : ""}`)}
                  aria-label={`Request an email quote for ${p.data.series}`}
                  class="inline-block text-sm font-semibold uppercase tracking-wide text-ink-soft hover:text-terracotta"
                >
                  Email quote &rarr;
                </a>
              </div>
              <p class="mt-3 text-[0.7rem] uppercase tracking-wide text-ink-soft/60">{p.data.sourceCatalogue}</p>
            </div>
          </article>
        ))
        : products.map((p) => "data" in p && "category" in p.data && (
          <article class="overflow-hidden rounded-sm border border-line bg-card shadow-card">
            <a href={`/products/${p.id}/`} class="block" aria-label={`View details for ${p.data.name}`}>
              <div class="aspect-[4/3] overflow-hidden">
                <img src={p.data.image} alt={p.data.imageAlt} class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" width="600" height="450" />
              </div>
            </a>
            <div class="p-5">
              <p class="text-xs uppercase tracking-[0.15em] text-terracotta">{p.data.category}</p>
              <h3 class="mt-1 text-lg">
                <a href={`/products/${p.id}/`} class="hover:text-terracotta transition-colors">{p.data.name}</a>
              </h3>
              <p class="mt-2 text-sm text-ink-soft">Finish: {p.data.finish}</p>
              <p class="mt-1 text-sm text-ink-soft">{p.data.applications.join(", ")}</p>
              <p class="mt-2 text-sm text-ink-soft italic">{p.data.note}</p>
              <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
                <a href={`/products/${p.id}/`} class="inline-block text-sm font-semibold uppercase tracking-wide text-ink hover:text-terracotta">
                  View details &rarr;
                </a>
                <a
                  href={waLink(productEnquiryMessage(p.data.name))}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Ask for trade rate on ${p.data.name} via WhatsApp`}
                  class="inline-block text-sm font-semibold uppercase tracking-wide text-terracotta hover:text-terracotta-dark"
                >
                  WhatsApp &rarr;
                </a>
                <a
                  href={emailQuoteLink(p.data.name)}
                  aria-label={`Request an email quote for ${p.data.name}`}
                  class="inline-block text-sm font-semibold uppercase tracking-wide text-ink-soft hover:text-terracotta"
                >
                  Email quote &rarr;
                </a>
              </div>
            </div>
          </article>
        ))}
    </div>
  </section>

  {additionalServices && additionalServices.length > 0 && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Also from this hall</p>
        <h2 class="mt-2 text-3xl">Bespoke &amp; made to order</h2>
        <div data-gsap-stagger class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {additionalServices.map((service) => (
            <div class="rounded-sm border border-line bg-paper p-6">
              <h3 class="text-lg">{service.name}</h3>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed">{service.description}</p>
              <a
                href={waLink(productEnquiryMessage(service.name))}
                target="_blank"
                rel="noopener"
                aria-label={`Ask about ${service.name} via WhatsApp`}
                class="mt-4 inline-block text-sm font-semibold uppercase tracking-wide text-terracotta hover:text-terracotta-dark"
              >
                Ask about this &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-line/60 bg-charcoal py-14 text-paper">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <p class="text-lg">Looking for something not shown here in {name}?</p>
      <p class="mt-2 text-sm text-paper/70">
        Tell us the material, colour, size or finish you need. We can help source it beyond what's
        listed in this hall today.
      </p>
      <a
        href={waLink(`Hi Elite Balaji, I'm looking for something in ${name} that isn't shown on the website. Here's what I need:`)}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-block rounded-full bg-mustard px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink hover:bg-mustard-dark transition-colors"
      >
        Ask us to source it
      </a>
    </div>
  </section>
</BaseLayout>
