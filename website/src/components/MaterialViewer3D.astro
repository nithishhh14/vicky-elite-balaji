---
// Lightweight, lazy-loaded 3D material sample viewer. Three.js is only
// fetched on pages that render this component (dynamic import inside the
// script below), and it only ever displays a real, already-verified
// product photo mapped onto a simple tile shape -- no invented geometry,
// no invented product. If WebGL is unavailable, the texture fails to
// load, or the viewer is off-screen, the real <img> underneath is what
// the visitor sees; nothing breaks.
interface Props {
  image: string;
  alt: string;
  label?: string;
}

const { image, alt, label = "Look closer" } = Astro.props;
---

<div
  data-material-viewer
  data-image={image}
  class="relative mx-auto aspect-square w-full max-w-[280px] overflow-hidden rounded-sm border border-line bg-card shadow-card"
>
  <img src={image} alt={alt} class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500" loading="lazy" />
  <canvas data-viewer-canvas aria-hidden="true" class="absolute inset-0 h-full w-full touch-none opacity-0 transition-opacity duration-500"></canvas>
  <p data-viewer-hint class="pointer-events-none absolute bottom-2 right-2 rounded-full bg-ink/60 px-3 py-1 text-[0.6rem] uppercase tracking-[0.2em] text-paper/90 opacity-0 transition-opacity duration-500">
    {label} &middot; drag to rotate
  </p>
</div>

<script>
  (async () => {
    const containers = document.querySelectorAll<HTMLElement>("[data-material-viewer]");
    if (!containers.length) return;
    if (typeof WebGLRenderingContext === "undefined") return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Named imports so Rollup can tree-shake the parts of three.js this
    // viewer doesn't use, instead of pulling in the whole namespace.
    const {
      WebGLRenderer,
      Scene,
      PerspectiveCamera,
      AmbientLight,
      DirectionalLight,
      TextureLoader,
      BoxGeometry,
      MeshStandardMaterial,
      Mesh,
      SRGBColorSpace,
    } = await import("three");
    type Texture = InstanceType<typeof import("three").Texture>;

    containers.forEach((container) => {
      const canvas = container.querySelector<HTMLCanvasElement>("[data-viewer-canvas]");
      const img = container.querySelector<HTMLImageElement>("img");
      const hint = container.querySelector<HTMLElement>("[data-viewer-hint]");
      const image = container.dataset.image;
      if (!canvas || !img || !image) return;

      let renderer: InstanceType<typeof WebGLRenderer>;
      try {
        renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true });
      } catch {
        return;
      }

      const scene = new Scene();
      const camera = new PerspectiveCamera(35, 1, 0.1, 10);
      // Steep-ish downward angle so the tile's top face reads as a
      // foreshortened square, not an edge-on sliver.
      camera.position.set(0, 2.0, 1.6);
      camera.lookAt(0, 0, 0);

      scene.add(new AmbientLight(0xffffff, 0.75));
      const dirLight = new DirectionalLight(0xffffff, 0.9);
      dirLight.position.set(2, 3, 2);
      scene.add(dirLight);

      new TextureLoader().load(
        image,
        (texture: Texture) => {
          texture.colorSpace = SRGBColorSpace;

          const edge = new MeshStandardMaterial({ color: 0xd8d2c4, roughness: 0.9 });
          const geometry = new BoxGeometry(1.7, 0.14, 1.7);
          const tile = new Mesh(geometry, [
            edge,
            edge,
            new MeshStandardMaterial({ map: texture, roughness: 0.6 }),
            new MeshStandardMaterial({ color: 0x2a2622, roughness: 0.9 }),
            edge,
            edge,
          ]);
          tile.rotation.x = -0.08;
          scene.add(tile);

          function resize() {
            const size = container.clientWidth;
            renderer.setSize(size, size, false);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          }
          resize();
          window.addEventListener("resize", resize);

          let dragging = false;
          let lastX = 0;
          const idleSpin = prefersReducedMotion ? 0 : 0.004;

          canvas.addEventListener("pointerdown", (e) => {
            dragging = true;
            lastX = e.clientX;
            canvas.setPointerCapture(e.pointerId);
          });
          canvas.addEventListener("pointermove", (e) => {
            if (!dragging) return;
            tile.rotation.y += (e.clientX - lastX) * 0.01;
            lastX = e.clientX;
          });
          canvas.addEventListener("pointerup", () => (dragging = false));
          canvas.addEventListener("pointerleave", () => (dragging = false));

          let raf = 0;
          function animate() {
            if (!dragging) tile.rotation.y += idleSpin;
            renderer.render(scene, camera);
            raf = requestAnimationFrame(animate);
          }

          // Only spend frames while the viewer is actually visible.
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  if (!raf) animate();
                } else if (raf) {
                  cancelAnimationFrame(raf);
                  raf = 0;
                }
              });
            },
            { threshold: 0.1 }
          );
          io.observe(container);

          canvas.style.opacity = "1";
          img.style.opacity = "0";
          if (hint) hint.style.opacity = "1";
        },
        undefined,
        () => {
          // Texture failed to load — leave the real <img> as the display.
        }
      );
    });
  })();
</script>
