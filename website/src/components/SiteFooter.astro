---
import { business, telLink, waLink, emailQuoteLink, defaultEnquiryMessage } from "../lib/business";
---

<footer class="mt-24 border-t border-line/70 bg-bottle text-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl">Elite Balaji</p>
      <p class="text-xs uppercase tracking-[0.25em] text-mustard mt-1">Stones &amp; Ceramics</p>
      <p class="mt-4 text-sm text-paper/75">{business.tagline} — since {business.since}.</p>
    </div>

    <div class="text-sm text-paper/80">
      <p class="uppercase tracking-wide text-xs text-paper/50 mb-2">Visit</p>
      <p>{business.address}</p>
      <p class="mt-3">
        <a href={telLink()} class="underline decoration-mustard/60 underline-offset-4 hover:text-mustard">{business.phoneDisplay}</a>
      </p>
      <p class="mt-1">
        <a href={`mailto:${business.email}`} class="underline decoration-mustard/60 underline-offset-4 hover:text-mustard">{business.email}</a>
      </p>
      <p class="mt-1">
        <a href={waLink(defaultEnquiryMessage)} class="underline decoration-mustard/60 underline-offset-4 hover:text-mustard">WhatsApp enquiry</a>
      </p>
      <p class="mt-1">
        <a href={emailQuoteLink()} class="underline decoration-mustard/60 underline-offset-4 hover:text-mustard">Request email quote</a>
      </p>
      <p class="mt-1">
        <a href={business.mapLink} target="_blank" rel="noopener" class="underline decoration-mustard/60 underline-offset-4 hover:text-mustard">Get directions</a>
      </p>
    </div>

    <div class="text-sm text-paper/80">
      <p class="uppercase tracking-wide text-xs text-paper/50 mb-2">Service area</p>
      <p class="leading-relaxed">{business.serviceHubs.join(" · ")}</p>
    </div>
  </div>

  <div class="border-t border-paper/10 py-5 text-center text-xs text-paper/50">
    <p>&copy; {new Date().getFullYear()} {business.name}. {business.subTagline}.</p>
  </div>
</footer>
