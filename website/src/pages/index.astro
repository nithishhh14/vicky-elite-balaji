---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { business, waLink, telLink } from "../lib/business";
import { mediaIn, mediaLibrary, provenanceLabel } from "../lib/media-library";
import Magnet from "../components/react-bits/Magnet";
import MaterialMatch from "../components/MaterialMatch.astro";
import QuoteForm from "../components/QuoteForm.astro";
import SaveButton from "../components/SaveButton.astro";
import AmbientVideo from "../components/AmbientVideo.astro";
import { videoZones } from "../lib/video-zones";
import { byOrder } from "../lib/order";

const products = await getCollection("products");
const bySlug = (slug: string) => mediaLibrary.find((m) => m.slug === slug)!;

// 02 — Material worlds. Real photography wherever it exists: granite and
// marble from our own yard, tiles from supplier catalogues, stonecraft from
// our own work. Only Bathroom still uses the client-approved concept render,
// and says so.
const worlds = [
  { href: "/granite/", label: "Granite", descriptor: "From our slab yard", image: bySlug("black-galaxy-slabs").thumb, credit: provenanceLabel.stock },
  { href: "/marble/", label: "Marble", descriptor: "Slabs & marble-look tiles", image: bySlug("white-slab-veined").thumb, credit: provenanceLabel.stock },
  { href: "/halls/tiles/", label: "Tiles & Ceramics", descriptor: "Floor, wall & large format", image: "/media/tiles/athangudi-series/lifestyle-bottle-green.jpg", credit: "Supplier catalogue" },
  { href: "/applications/#bathroom", label: "Bath Spaces", descriptor: "Tiles, sanitaryware & fittings", image: "/media/tiles/mozzato-endless/azzuro-room.jpg", credit: "Supplier catalogue" },
  { href: "/custom/", label: "Custom Stonecraft", descriptor: "Engraving & stone furniture", image: bySlug("tulsi-madam-engraved-black").thumb, credit: provenanceLabel.work },
];

// Trust bar: verified facts only (business.ts / .cursorrules / client
// confirmation logged in docs/DECISIONS.md).
const facts = [
  { value: `Since ${business.since}`, label: "Karamadai, Coimbatore" },
  { value: `${business.partnerBrands.length} brands`, label: "We work with" },
  { value: "Own slab yard", label: "Granite & marble" },
  { value: "Made to order", label: "Custom stonecraft" },
  { value: "Pan-India", label: "Custom art delivery" },
];

const specimens = products
  .filter((p) => p.data.hallId === "granite-marbles" && /granite|sandstone/i.test(p.data.category ?? ""))
  .sort(byOrder);

const craft = mediaIn("stonecraft", "work");

// "What could I use here?": each room lists material categories we actually
// carry (real halls/pages), revealed on hover and always shown on touch.
const applications = [
  { label: "Living & flooring", href: "/applications/#flooring", image: "/media/concepts/living-960.jpg", credit: "Application concept", materials: ["Marble-look tiles", "Granite", "Kota stone"] },
  { label: "Kitchen", href: "/applications/#kitchen", image: "/media/concepts/kitchen-960.jpg", credit: "Application concept", materials: ["Granite", "Quartz", "Quartz sinks", "Kadappa"] },
  { label: "Bath Spaces", href: "/applications/#bathroom", image: "/media/concepts/bathroom-960.jpg", credit: "Application concept", materials: ["Wall & floor tiles", "Basins", "Adhesives"] },
  { label: "Staircase", href: "/applications/#staircase", image: bySlug("granite-staircase").thumb, credit: provenanceLabel.work, materials: ["Granite", "Marble", "Kota stone"] },
  { label: "Facade & parking", href: "/applications/#exterior", image: "/media/concepts/facade-960.jpg", credit: "Application concept", materials: ["Granite cladding", "Outdoor tiles", "Kota stone"] },
  { label: "Outdoor & garden", href: "/custom/#furniture", image: bySlug("granite-outdoor-table-set").thumb, credit: provenanceLabel.work, materials: ["Granite benches", "Tables", "Tulsi madams"] },
];

const productBrands = new Set(products.map((p) => p.data.brand).filter(Boolean));
const localHubs = ["Karamadai", "Coimbatore", "Mettupalayam", "Annur", "Sirumugai", "Periyanaickenpalayam", "Thudiyalur", "Saravanampatti", "Kallar", "Ooty", "Kotagiri", "Nilgiris"];
---

<BaseLayout
  title="Granite, Marble & Tiles in Karamadai | Elite Balaji"
  description="Granite slabs, marble, tiles, basins and custom stonecraft from our Karamadai yard since 2012, for homes and builders across Coimbatore."
  overlayHeader
>
  <!-- 01 — Cinematic hero: black → gold line → showroom concept settles in → type. -->
  <section data-hero-intro class="relative isolate flex min-h-[92svh] items-center overflow-hidden bg-charcoal-deep pb-16 pt-36 text-paper lg:min-h-[max(92svh,780px)] lg:pt-44">
    <!-- Image layer: resolves from the dark field, then drifts very slowly.
         data-depth adds a few px of pointer parallax on fine pointers. -->
    <div data-depth="14" data-hero-depth class="absolute inset-y-0 right-0 w-full overflow-hidden lg:w-[68%]">
      {videoZones.hero ? (
        <AmbientVideo poster={videoZones.hero.poster} posterAlt="" src={videoZones.hero.src} webm={videoZones.hero.webm} mobileSrc={videoZones.hero.mobileSrc} eager aspectClass="h-full w-full" class="absolute inset-0" />
      ) : (
        <img
          data-intro-image
          src="/media/reference/hero-interior.jpg"
          alt=""
          aria-hidden="true"
          width="1630"
          height="1136"
          class="absolute inset-0 h-full w-full object-cover object-[70%_center] lg:object-left"
          fetchpriority="high"
        />
      )}
    </div>
    <div data-hero-texture class="marble-veins pointer-events-none absolute inset-y-0 left-0 w-full bg-[linear-gradient(to_right,_var(--color-charcoal-deep)_0%,_color-mix(in_srgb,var(--color-bottle-dark)_85%,transparent)_45%,_transparent_78%)] lg:w-[62%] lg:bg-[linear-gradient(to_right,_var(--color-charcoal-deep)_0%,_var(--color-bottle-dark)_60%,_transparent_100%)]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-charcoal-deep/85 via-transparent to-charcoal-deep/70" aria-hidden="true"></div>
    <span data-intro-line class="pointer-events-none absolute left-0 top-1/2 z-10 h-px w-full bg-gradient-to-r from-transparent via-brass to-transparent" aria-hidden="true"></span>

    <div class="relative z-10 mx-auto w-full max-w-7xl px-5 lg:px-8">
      <!-- The brand name already sits in the header; the hero opens with the
           reference mockup's eyebrow instead of repeating it. -->
      <p data-hero-seq="eyebrow" class="text-[0.7rem] uppercase leading-[1.9] tracking-[0.5em] text-paper/80 sm:text-sm">Natural beauty<br />Timeless spaces</p>
      <h1 class="mt-4 font-display text-[clamp(2.75rem,12vw,7.25rem)] font-medium uppercase leading-[0.92]">
        <span class="sr-only">Elite Balaji </span>
        <span class="line-mask"><span data-hero-line class="gold-engraved">Stones &amp;</span></span>
        <span class="line-mask"><span data-hero-line class="text-paper">Ceramics</span></span>
      </h1>
      <p data-hero-seq="support" class="mt-6 max-w-xl font-display text-2xl leading-snug text-paper/90 sm:text-3xl">
        Natural stone. Architectural surfaces. Built to last.
      </p>
      <div data-hero-seq="cta" class="mt-9 flex flex-wrap items-center gap-3">
        <div id="hero-cta">
          <Magnet client:idle padding={70} magnetStrength={3}>
            <a href="#materials" class="btn-arrow inline-flex min-h-12 items-center gap-3 border border-brass bg-charcoal-deep/30 px-7 py-3.5 text-xs uppercase tracking-[0.2em] text-paper hover:bg-brass hover:text-charcoal-deep">
              Explore materials
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </Magnet>
        </div>
        <a href={waLink("Hi Elite Balaji, I'd like to talk to your team about a project.")} target="_blank" rel="noopener" data-enquire="Send my project requirement" class="link-gold inline-flex min-h-12 items-center px-5 py-3.5 text-xs uppercase tracking-[0.2em] text-paper/85">Talk to our team</a>
        <a href="#quote" class="link-gold inline-flex min-h-12 items-center px-5 py-3.5 text-xs uppercase tracking-[0.2em] text-paper/85">Request a quote</a>
      </div>
    </div>

    <div data-hero-seq="trust" class="absolute right-8 top-1/2 z-10 hidden max-w-[13rem] -translate-y-[5%] xl:block">
      <p class="text-[0.7rem] uppercase leading-[2] tracking-[0.2em] text-paper/80">
        Granite, marble, tiles and custom stonecraft, from Karamadai since {business.since}.
      </p>
      <span data-hero-rule class="my-6 block h-px w-10 origin-left bg-brass" aria-hidden="true"></span>
      <p class="text-[0.7rem] uppercase leading-[2] tracking-[0.3em] text-paper/80">Build<br />Better Spaces</p>
    </div>

    <p data-hero-seq="caption" class="absolute bottom-3 left-5 z-10 text-[0.55rem] uppercase tracking-[0.15em] text-paper/35 lg:left-8">
      {videoZones.hero ? videoZones.hero.label : "Illustrative showroom concept · our Karamadai showroom is being transformed"}
    </p>
  </section>

  <!-- 02 — Material worlds + verified trust bar -->
  <section id="materials" class="scroll-mt-24 bg-paper pb-12 pt-8">
    <div data-gsap-stagger class="worlds mx-auto grid max-w-[96rem] grid-cols-2 gap-3 px-4 sm:px-6 lg:grid-cols-5 lg:gap-4 lg:px-8 xl:flex">
      {worlds.map((w, i) => (
        <a href={w.href} class:list={["material-card group relative isolate block aspect-[4/5] overflow-hidden bg-charcoal-deep lg:aspect-[3/4] xl:aspect-auto xl:h-[min(36rem,66vh)] xl:min-h-[27rem]", i === 4 && "col-span-2 aspect-[16/9] lg:col-span-1"]}>
          <img src={w.image} alt="" class="world-img absolute inset-0 h-full w-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/90 via-charcoal-deep/20 to-transparent"></div>
          <span class="absolute left-4 top-4 whitespace-nowrap text-[0.5rem] uppercase tracking-[0.2em] text-paper/60">{w.credit}</span>
          <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
            <span class="world-rule block h-px w-8 bg-brass" aria-hidden="true"></span>
            <h3 class="material-name mt-3 font-display text-2xl leading-tight text-paper sm:text-3xl xl:w-[10rem]">{w.label}</h3>
            <p class="material-meta mt-1 flex items-center justify-between gap-2 text-[0.6rem] uppercase tracking-[0.18em] text-paper/80">
              <span class="truncate">{w.descriptor}</span>
              <span aria-hidden="true" class="arrow text-brass">&rarr;</span>
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mx-auto mt-10 flex max-w-7xl flex-col gap-8 px-5 lg:flex-row lg:items-center lg:px-8">
      <dl class="grid flex-1 grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-3 lg:grid-cols-5">
        {facts.map((s) => (
          <div class="flex flex-col-reverse border-l border-brass/50 pl-4">
            <dt class="mt-1.5 text-[0.6rem] uppercase tracking-[0.2em] text-ink-soft">{s.label}</dt>
            <dd class="font-display text-xl text-mustard-dark sm:text-2xl">{s.value}</dd>
          </div>
        ))}
      </dl>
      <a href="#quote" class="inline-flex min-h-12 flex-shrink-0 items-center justify-center gap-3 self-start bg-gradient-to-r from-brass to-mustard-dark px-8 py-4 text-xs uppercase tracking-[0.22em] text-paper shadow-lift hover:brightness-110 transition lg:self-center">
        Request a quote
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <!-- 03 — Find your material -->
  <section class="marble-veins bg-charcoal-deep py-20 text-paper">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-brass">Find your material</p></div>
      <h2 class="mt-4 max-w-2xl font-display text-4xl sm:text-5xl">Not sure what you need? Start with the space.</h2>
      <p class="mt-4 max-w-xl text-paper/70">Tell us what you're building and finishing, and we'll point you to the materials that suit it. No jargon needed.</p>
      <div class="mt-10"><MaterialMatch /></div>
    </div>
  </section>

  <!-- 04 — Featured real materials: granite specimens from our yard -->
  <section class="bg-paper py-20">
    <div class="mx-auto flex max-w-7xl flex-wrap items-end justify-between gap-6 px-5 lg:px-8">
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">From our slab yard</p></div>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Real granite, photographed here</h2>
      </div>
      <a href="/granite/" class="inline-flex min-h-11 items-center text-xs uppercase tracking-[0.2em] underline decoration-brass underline-offset-8 hover:text-mustard-dark">All granite &rarr;</a>
    </div>
    <ul class="no-scrollbar mx-auto mt-10 flex max-w-[96rem] snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 lg:px-8" aria-label="Granite specimens">
      {specimens.map((p) => (
        <li data-velocity class="relative w-[68vw] max-w-[18rem] flex-shrink-0 snap-start">
          <div class="absolute right-2 top-2 z-10"><SaveButton product={p} hallName="Granite & Marbles" variant="overlay" /></div>
          <a href={`/products/${p.id}/`} class="group block">
            <div class="overflow-hidden bg-charcoal-deep">
              <img src={p.data.image.replace(/\.jpg$/, "-720.jpg")} alt={p.data.imageAlt} class="aspect-[3/4] w-full object-cover eb-img" loading="lazy" width="540" height="720" />
            </div>
            <span class="eb-rule mt-3" aria-hidden="true"></span>
            <p class="mt-2 font-display text-2xl leading-tight group-hover:text-mustard-dark">{p.data.name.replace(" Granite", "")}</p>
            <p class="text-[0.6rem] uppercase tracking-[0.18em] text-ink-soft">{p.data.finish} · Check availability</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 05 — Custom stonecraft -->
  <section class="bg-charcoal-deep py-20 text-paper">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8">
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-brass">Custom stonecraft</p></div>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Bring a pattern, drawing or idea.</h2>
        <p class="mt-3 font-display text-2xl text-paper/80">We help translate it into stone.</p>
        <p class="mt-6 max-w-md text-paper/70 leading-relaxed">Engraved name plates and welcome signs, tulsi madams and pooja units, granite tables and benches. Every piece shown here is our own work, delivered across India.</p>
        <a href="/custom/#tile-printing" class="group mt-6 flex max-w-md items-center gap-4 border border-paper/15 p-3 hover:border-brass">
          <img src="/media/concepts/tile-printing/printed-tiles-closeup-960.jpg" alt="" class="h-16 w-24 flex-shrink-0 object-cover" loading="lazy" />
          <span><span class="block font-display text-xl group-hover:text-brass">Custom tile printing</span><span class="text-[0.6rem] uppercase tracking-[0.16em] text-paper/55">Your image printed on tile · concept visual</span></span>
        </a>
        <ol class="mt-8 grid grid-cols-3 gap-4 text-[0.6rem] uppercase tracking-[0.16em] text-paper/70 sm:grid-cols-6 lg:grid-cols-3">
          {["Raw stone", "Design", "Engraving", "Finishing", "Installation", "Final piece"].map((s, i) => (
            <li class="border-t border-paper/20 pt-2"><span class="block font-display text-lg text-brass">{String(i + 1).padStart(2, "0")}</span>{s}</li>
          ))}
        </ol>
        <a href="/custom/" class="mt-9 inline-flex min-h-12 items-center border border-brass px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:bg-brass hover:text-charcoal-deep transition-colors">See our stonecraft</a>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {craft.slice(0, 6).map((m, i) => (
          <figure data-gsap-reveal class:list={["group overflow-hidden", i === 0 && "col-span-2 row-span-2"]}>
            <img src={m.thumb} alt={m.alt} class="eb-img h-full w-full object-cover" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 — Applications -->
  <section class="bg-card py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Applications</p></div>
      <h2 class="mt-4 font-display text-4xl sm:text-5xl">Start from the room</h2>
      <div data-gsap-stagger class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-3">
        {applications.map((a) => (
          <a href={a.href} class="group relative block aspect-[4/5] overflow-hidden bg-charcoal-deep sm:aspect-[4/3]">
            <img src={a.image} alt="" class="eb-img absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep/90 via-charcoal-deep/35 to-transparent transition-opacity duration-700 group-hover:opacity-95"></div>
            <span class="absolute left-3 top-3 text-[0.5rem] uppercase tracking-[0.2em] text-paper/60">{a.credit}</span>
            <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
              <span class="eb-rule" aria-hidden="true"></span>
              <p class="mt-2 font-display text-xl text-paper sm:text-3xl">{a.label}</p>
              <div class="app-reveal">
                <div>
                  <p class="mt-2 text-[0.55rem] uppercase tracking-[0.2em] text-brass">What you could use</p>
                  <ul class="mt-1.5 hidden flex-wrap gap-1.5 sm:flex">
                    {a.materials.map((m) => <li class="border border-paper/25 px-2 py-0.5 text-[0.6rem] uppercase tracking-[0.1em] text-paper/85">{m}</li>)}
                  </ul>
                  <p class="mt-3 flex items-center gap-2 text-[0.6rem] uppercase tracking-[0.2em] text-paper">Explore materials <span class="arrow text-brass" aria-hidden="true">&rarr;</span></p>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 06b — Free site measurement (client offer, 2026-09-16) -->
  <section class="relative isolate overflow-hidden bg-charcoal py-20 text-paper">
    <img src="/media/illustrative/laying-measurement.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover opacity-20" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/90 to-charcoal/40" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8">
      <div>
        <div class="flex items-center gap-4">
          <span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span>
          <p class="text-xs uppercase tracking-[0.3em] text-brass">Free site measurement</p>
          <span class="border border-brass/60 px-2 py-0.5 text-[0.55rem] uppercase tracking-[0.18em] text-brass">No charge</span>
        </div>
        <h2 class="mt-5 max-w-xl font-display text-4xl leading-tight sm:text-6xl">We bring the tape.<br /><span class="gold-engraved">You keep the estimate.</span></h2>
        <p class="mt-6 max-w-lg text-paper/75 leading-relaxed">
          Guessing quantities is how a job ends up short on the last row, or paying for boxes nobody
          opens. Our team comes to your site, measures room by room and works out exactly what you
          need — tiles, stone, adhesive, grout and wastage.
        </p>
        <p class="mt-3 max-w-lg text-paper/60 leading-relaxed">
          Free across Coimbatore and the surrounding region. The estimate is yours to keep, whether
          you buy from us or not.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={waLink("Hi Elite Balaji, I'd like to book a free site measurement. Location: ___, rooms/areas: ___, preferred day: ___.")}
            target="_blank"
            rel="noopener"
            data-enquire="Book a free site measurement"
            data-heading="Book a free site measurement"
            class="btn-arrow inline-flex min-h-12 items-center gap-3 bg-gradient-to-r from-brass to-mustard-dark px-8 text-xs uppercase tracking-[0.2em] text-paper hover:brightness-110"
          >
            Book my measurement
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/halls/laying-works/" class="inline-flex min-h-12 items-center border border-paper/35 px-7 text-xs uppercase tracking-[0.2em] hover:border-brass">See how we lay</a>
        </div>
      </div>
      <ul data-gsap-stagger class="grid gap-px bg-paper/10 sm:grid-cols-2">
        {[
          { t: "Room by room", d: "Exact square feet for every space, not a rounded guess." },
          { t: "Full material list", d: "Tile or stone, adhesive, grout and skirting, with wastage allowed for." },
          { t: "Layout advice", d: "Where the first row starts and where the cuts land, before you buy." },
          { t: "Yours to keep", d: "No charge and no obligation to order from us." },
        ].map((f) => (
          <li class="bg-charcoal p-6">
            <p class="font-display text-2xl text-brass">{f.t}</p>
            <p class="mt-2 text-sm text-paper/70 leading-relaxed">{f.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 07 — Why Elite Balaji -->
  <section class="bg-paper py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Why Elite Balaji</p></div>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Material, fabrication and laying, from one team</h2>
        <p class="mt-5 text-ink-soft leading-relaxed">
          Since {business.since}, homes, contractors and builders have come to our Karamadai yard for granite,
          marble, tiles and sanitaryware. Our own crews measure, lay and finish, and our stonecraft
          work is made to order. Rates move with supply, so we quote on WhatsApp or by phone.
        </p>
      </div>
      <ol class="divide-y divide-line border-y border-line self-center">
        {business.usps.map((usp, i) => (
          <li class="grid grid-cols-[3rem_1fr] gap-4 py-6 sm:grid-cols-[4rem_12rem_1fr]">
            <span class="font-display text-3xl text-brass">{String(i + 1).padStart(2, "0")}</span>
            <span class="self-center text-sm font-medium uppercase tracking-[0.12em]">{usp.title}</span>
            <span class="col-start-2 self-center text-ink-soft sm:col-start-auto">{usp.detail}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 08 — Brands -->
  <section class="border-y border-line bg-card py-14">
    <div class="mx-auto max-w-7xl px-5 text-center lg:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Brands &amp; collections we work with</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-3 font-display text-2xl text-ink-soft">
        {business.partnerBrands.map((b) => (
          <li>{productBrands.has(b) ? <a href={`/search/?q=${encodeURIComponent(b)}`} class="hover:text-ink">{b}</a> : b}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 09 — Local service area -->
  <section class="bg-paper py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-2 lg:px-8">
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Service area</p></div>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Coimbatore &amp; the surrounding region. Custom art, pan-India.</h2>
        <p class="mt-5 text-ink-soft leading-relaxed">
          Serving homes, builders, architects and projects across Coimbatore and the surrounding region
          from our Karamadai yard on Mettupalayam Main Road. Site visits, supply and our laying crews
          cover the areas listed here.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="border-l-2 border-brass pl-5">
            <p class="font-display text-2xl">Custom art, delivered across India</p>
            <p class="mt-1 text-ink-soft">Engraved stonecraft, name plates, tulsi madams and custom printed tiles are made here and shipped pan-India.</p>
            <a href="/custom/" class="mt-2 inline-flex min-h-11 items-center text-xs uppercase tracking-[0.18em] text-mustard-dark hover:text-ink">See custom work &rarr;</a>
          </div>
          <div class="border-l-2 border-line pl-5">
            <p class="font-display text-2xl">Need something specific?</p>
            <p class="mt-1 text-ink-soft">Ask us. We can help source materials beyond our displayed collection.</p>
          </div>
        </div>
      </div>
      <ul class="flex flex-wrap content-start gap-2">
        {localHubs.map((hub) => <li class="border border-line px-4 py-2 text-sm text-ink-soft">{hub}</li>)}
      </ul>
    </div>
  </section>

  <!-- 10 — Showroom transformation -->
  <section class="relative isolate overflow-hidden bg-charcoal-deep py-24 text-paper">
    {videoZones.showroom ? (
      <AmbientVideo poster={videoZones.showroom.poster} posterAlt="" src={videoZones.showroom.src} webm={videoZones.showroom.webm} mobileSrc={videoZones.showroom.mobileSrc} aspectClass="h-full w-full" class="absolute inset-0 opacity-45" />
    ) : (
      <div data-gsap-parallax class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <img data-parallax-photo src="/media/reference/hero-interior.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-35" loading="lazy" />
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal-deep via-charcoal-deep/80 to-charcoal-deep/30" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-brass">Our showroom is being transformed</p>
      <h2 class="mt-4 max-w-2xl font-display text-4xl sm:text-5xl">A new material experience is taking shape in Karamadai.</h2>
      <p class="mt-5 max-w-xl text-paper/75 leading-relaxed">While the new showroom takes shape, explore our collection online or speak directly with our team. We're happy to share photos and videos of current stock.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/gallery/" class="inline-flex min-h-12 items-center border border-brass px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:bg-brass hover:text-charcoal-deep transition-colors">Explore the gallery</a>
        <a href={waLink("Hi Elite Balaji, could you share photos of your current stock?")} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center px-5 text-xs uppercase tracking-[0.2em] underline decoration-brass underline-offset-8 hover:text-brass">Ask for stock photos</a>
      </div>
      <p class="mt-10 text-[0.55rem] uppercase tracking-[0.18em] text-paper/35">Background: illustrative concept render, not a photograph of our showroom</p>
    </div>
  </section>

  <!-- 11 — Request a quote + source it -->
  <section id="quote" class="scroll-mt-24 bg-charcoal py-20 text-paper">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div>
        <div class="flex items-center gap-4"><span data-gsap-line class="block h-px w-12 bg-brass" aria-hidden="true"></span><p class="text-xs uppercase tracking-[0.3em] text-brass">Request a quote</p></div>
        <h2 class="mt-4 font-display text-4xl sm:text-5xl">Can't find your material?</h2>
        <p class="mt-5 text-paper/75 leading-relaxed">What you see here is a curated selection. Send us any of these and our team will help find the right option:</p>
        <ul class="mt-5 grid grid-cols-2 gap-2 text-sm text-paper/80">
          {["A photo", "A product name", "A screenshot", "A catalogue page", "Colour & size", "Where it will go"].map((x) => (
            <li class="flex items-center gap-2"><span class="h-px w-4 bg-brass" aria-hidden="true"></span>{x}</li>
          ))}
        </ul>
        <a href={waLink("Hi Elite Balaji, I'm looking for this material (photo/details attached):")} target="_blank" rel="noopener" class="mt-8 inline-flex min-h-12 items-center border border-brass px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:bg-brass hover:text-charcoal-deep transition-colors">Send your requirement</a>
      </div>
      <QuoteForm id="home-quote" tone="dark" />
    </div>
  </section>

  <!-- 12 — Final CTA -->
  <section class="marble-veins bg-charcoal-deep py-24 text-center text-paper">
    <p class="text-xs uppercase tracking-[0.4em] text-paper/50">{business.tagline}</p>
    <h2 class="engraved-gold mt-4 font-display text-5xl italic sm:text-7xl">{business.subTagline}</h2>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={waLink("Hi Elite Balaji, I'd like to discuss a project.")} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center bg-gradient-to-r from-brass to-mustard-dark px-8 py-4 text-xs uppercase tracking-[0.2em] hover:brightness-110">WhatsApp our team</a>
      <a href={telLink()} class="inline-flex min-h-12 items-center border border-paper/40 px-8 py-4 text-xs uppercase tracking-[0.2em] hover:border-brass">Call {business.phoneDisplay}</a>
    </div>
  </section>
</BaseLayout>
