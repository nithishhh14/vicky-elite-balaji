---
// Where the showroom is, right under the page header.
//
// Most of the searches that find these pages end in "near me" ("kadappa
// stone near me", "kota stone shop near me"). That visitor's first question
// is "how far, and how do I get there", and until now the answer lived in
// the footer. One quiet line answers it before they scroll.
import { business, telLink, waLink } from "../lib/business";

interface Props {
  /** Prefilled WhatsApp text, so the enquiry already names what they looked at. */
  message?: string;
  lang?: "en" | "ta";
}
const { lang = "en" } = Astro.props;
const t = lang === "ta"
  ? {
      label: "ஷோரூம் இருப்பிடம்",
      showroom: "ஷோரூம்:",
      where: "மேட்டுப்பாளையம் மெயின் ரோடு, காரமடை, கோவை",
      reach: "ஷோரூமை அடைய",
      directions: "வழிகாட்டி",
      call: "அழைக்க",
      whatsapp: "வாட்ஸ்அப்",
      message: "வணக்கம் எலைட் பாலாஜி, ஷோரூமுக்கு வர விரும்புகிறேன்.",
    }
  : {
      label: "Showroom location",
      showroom: "Showroom:",
      where: "Mettupalayam Main Road, Karamadai, Coimbatore",
      reach: "Reach the showroom",
      directions: "Directions",
      call: "Call",
      whatsapp: "WhatsApp",
      message: "Hi Elite Balaji, I'd like to visit the showroom.",
    };
const message = Astro.props.message ?? t.message;
---

<aside aria-label={t.label} class="border-b border-line bg-card">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3 lg:px-8">
    <p class="flex w-full min-w-0 items-start gap-2 text-sm text-ink-soft sm:w-auto sm:flex-1">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="mt-0.5 shrink-0 text-mustard-dark" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21Z" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      <span><span class="text-ink">{t.showroom}</span> {t.where}</span>
    </p>
    <nav aria-label={t.reach} class:list={["flex flex-wrap gap-x-5 gap-y-1", lang === "ta" ? "text-sm" : "text-xs uppercase tracking-[0.18em]"]}>
      <a href={business.mapLink} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-ink hover:text-mustard-dark">{t.directions}</a>
      <a href={telLink()} class="inline-flex min-h-11 items-center text-ink hover:text-mustard-dark">{t.call}</a>
      <a href={waLink(message)} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-ink hover:text-mustard-dark">{t.whatsapp}</a>
    </nav>
  </div>
</aside>
