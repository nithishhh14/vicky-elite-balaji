---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { business, telLink, waLink } from "../lib/business";
---

<BaseLayout
  title="Contact & Request a Quote | Elite Balaji"
  description="Request a quote for granite, marble, tiles, basins or custom stonecraft from Elite Balaji, Mettupalayam Main Road, Karamadai, Coimbatore."
  enquiry={{ label: "Talk to Elite Balaji", shortLabel: "Talk to us", intent: "Send my project requirement" }}
>
  <PageHero
    eyebrow="Contact"
    title="Request a quote"
    intro="Tell us what you're building. We reply with what's available and a current rate, usually fastest on WhatsApp."
  />

  <!-- Free site measurement: the client's standing offer, bookable here. -->
  <section id="measure" class="scroll-mt-24 border-b border-line bg-card py-14">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3">
          <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Free site measurement</p>
          <span class="border border-brass/60 px-2 py-0.5 text-[0.55rem] uppercase tracking-[0.18em] text-mustard-dark">No charge</span>
        </div>
        <h2 class="mt-3 font-display text-4xl sm:text-5xl">Don't guess the quantity. Let us measure it.</h2>
        <p class="mt-4 text-ink-soft leading-relaxed">
          Pick a day, and our team visits your site anywhere in Coimbatore and the surrounding region.
          We measure room by room, allow for cuts, skirting and wastage, and hand you the full material
          list. Free, and yours to keep whether you order from us or not.
        </p>
      </div>
      <a
        href={waLink("Hi Elite Balaji, I'd like to book a free site measurement. Location: ___, rooms/areas: ___, preferred day: ___.")}
        target="_blank"
        rel="noopener"
        data-enquire="Book a free site measurement"
        data-heading="Book a free site measurement"
        class="btn-arrow inline-flex min-h-12 flex-shrink-0 items-center gap-3 bg-gradient-to-r from-brass to-mustard-dark px-8 text-xs uppercase tracking-[0.2em] text-paper hover:brightness-110"
      >
        Book my measurement
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <section class="bg-paper py-16">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 lg:grid-cols-[1.15fr_0.85fr] lg:px-8">
      <div>
        <h2 class="font-display text-3xl">Your requirement</h2>
        <div class="mt-6"><QuoteForm id="contact-quote" /></div>
      </div>

      <aside class="lg:border-l lg:border-line lg:pl-12">
        <h2 class="font-display text-3xl">Talk to our team</h2>
        <dl class="mt-6 space-y-5 text-sm">
          <div>
            <dt class="text-[0.65rem] uppercase tracking-[0.2em] text-ink-soft">Phone & WhatsApp</dt>
            <dd class="mt-1"><a href={telLink()} class="font-display text-2xl text-ink hover:text-mustard-dark">{business.phoneDisplay}</a></dd>
            <dd class="text-ink-soft">{business.contactPerson}</dd>
          </div>
          <div>
            <dt class="text-[0.65rem] uppercase tracking-[0.2em] text-ink-soft">Email</dt>
            <dd class="mt-1 break-all"><a href={`mailto:${business.email}`} class="text-ink hover:text-mustard-dark">{business.email}</a></dd>
          </div>
          <div>
            <dt class="text-[0.65rem] uppercase tracking-[0.2em] text-ink-soft">Address</dt>
            <dd class="mt-1 text-ink leading-relaxed">{business.address}</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={waLink("Hi Elite Balaji, ")} target="_blank" rel="noopener" class="min-h-11 bg-whatsapp px-5 py-3 text-xs uppercase tracking-[0.18em] text-paper hover:opacity-90">WhatsApp now</a>
          <a href={business.mapLink} target="_blank" rel="noopener" class="min-h-11 border border-line px-5 py-3 text-xs uppercase tracking-[0.18em] hover:border-brass">Directions</a>
        </div>
        <div class="mt-8 overflow-hidden border border-line">
          <iframe src={business.mapEmbedSrc} title="Elite Balaji Stones & Ceramics location on Google Maps" class="h-64 w-full" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="mt-8 border-t border-line pt-6">
          <p class="text-[0.65rem] uppercase tracking-[0.2em] text-mustard-dark">Our showroom is being transformed</p>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">While the new showroom takes shape, explore the collection online or speak directly with our team. We're happy to share photos of current stock.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
