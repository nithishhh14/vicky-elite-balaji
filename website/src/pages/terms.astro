---
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../lib/business";
---

<BaseLayout
  title="Terms | Elite Balaji Stones & Ceramics"
  description="Terms of use for the Elite Balaji Stones & Ceramics website."
>
  <section class="mx-auto max-w-2xl px-5 py-20">
    <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Terms</p>
    <h1 class="mt-3 text-4xl">Terms of Use</h1>
    <p class="mt-6 text-sm text-ink-soft">Last updated: {new Date().toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}</p>

    <div class="mt-8 space-y-5 text-ink-soft leading-relaxed">
      <p>
        &copy; {business.since}-{new Date().getFullYear()} {business.name}. All content on this
        website (text, photography credited to us, and the site design) belongs to {business.name}
        unless stated otherwise. Supplier catalogue photographs remain the property of the
        respective manufacturers and are shown to illustrate the ranges we supply. Images labelled
        “Illustrative image”, “Application concept” or “Concept visual” are illustrations of the kind of
        material or work described — they are not photographs of our stock or of completed jobs.
      </p>
      <p>
        Materials, sizes, finishes and availability shown on this site are indicative. Nothing on this
        site is a price quote or an offer for sale. Trade rates and current stock are confirmed
        directly with us by phone, WhatsApp, or email before any order.
      </p>
      <p>
        We try to keep this site accurate, but wholesale material stock and pricing change with
        supply. Always confirm details with us before placing an order.
      </p>
      <p>
        Questions about these terms can be sent to{" "}
        <a href={`mailto:${business.email}`} class="text-mustard-dark hover:underline">{business.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
