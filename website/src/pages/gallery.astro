---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getCollection } from "astro:content";
import { mediaLibrary, provenanceLabel } from "../lib/media-library";
import { waLink } from "../lib/business";
import { byOrder } from "../lib/order";

// Gallery: real client material first, every image visibly labelled with
// what it is. Stock (Unsplash) product photos and colour swatches are NOT
// shown here: the gallery is for real material, real work, supplier
// catalogue imagery, and clearly-labelled ideas and renders.
type Tile = { src: string; alt: string; title: string; label: string; tone: "real" | "idea"; groups: string[]; href?: string };

const tiles: Tile[] = [];
const order: Record<string, number> = { work: 0, stock: 1, supply: 2, idea: 3 };
[...mediaLibrary]
  .sort((a, b) => order[a.provenance] - order[b.provenance])
  .forEach((m) => {
    const groups = new Set<string>();
    m.categories.forEach((c) => {
      if (c === "stonecraft" || c === "engraving" || c === "devotional" || c === "furniture" || c === "stonecraft-process") groups.add("stonecraft");
      else if (c === "applications") groups.add("spaces");
      else groups.add(c);
    });
    if (/marble/.test(m.slug)) groups.add("marble");
    if (["granite-staircase", "granite-outdoor-table-set", "granite-garden-bench"].includes(m.slug)) groups.add("spaces");
    tiles.push({
      src: m.thumb,
      alt: m.alt,
      title: m.title,
      label: m.categories.includes("stonecraft-process") ? "Process reference" : provenanceLabel[m.provenance],
      tone: m.provenance === "idea" ? "idea" : "real",
      groups: [...groups],
      href: m.productId ? `/products/${m.productId}/` : undefined,
    });
  });

// Tiles and the supplier basin catalogues: every image is a supplier
// catalogue photo, labelled as such.
const products = (await getCollection("products"))
  .filter((p) => p.data.hallId === "tiles" || (p.data.hallId === "sanitaryware" && (p.data.images?.length ?? 0) > 0))
  .sort(byOrder);
const seen = new Set<string>();
for (const p of products) {
  const isBasin = p.data.hallId === "sanitaryware";
  const marbleLook = !isBasin && /marble/i.test(`${p.data.name} ${p.data.category ?? ""}`);
  for (const img of [{ src: p.data.image, alt: p.data.imageAlt }, ...(p.data.images ?? [])]) {
    if (seen.has(img.src)) continue;
    seen.add(img.src);
    const isRoom = /room|lifestyle/.test(img.src);
    tiles.push({
      src: img.src,
      alt: img.alt,
      title: isBasin ? `${p.data.series ?? p.data.name}` : isRoom && p.data.series ? `${p.data.series} in a room` : p.data.name,
      label: p.data.brand ? `Supplier catalogue · ${p.data.brand}` : "Supplier catalogue",
      tone: "real",
      groups: isBasin
        ? ["basins", "bathroom"]
        : ["tiles", ...(marbleLook ? ["marble"] : []), ...(isRoom ? ["spaces"] : []), ...(/bath/i.test(img.alt) ? ["bathroom"] : [])],
      href: `/products/${p.id}/`,
    });
  }
}

// Generated application concepts (always labelled) and the mockup renders.
[
  { src: "/media/concepts/living-960.jpg", alt: "Concept: living room with large-format marble-look floor", title: "Living room concept", groups: ["spaces", "marble"] },
  { src: "/media/concepts/kitchen-960.jpg", alt: "Concept: kitchen with black leathered granite counters", title: "Kitchen concept", groups: ["spaces", "kitchen", "granite"] },
  { src: "/media/concepts/bathroom-960.jpg", alt: "Concept: bathroom with stone-look tiles and a vessel basin", title: "Bathroom concept", groups: ["spaces", "bathroom"] },
  { src: "/media/concepts/staircase-960.jpg", alt: "Concept: staircase in polished dark granite", title: "Staircase concept", groups: ["spaces", "granite"] },
  { src: "/media/concepts/facade-960.jpg", alt: "Concept: villa entrance with granite cladding and stone driveway", title: "Facade concept", groups: ["spaces"] },
].forEach((r) => tiles.push({ ...r, label: "Application concept", tone: "idea" }));
// Custom tile printing concepts (no finished-job photos yet).
[
  { slug: "pooja-mural", alt: "Concept: pooja room mural of printed tiles with a golden lotus", title: "Printed tile mural", groups: ["tiles", "spaces", "stonecraft"] },
  { slug: "kitchen-backsplash", alt: "Concept: printed tile kitchen backsplash of misty tea hills", title: "Printed tile backsplash", groups: ["tiles", "kitchen", "spaces"] },
  { slug: "entrance-feature-wall", alt: "Concept: printed tile feature wall with a peacock", title: "Printed tile feature wall", groups: ["tiles", "spaces"] },
  { slug: "printed-tiles-closeup", alt: "Concept: printed tiles with heritage and landscape designs", title: "Custom printed tiles", groups: ["tiles", "stonecraft"] },
].forEach((r) => tiles.push({ src: `/media/concepts/tile-printing/${r.slug}-960.jpg`, alt: r.alt, title: r.title, groups: r.groups, label: "Concept visual · custom tile printing", tone: "idea", href: "/custom/#tile-printing" }));
[
  { src: "/media/reference/hero-interior.jpg", alt: "Concept render of a marble showroom reception", title: "Showroom concept" },
  { src: "/media/reference/card-exterior.jpg", alt: "Concept render of a marble-clad building entrance", title: "Exterior concept" },
].forEach((r) => tiles.push({ ...r, label: "Illustrative render", tone: "idea", groups: ["spaces"] }));

const groups = [
  { id: "all", label: "All" },
  { id: "granite", label: "Granite" },
  { id: "marble", label: "Marble" },
  { id: "stonecraft", label: "Stonecraft" },
  { id: "tiles", label: "Tiles" },
  { id: "basins", label: "Basins" },
  { id: "kitchen", label: "Kitchen" },
  { id: "bathroom", label: "Bathroom" },
  { id: "spaces", label: "Spaces & concepts" },
]
  .map((g) => ({ ...g, count: g.id === "all" ? tiles.length : tiles.filter((t) => t.groups.includes(g.id)).length }))
  .filter((g) => g.count > 0);
---

<BaseLayout
  title="Gallery: Granite, Stonecraft & Tiles | Elite Balaji"
  description="Granite slabs from our Karamadai yard, our own stonecraft, tile collections and wash basin ranges, in one labelled gallery."
>
  <PageHero
    eyebrow="Gallery"
    title="Real stone, real work"
    intro="Slabs from our yard, pieces we have made, and the tile collections we work with. Every image is labelled with what it is."
  />

  <section class="bg-paper py-12">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="-mx-5 overflow-x-auto px-5 lg:mx-0 lg:px-0">
        <div class="flex w-max gap-2" role="group" aria-label="Filter gallery">
          {groups.map((g, i) => (
            <button
              type="button"
              data-filter={g.id}
              aria-pressed={i === 0 ? "true" : "false"}
              class="min-h-11 whitespace-nowrap border border-line px-4 py-2 text-xs uppercase tracking-[0.16em] text-ink-soft transition-colors hover:border-brass aria-pressed:border-brass aria-pressed:bg-brass aria-pressed:text-paper"
            >
              {g.label} <span class="opacity-60">{g.count}</span>
            </button>
          ))}
        </div>
      </div>

      <div id="gallery-grid" class="mt-8 columns-2 gap-3 md:columns-3 lg:columns-4">
        {tiles.map((t) => {
          const Tag = t.href ? "a" : "figure";
          return (
            <Tag href={t.href} data-groups={t.groups.join(" ")} data-reveal-img class="group relative mb-3 block break-inside-avoid overflow-hidden bg-charcoal-deep">
              <img src={t.src} alt={t.alt} class="w-full eb-img" loading="lazy" />
              <span class="absolute inset-x-0 bottom-0 flex flex-col gap-0.5 bg-gradient-to-t from-charcoal-deep/90 via-charcoal-deep/50 to-transparent p-3 pt-10">
                <span class="text-xs text-paper">{t.title}</span>
                <span class:list={["text-[0.55rem] uppercase tracking-[0.18em]", t.tone === "idea" ? "text-paper/55" : "text-brass"]}>{t.label}</span>
              </span>
            </Tag>
          );
        })}
        <!-- Always-visible last tile: every filter ends with a way forward. -->
        <a data-groups="*" href={waLink("Hi Elite Balaji, could you share photos or a video of your current stock?")} target="_blank" rel="noopener" class="mb-3 flex aspect-[4/3] break-inside-avoid flex-col justify-end bg-charcoal-deep p-5 text-paper hover:bg-charcoal">
          <span class="font-display text-2xl leading-tight">Want to see more?</span>
          <span class="mt-2 text-sm text-paper/70">Our yard changes every week. Ask for current stock photos or a video.</span>
          <span class="mt-4 text-[0.6rem] uppercase tracking-[0.2em] text-brass">WhatsApp us &rarr;</span>
        </a>
      </div>
      <p class="mt-6 max-w-2xl text-xs text-ink-soft/80">
        “Our work” and “From our stock” are Elite Balaji's own photographs. “Application idea”,
        “Process reference” and “Illustrative render” images show possibilities and are not our projects.
        Our Karamadai showroom is being transformed.
      </p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll("[data-filter]");
      var grid = document.getElementById("gallery-grid");
      var items = document.querySelectorAll("#gallery-grid [data-groups]");
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var timer;
      // Filter change: the grid dips out, re-flows, then settles back in, so
      // the masonry never visibly jumps between layouts.
      buttons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var f = btn.getAttribute("data-filter");
          buttons.forEach(function (b) { b.setAttribute("aria-pressed", String(b === btn)); });
          function apply() {
            items.forEach(function (el) {
              var g = el.getAttribute("data-groups");
              el.hidden = g !== "*" && f !== "all" && g.split(" ").indexOf(f) === -1;
              el.style.opacity = "";
              el.style.transform = "";
              el.style.clipPath = "";
            });
          }
          if (reduce) return apply();
          clearTimeout(timer);
          grid.style.transition = "opacity .22s ease, translate .5s cubic-bezier(.16,1,.3,1)";
          grid.style.opacity = "0";
          timer = setTimeout(function () {
            apply();
            grid.style.translate = "0 10px";
            requestAnimationFrame(function () {
              grid.style.transition = "opacity .45s ease, translate .6s cubic-bezier(.16,1,.3,1)";
              grid.style.opacity = "1";
              grid.style.translate = "0 0";
            });
          }, 220);
        });
      });
    })();
  </script>
</BaseLayout>
