---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, emailQuoteLink, productEnquiryMessage } from "../../lib/business";
import { deriveColours, deriveCharacterTags, deriveApplicationTags } from "../../lib/facets";

export async function getStaticPaths() {
  const tileProducts = await getCollection("tileProducts");
  const materialProducts = await getCollection("materialProducts");

  const tilePaths = tileProducts.map((p) => ({
    params: { id: p.id },
    props: { kind: "tile" as const, product: p, hallId: "tiles" },
  }));
  const materialPaths = materialProducts.map((p) => ({
    params: { id: p.id },
    props: { kind: "material" as const, product: p, hallId: p.data.hallId },
  }));
  return [...tilePaths, ...materialPaths];
}

const { kind, product, hallId } = Astro.props;

const name = kind === "tile" ? `${product.data.series}${"code" in product.data && product.data.code ? ` ${product.data.code}` : ""}` : product.data.name;
const image = product.data.image;
const imageAlt = product.data.imageAlt;

const hallNames: Record<string, string> = {
  tiles: "Tiles",
  "granite-marbles": "Granite & Marbles",
  "kota-stone": "Kota Stone",
  kadappa: "Kadappa",
  sanitaryware: "Sanitaryware",
  adhesive: "Adhesive & Accessories",
  quartz: "Quartz",
  "laying-works": "Laying Works",
};
const hallName = hallNames[hallId] ?? hallId;

// Related: other real products from the same hall (tile products only relate
// to other tile products; material products relate within the same hallId),
// ranked by shared derived facets (colour/character/application) so "related"
// means genuinely similar, not just "next in the list" -- still entirely
// computed from real fields, nothing invented.
function facetSetFor(p: typeof product): Set<string> {
  const name = "brand" in p.data ? `${p.data.series}${p.data.code ? ` ${p.data.code}` : ""}` : p.data.name;
  return new Set([
    ...deriveColours(name, p.data.finish, p.data.imageAlt),
    ...deriveCharacterTags(name, p.data.finish, p.data.imageAlt),
    ...deriveApplicationTags(p.data.applications),
  ]);
}

const productFacets = facetSetFor(product);
function overlapScore(p: typeof product): number {
  const other = facetSetFor(p);
  let score = 0;
  other.forEach((tag) => { if (productFacets.has(tag)) score += 1; });
  return score;
}

const allTile = kind === "tile" ? (await getCollection("tileProducts")).sort((a, b) => a.data.order - b.data.order) : [];
const allMaterial = kind === "material" ? (await getCollection("materialProducts")).filter((p) => p.data.hallId === hallId).sort((a, b) => a.data.order - b.data.order) : [];
const candidates = (kind === "tile" ? allTile : allMaterial).filter((p) => p.id !== product.id);
const related = candidates
  .map((p) => ({ p, score: overlapScore(p) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ p }) => p);
---

<BaseLayout
  title={`${name} | ${hallName} | Elite Balaji Stones & Ceramics`}
  description={kind === "tile" ? `${name}: ${product.data.size}, ${product.data.finish}. Ask for trade rate.` : `${product.data.name}: ${product.data.category}, ${product.data.finish}. Ask for trade rate.`}
  enquiryMessage={productEnquiryMessage(name)}
>
  <nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-5 pt-6 text-xs uppercase tracking-wide text-ink-soft">
    <a href="/halls/" class="hover:text-terracotta">All halls</a>
    <span class="mx-2">/</span>
    <a href={`/halls/${hallId}/`} class="hover:text-terracotta">{hallName}</a>
    <span class="mx-2">/</span>
    <span class="text-ink">{name}</span>
  </nav>

  <!-- Let the material occupy the screen: one large image, not a boxed
       half-width thumbnail next to a wall of UI. object-contain on a mat
       background (not object-cover) because the real catalogue assets are a
       mix of full-bleed lifestyle photos and small swatch cards with their
       own white borders -- cropping the swatch cards to fill the frame would
       cut off real card content, not just empty space. -->
  <section class="mx-auto max-w-6xl px-5 pt-6">
    <div class="flex h-[50vh] min-h-[340px] items-center justify-center overflow-hidden rounded-sm bg-card">
      <img src={image} alt={imageAlt} class="h-full w-full object-contain" width="1600" height="1000" fetchpriority="high" />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-10 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-terracotta">{hallName}</p>
    <h1 class="mt-2 font-display text-4xl sm:text-5xl">{name}</h1>

    <div class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-ink-soft">
      {kind === "tile" ? (
        <>
          <span><span class="text-ink-soft/60">Brand</span> · {product.data.brand}</span>
          <span><span class="text-ink-soft/60">Size</span> · {product.data.size}</span>
          <span><span class="text-ink-soft/60">Finish</span> · {product.data.finish}</span>
        </>
      ) : (
        <>
          <span><span class="text-ink-soft/60">Category</span> · {product.data.category}</span>
          <span><span class="text-ink-soft/60">Finish</span> · {product.data.finish}</span>
        </>
      )}
    </div>
    <p class="mt-3 text-sm text-ink-soft">{product.data.applications.join(" · ")}</p>
    {kind === "tile" && <p class="mt-1 text-xs uppercase tracking-wide text-ink-soft/50">{product.data.sourceCatalogue}</p>}

    <p class="mx-auto mt-5 max-w-md text-sm italic text-ink-soft">{product.data.note}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={waLink(productEnquiryMessage(name))}
        target="_blank"
        rel="noopener"
        aria-label={`Ask for trade rate on ${name} via WhatsApp`}
        class="rounded-full bg-terracotta px-6 py-3 text-sm font-semibold uppercase tracking-wide text-paper hover:bg-terracotta-dark transition-colors"
      >
        Enquire via WhatsApp
      </a>
      <a
        href={telLink()}
        aria-label="Call our showroom"
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
      >
        Call Showroom
      </a>
      <a
        href={emailQuoteLink(name)}
        aria-label={`Request an email quote for ${name}`}
        class="rounded-full border border-line px-6 py-3 text-sm font-semibold uppercase tracking-wide text-ink-soft hover:border-terracotta hover:text-terracotta transition-colors"
      >
        Request Email Quote
      </a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="border-t border-line/60 bg-card">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <p class="text-xs uppercase tracking-[0.25em] text-terracotta">Related in {hallName}</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {related.map((r) => {
            const rName = "brand" in r.data ? `${r.data.series}${r.data.code ? ` ${r.data.code}` : ""}` : r.data.name;
            return (
              <a href={`/products/${r.id}/`} class="group block overflow-hidden rounded-sm border border-line bg-paper">
                <div class="aspect-[4/3] overflow-hidden">
                  <img src={r.data.image} alt={r.data.imageAlt} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                </div>
                <div class="p-4">
                  <h3 class="text-sm group-hover:text-terracotta transition-colors">{rName}</h3>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
