---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Elite Balaji Stones & Ceramics" description="This page could not be found.">
  <section class="mx-auto max-w-xl px-5 py-32 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-bottle">404</p>
    <h1 class="mt-3 text-4xl">This room isn't in the showroom</h1>
    <p class="mt-4 text-ink-soft">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-bottle px-6 py-3 text-sm font-semibold uppercase tracking-wide text-paper hover:bg-bottle-dark transition-colors">
      Back to entrance
    </a>
  </section>
</BaseLayout>
