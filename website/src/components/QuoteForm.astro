---
// Quote request. The site is static with no backend, so the form composes a
// structured message and hands it to WhatsApp (or email). Nothing is sent to
// a server; the confirmation state says exactly that. Reference images are
// attached in WhatsApp itself, since uploads need a backend.
import { business } from "../lib/business";

interface Props {
  id?: string;
  tone?: "light" | "dark";
  compact?: boolean;
}
const { id = "quote-form", tone = "light", compact = false } = Astro.props;
const dark = tone === "dark";

const projectTypes = ["Home", "Villa", "Apartment", "Office", "Hotel / restaurant", "Temple", "Commercial", "Renovation", "Other"];
const materials = ["Granite", "Marble", "Tiles", "Quartz", "Kota stone", "Kadappa", "Sanitaryware", "Bath fittings", "Adhesives & grout", "Custom stonecraft", "Laying / installation", "Not sure yet"];
const timelines = ["Immediately", "Within 1 month", "1–3 months", "Just planning"];

const field = dark
  ? "mt-1.5 w-full border border-paper/20 bg-paper/5 px-3.5 py-3 text-sm text-paper placeholder:text-paper/35 focus:border-brass focus:outline-none"
  : "mt-1.5 w-full border border-line bg-paper px-3.5 py-3 text-sm text-ink placeholder:text-ink-soft/50 focus:border-brass focus:outline-none";
const label = dark ? "block text-[0.65rem] uppercase tracking-[0.18em] text-paper/70" : "block text-[0.65rem] uppercase tracking-[0.18em] text-ink-soft";
---

<div class:list={["quote-form", dark ? "text-paper" : "text-ink"]} data-quote-root={id}>
  <form id={id} novalidate aria-describedby={`${id}-note`}>
    <div class:list={["grid gap-4", compact ? "sm:grid-cols-2" : "sm:grid-cols-2"]}>
      <label class={label}>Name *
        <input name="name" type="text" autocomplete="name" required class={field} />
      </label>
      <label class={label}>Phone *
        <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9+\s-]{8,}" class={field} />
      </label>
      <label class={label}>Location
        <input name="location" type="text" placeholder="e.g. Mettupalayam" class={field} />
      </label>
      <label class={label}>Project type
        <select name="project" class={field}>
          <option value="">Select</option>
          {projectTypes.map((p) => <option>{p}</option>)}
        </select>
      </label>
      <label class={label}>Material *
        <select name="material" required class={field}>
          <option value="">Select</option>
          {materials.map((m) => <option>{m}</option>)}
        </select>
      </label>
      <label class={label}>Timeline
        <select name="timeline" class={field}>
          <option value="">Select</option>
          {timelines.map((t) => <option>{t}</option>)}
        </select>
      </label>
      <label class:list={[label, "sm:col-span-2"]}>Approximate quantity (optional)
        <input name="quantity" type="text" placeholder="e.g. 1,200 sq ft, or 3 kitchen slabs" class={field} />
      </label>
      {!compact && (
        <label class:list={[label, "sm:col-span-2"]}>Message
          <textarea name="message" rows="3" placeholder="Size, colour, finish, or anything you've already seen" class={field}></textarea>
        </label>
      )}
    </div>

    <p id={`${id}-error`} class="mt-3 hidden text-sm text-terracotta" role="alert"></p>
    <p id={`${id}-note`} class:list={["mt-4 text-xs leading-relaxed", dark ? "text-paper/55" : "text-ink-soft"]}>
      Have a photo, screenshot or catalogue page? Attach it in WhatsApp after it opens. This form doesn't upload or store anything.
    </p>

    <div class="mt-5 flex flex-col gap-2 sm:flex-row">
      <button type="submit" value="whatsapp" class="min-h-12 flex-1 bg-gradient-to-r from-brass to-mustard-dark px-6 py-3.5 text-xs font-medium uppercase tracking-[0.2em] text-paper hover:brightness-110 transition">
        Request quote on WhatsApp
      </button>
      <button type="submit" value="email" class:list={["min-h-12 border px-6 py-3.5 text-xs uppercase tracking-[0.2em] transition-colors", dark ? "border-paper/30 hover:border-brass" : "border-line hover:border-brass"]}>
        By email
      </button>
    </div>
  </form>

  <div id={`${id}-done`} hidden tabindex="-1" class:list={["border p-6", dark ? "border-brass/50 bg-paper/5" : "border-brass/50 bg-card"]} aria-live="polite">
    <span class="block h-px w-12 bg-brass" aria-hidden="true"></span>
    <p class="mt-4 font-display text-3xl">Your request is ready</p>
    <p class:list={["mt-2 text-sm leading-relaxed", dark ? "text-paper/75" : "text-ink-soft"]}>
      We've opened it in <span data-channel>WhatsApp</span> with your details filled in. Press send there to reach our team. If nothing opened:
    </p>
    <div class="mt-4 flex flex-wrap gap-4 text-xs uppercase tracking-[0.18em]">
      <a data-fallback-wa href={`https://wa.me/${business.phoneWa}`} target="_blank" rel="noopener" class="border-b border-brass pb-1">Open WhatsApp</a>
      <a href={`tel:${business.phoneTel}`} class="border-b border-brass pb-1">Call {business.phoneDisplay}</a>
      <button type="button" data-reset class="border-b border-current pb-1 opacity-70">Edit request</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ id, phoneWa: business.phoneWa, email: business.email }}>
  (function () {
    var form = document.getElementById(id);
    var done = document.getElementById(id + "-done");
    var error = document.getElementById(id + "-error");
    if (!form || !done) return;
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var d = new FormData(form);
      var v = function (k) { return (d.get(k) || "").toString().trim(); };
      var missing = [];
      if (!v("name")) missing.push("name");
      if (!/[0-9]{8,}/.test(v("phone").replace(/[^0-9]/g, ""))) missing.push("a valid phone number");
      if (!v("material")) missing.push("material");
      if (missing.length) {
        error.textContent = "Please add " + missing.join(", ") + ".";
        error.classList.remove("hidden");
        return;
      }
      error.classList.add("hidden");
      var lines = [
        "Hi Elite Balaji, I'd like a quote.",
        "Name: " + v("name"),
        "Phone: " + v("phone"),
        v("location") && "Location: " + v("location"),
        v("project") && "Project: " + v("project"),
        "Material: " + v("material"),
        v("quantity") && "Quantity: " + v("quantity"),
        v("timeline") && "Timeline: " + v("timeline"),
        v("message") && "Details: " + v("message"),
      ].filter(Boolean);
      var viaEmail = e.submitter && e.submitter.value === "email";
      var text = lines.join("\n");
      var wa = "https://wa.me/" + phoneWa + "?text=" + encodeURIComponent(text);
      if (viaEmail) {
        window.location.href = "mailto:" + email + "?subject=" + encodeURIComponent("Quote request: " + v("material")) + "&body=" + encodeURIComponent(text);
      } else {
        window.open(wa, "_blank", "noopener");
      }
      done.querySelector("[data-channel]").textContent = viaEmail ? "your email app" : "WhatsApp";
      done.querySelector("[data-fallback-wa]").href = wa;
      form.hidden = true;
      done.hidden = false;
      done.focus();
    });
    done.querySelector("[data-reset]").addEventListener("click", function () {
      done.hidden = true;
      form.hidden = false;
      form.querySelector("input").focus();
    });
  })();
</script>
