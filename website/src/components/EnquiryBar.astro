---
import { waLink, defaultEnquiryMessage } from "../lib/business";

interface Props {
  message?: string;
  // Contextual label: "Ask about this material", "Discuss custom work"...
  label?: string;
  shortLabel?: string;
  // Context passed to the enquiry drawer.
  product?: string;
  category?: string;
  intent?: string;
}

const {
  message = defaultEnquiryMessage,
  label = "Ask for trade rate",
  shortLabel = "Enquire",
  product,
  category,
  intent = "Ask price & availability",
} = Astro.props;
---

<!-- Dark with a gold border to sit with the charcoal/gold palette; the
     WhatsApp glyph keeps its brand green for instant recognition. One calm
     entrance (global.css .enquiry-cta), no endless pulse. Opens the enquiry
     drawer with this page's context; the wa.me href is the no-JS fallback. -->
<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  data-enquire={intent}
  data-product={product}
  data-category={category}
  data-heading={product ? undefined : label}
  class="enquiry-cta group fixed bottom-5 right-5 z-40 flex items-center gap-3 rounded-full border border-brass/70 bg-charcoal-deep py-2.5 pl-2.5 pr-5 text-sm font-semibold uppercase tracking-wide text-paper shadow-lift transition-[translate,opacity,border-color] duration-500 hover:-translate-y-0.5 hover:border-brass"
  aria-label={`${label} on WhatsApp`}
>
  <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-whatsapp eb-img">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="text-paper" aria-hidden="true">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.36 5.07L2 22l5.06-1.33A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18c-1.62 0-3.14-.44-4.44-1.2l-.32-.19-3 .79.8-2.92-.2-.3A7.94 7.94 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8Zm4.4-5.6c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1-.37-1.9-1.17-.7-.62-1.17-1.39-1.31-1.63-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.4-.14 0-.3-.02-.46-.02s-.42.06-.64.3c-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.46-.28Z"/>
    </svg>
  </span>
  <span class="hidden text-brass sm:inline">{label}</span>
  <span class="text-brass sm:hidden">{shortLabel}</span>
</a>
