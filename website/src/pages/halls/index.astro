---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaterialField from "../../components/MaterialField.astro";
import { getCollection } from "astro:content";

const halls = (await getCollection("halls")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Showroom Halls — Elite Balaji Stones & Ceramics"
  description="All eight halls: tiles, granite & marbles, kota stone, kadappa, sanitaryware, adhesive & accessories, quartz and laying works."
>
  <section class="mx-auto max-w-6xl px-5 pb-8 pt-16">
    <p class="text-xs uppercase tracking-[0.3em] text-terracotta">Virtual showroom</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">All halls</h1>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-5 pb-24 sm:grid-cols-2 lg:grid-cols-3">
    {halls.map((hall) => (
      <a href={`/halls/${hall.id}/`} class="group block overflow-hidden rounded-sm shadow-card">
        <div class="aspect-[4/3]">
          {hall.data.hasRealContent ? (
            <img
              src={hall.data.heroImage}
              alt={hall.data.heroAlt}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              loading="lazy"
            />
          ) : (
            <MaterialField color={hall.data.materialColor} texture={hall.data.materialTexture} label={hall.data.tagline} class="h-full" />
          )}
        </div>
        <div class="bg-card p-5">
          <span class="text-xs uppercase tracking-[0.2em] text-terracotta">{String(hall.data.order).padStart(2, "0")}</span>
          <h2 class="mt-1 text-xl group-hover:text-terracotta transition-colors">{hall.data.name}</h2>
          <p class="mt-1 text-sm text-ink-soft">{hall.data.tagline}</p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>
