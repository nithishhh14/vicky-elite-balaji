---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, productEnquiryMessage } from "../lib/business";
import { mediaLibrary, mediaIn, provenanceLabel } from "../lib/media-library";

// Custom Stonecraft: built around Elite Balaji's own finished work
// (provenance "work" in media-library.ts). The two process photos from the
// client's forwarded references are labelled "Process reference", never
// presented as our workshop.
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const bySlug = (slug: string) => mediaLibrary.find((m) => m.slug === slug)!;

const process = [
  { step: "01", title: "Raw stone", detail: "Choose the granite or marble from our yard, or we source the block you want.", media: bySlug("black-galaxy-slabs"), label: provenanceLabel.stock },
  { step: "02", title: "Design", detail: "Bring a pattern, drawing, photo or lettering. We work out size, depth and layout with you.", media: bySlug("house-name-plate"), label: provenanceLabel.work },
  { step: "03", title: "CNC & engraving", detail: "Motifs, lettering and profiles are cut and engraved into the stone.", media: bySlug("idea-cnc-engraving"), label: "Process reference" },
  { step: "04", title: "Hand finishing", detail: "Edges, curves and details are refined by hand, then polished or honed.", media: bySlug("idea-hand-finishing"), label: "Process reference" },
  { step: "05", title: "Installation", detail: "Delivered and fixed on site, whether in a garden, a pooja room or an entrance.", media: bySlug("granite-garden-bench"), label: provenanceLabel.work },
  { step: "06", title: "Final piece", detail: "A piece in natural stone, made for one place.", media: bySlug("tulsi-madam-engraved-black"), label: provenanceLabel.work },
];

const collections = [
  { id: "engraving", title: "Engraved signs & name plates", blurb: "House names, welcome signs and decorative motifs engraved into black granite, with gold-filled lettering on request.", items: mediaIn("engraving", "work") },
  { id: "devotional", title: "Tulsi madams & pooja units", blurb: "Tulsi madams and pooja units in black, grey and red granite or white marble, with engraved deity panels and lotus crowns.", items: mediaIn("devotional", "work") },
  { id: "furniture", title: "Stone furniture", blurb: "Dining tables, outdoor table sets and garden benches cut from solid granite to last outdoors for decades.", items: mediaIn("furniture", "work") },
];
const hero = bySlug("tulsi-madam-engraved-black");
---

<BaseLayout
  title="Custom Stonecraft, Granite Engraving & Name Plates | Elite Balaji, Coimbatore"
  description="Custom granite and marble work from Elite Balaji, Karamadai: engraved name plates and signs, tulsi madams, pooja units, granite tables and benches, made to order for Coimbatore homes."
  enquiryMessage="Hi Elite Balaji, I have an idea for a custom stone piece. Here are the details:"
>
  <section class="relative isolate overflow-hidden bg-charcoal-deep text-paper">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 pb-16 pt-32 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:px-8 lg:pt-40">
      <div data-gsap-hero>
        <p class="text-xs uppercase tracking-[0.45em] text-brass">Custom stonecraft</p>
        <h1 class="mt-5 font-display text-[clamp(3rem,8vw,6.5rem)] font-medium leading-[0.92]">Bring an idea.<br /><span class="text-brass">We make it in stone &amp; tile.</span></h1>
        <p class="mt-6 max-w-lg text-lg text-paper/80 leading-relaxed">
          Bring a pattern, drawing, photo or idea. We translate it into granite, marble or printed tile:
          engraved name plates, tulsi madams, benches and tables, and custom tile murals. Delivered
          across India.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={waLink("Hi Elite Balaji, I have an idea for a custom stone piece (photo/sketch attached):")} target="_blank" rel="noopener" class="bg-gradient-to-r from-brass to-mustard-dark px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:brightness-110">Share your idea</a>
          <a href="#work" class="border border-paper/40 px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:border-brass">See our work</a>
          <a href="#tile-printing" class="border border-paper/40 px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:border-brass">Custom tile printing</a>
        </div>
      </div>
      <figure class="relative">
        <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} class="max-h-[70svh] w-full object-cover" fetchpriority="high" />
        <figcaption class="mt-3 text-[0.6rem] uppercase tracking-[0.2em] text-paper/45">{provenanceLabel.work} · {hero.title}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Custom tile printing. Visuals are generated concepts (Runway,
       2026-09-15), always labelled, until the client has finished-job photos. -->
  <section id="tile-printing" class="scroll-mt-24 bg-paper py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-end">
        <div>
          <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Custom tile printing</p>
          <h2 class="mt-3 font-display text-4xl sm:text-6xl">Your picture, printed on tile</h2>
          <p class="mt-5 max-w-lg text-ink-soft leading-relaxed">
            High-definition digital printing on vitrified and ceramic tiles, for pooja room murals,
            kitchen backsplashes, feature walls and heritage pattern recreations. Send us the image and
            the wall size, and we'll confirm what's possible.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={waLink("Hi Elite Balaji, I'd like custom printed tiles. Image: (attached). Wall size: ___. Room: ___. Location: ___.")} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center bg-gradient-to-r from-brass to-mustard-dark px-7 text-xs uppercase tracking-[0.2em] text-paper hover:brightness-110">Send your image</a>
            <span class="inline-flex min-h-12 items-center border border-line px-5 text-xs uppercase tracking-[0.18em] text-ink-soft">Delivered pan-India</span>
          </div>
        </div>
        <figure class="relative overflow-hidden bg-charcoal-deep">
          <img data-gsap-reveal src="/media/concepts/tile-printing/pooja-mural.jpg" srcset="/media/concepts/tile-printing/pooja-mural-960.jpg 960w, /media/concepts/tile-printing/pooja-mural.jpg 1920w" sizes="(min-width: 1024px) 700px, 100vw" alt="Concept: pooja room wall of printed tiles showing a golden lotus under a temple arch" class="aspect-[16/10] w-full object-cover" loading="lazy" />
          <figcaption class="absolute bottom-3 left-3 bg-charcoal-deep/70 px-3 py-1.5 text-[0.55rem] uppercase tracking-[0.2em] text-paper/80 backdrop-blur">Concept visual · pooja room mural</figcaption>
        </figure>
      </div>

      <ul data-gsap-stagger class="mt-6 grid gap-4 md:grid-cols-3">
        {[
          { slug: "kitchen-backsplash", alt: "Concept: kitchen backsplash of printed tiles showing misty tea hills", caption: "Kitchen backsplash" },
          { slug: "entrance-feature-wall", alt: "Concept: entrance feature wall of printed tiles with a peacock among foliage", caption: "Entrance feature wall" },
          { slug: "printed-tiles-closeup", alt: "Concept: printed tiles with kolam, Kerala mural, sunset and Chettinad designs", caption: "Any design, any tile" },
        ].map((c) => (
          <li>
            <figure class="relative overflow-hidden bg-charcoal-deep">
              <img src={`/media/concepts/tile-printing/${c.slug}-960.jpg`} alt={c.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
              <figcaption class="absolute bottom-3 left-3 bg-charcoal-deep/70 px-3 py-1.5 text-[0.55rem] uppercase tracking-[0.2em] text-paper/80 backdrop-blur">Concept visual · {c.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <div class="mt-14 grid gap-10 md:grid-cols-3">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em]">What you can print</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-ink-soft">
            <li>Deity art and temple motifs</li>
            <li>Landscapes and nature scenes</li>
            <li>Kolam, Chettinad and heritage patterns</li>
            <li>Family photos and memories</li>
            <li>Logos and artwork for shops and offices</li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em]">Where it goes</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-ink-soft">
            <li>Pooja rooms</li>
            <li>Kitchen backsplashes</li>
            <li>Entrance and living feature walls</li>
            <li>Bathroom accent walls</li>
            <li>Reception and commercial walls</li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.14em]">How it works</h3>
          <ol class="mt-3 space-y-1.5 text-sm text-ink-soft">
            <li><span class="font-display text-lg text-brass">01</span> Send the image and wall size</li>
            <li><span class="font-display text-lg text-brass">02</span> We confirm tile, size and finish</li>
            <li><span class="font-display text-lg text-brass">03</span> Approve the layout before printing</li>
            <li><span class="font-display text-lg text-brass">04</span> Printed, packed and delivered, or laid by our crew locally</li>
          </ol>
        </div>
      </div>
      <p class="mt-8 text-xs text-ink-soft/80">Images on this section are concept visuals showing the kind of work possible, not photographs of completed jobs.</p>
    </div>
  </section>

  <!-- Process: pinned-feeling horizontal sequence on desktop, stacked on mobile. -->
  <section data-gsap-hscroll class="flex min-h-0 flex-col justify-center overflow-hidden bg-charcoal-deep py-20 text-paper lg:min-h-screen" aria-labelledby="process-title">
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-end justify-between gap-4 px-5 lg:px-8">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-brass">How a piece is made</p>
        <h2 id="process-title" class="mt-3 font-display text-4xl sm:text-6xl">From raw stone to final piece</h2>
      </div>
      <div class="hidden h-px w-48 bg-paper/15 lg:block" aria-hidden="true"><span data-hscroll-progress class="block h-px w-full origin-left scale-x-0 bg-brass"></span></div>
    </div>
    <ol data-hscroll-track class="no-scrollbar mt-12 flex w-full snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-6 lg:gap-10 lg:px-[max(2rem,calc((100vw-80rem)/2+2rem))]">
      {process.map((s) => (
        <li class="w-[78vw] max-w-[22rem] flex-shrink-0 snap-start lg:w-[26rem] lg:max-w-none">
          <div class="overflow-hidden bg-charcoal-deep">
            <img src={s.media.thumb} alt={s.media.alt} class="aspect-[4/5] w-full object-cover lg:aspect-[4/3]" loading="lazy" />
          </div>
          <p class="mt-2 text-[0.55rem] uppercase tracking-[0.2em] text-paper/45">{s.label}</p>
          <div class="mt-3 flex items-baseline gap-3">
            <span class="font-display text-3xl text-brass">{s.step}</span>
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em]">{s.title}</h3>
          </div>
          <p class="mt-2 text-sm text-paper/70 leading-relaxed">{s.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <div id="work" class="scroll-mt-24">
    {collections.map((c, i) => (
      <section id={c.id} class:list={["py-20", i % 2 === 1 ? "bg-charcoal-deep text-paper" : "bg-card"]}>
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
            <div>
              <p class:list={["text-xs uppercase tracking-[0.3em]", i % 2 === 1 ? "text-brass" : "text-mustard-dark"]}>{String(i + 1).padStart(2, "0")} · {provenanceLabel.work}</p>
              <h2 class="mt-3 font-display text-4xl">{c.title}</h2>
            </div>
            <p class:list={["max-w-xl leading-relaxed", i % 2 === 1 ? "text-paper/75" : "text-ink-soft"]}>{c.blurb}</p>
          </div>
          <div data-gsap-stagger class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {c.items.map((m) => (
              <figure class="group">
                <div class="overflow-hidden">
                  <img src={m.thumb} alt={m.alt} class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                </div>
                <figcaption class:list={["mt-2 text-xs uppercase tracking-[0.12em]", i % 2 === 1 ? "text-paper/70" : "text-ink-soft"]}>{m.title}</figcaption>
              </figure>
            ))}
          </div>
          <a
            href={waLink(`Hi Elite Balaji, I'm interested in ${c.title.toLowerCase()}. Here's what I have in mind:`)}
            target="_blank"
            rel="noopener"
            class:list={["mt-8 inline-flex min-h-11 items-center border-b text-xs uppercase tracking-[0.2em]", i % 2 === 1 ? "border-brass text-paper hover:text-brass" : "border-mustard-dark hover:text-mustard-dark"]}
          >
            Ask about {c.title.toLowerCase()} &rarr;
          </a>
        </div>
      </section>
    ))}
  </div>

  {services.length > 0 && (
    <section class="border-t border-line bg-paper py-16">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Also made to order</p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {services.map((s) => (
            <div class="border-t border-line pt-4">
              <h3 class="text-sm font-semibold uppercase tracking-[0.12em]">{s.data.name}</h3>
              <p class="mt-2 text-sm text-ink-soft leading-relaxed">{s.data.description}</p>
              <a href={waLink(productEnquiryMessage(s.data.name))} target="_blank" rel="noopener" class="mt-1 inline-flex min-h-11 items-center text-xs font-medium uppercase tracking-[0.14em] text-mustard-dark hover:text-ink">Ask about this &rarr;</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="marble-veins bg-charcoal py-20 text-center text-paper">
    <h2 class="font-display text-4xl sm:text-5xl">Have a drawing or a photo?</h2>
    <p class="mx-auto mt-4 max-w-xl text-paper/75">Send it on WhatsApp with the size and where it will go. We'll tell you what's possible in stone and what it will take.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={waLink("Hi Elite Balaji, here's my custom stone idea (photo/sketch, size, location):")} target="_blank" rel="noopener" class="bg-gradient-to-r from-brass to-mustard-dark px-8 py-4 text-xs uppercase tracking-[0.2em] hover:brightness-110">Send your idea</a>
      <a href={telLink()} class="border border-paper/40 px-8 py-4 text-xs uppercase tracking-[0.2em] hover:border-brass">Call us</a>
    </div>
  </section>
</BaseLayout>
