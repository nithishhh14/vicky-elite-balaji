---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { waLink, telLink, productEnquiryMessage } from "../lib/business";
import { mediaIn, provenanceLabel } from "../lib/media-library";
import { stoneCategories } from "../lib/stone-varieties";
import SaveButton from "../components/SaveButton.astro";
import AmbientVideo from "../components/AmbientVideo.astro";
import { videoZones } from "../lib/video-zones";

// Granite as a hero category: every specimen below is a photograph of Elite
// Balaji's own slab stock (src/lib/media-library.ts). Names were identified
// visually and are shown with a confirm-availability note.
const products = (await getCollection("products"))
  .filter((p) => p.data.hallId === "granite-marbles" && /granite|sandstone/i.test(p.data.category ?? ""))
  .sort((a, b) => a.data.order - b.data.order);

const families = [
  { label: "Black", ids: ["granite-black-galaxy", "granite-absolute-black", "granite-absolute-black-leathered", "granite-silver-black-lappato", "granite-black-markino"] },
  { label: "Brown & red", ids: ["granite-tan-brown", "granite-tan-brown-leathered", "granite-kondagattu", "granite-marvel-red-lappato"] },
  { label: "Blue & blue-grey", ids: ["granite-blue-pearl", "granite-blue-pearl-leathered", "granite-black-pearl"] },
  { label: "Grey", ids: ["granite-steel-grey"] },
  { label: "Wood-grain", ids: ["granite-wooden", "granite-teakwood"] },
  { label: "Sandstone", ids: ["granite-sandstone"] },
].map((f) => ({ ...f, items: products.filter((p) => f.ids.includes(p.id)) }));
const stageFirst = families[0].items[0];

// Leathered & lappato collection (client photos, 2026-09-15): textured
// finishes that hide fingerprints and water marks.
const textured = products.filter((p) => /leather|lappato/i.test(p.data.finish));

const stock = mediaIn("granite", "stock");
const staircase = mediaIn("granite", "work")[0];
const kitchenIdea = mediaIn("kitchen", "idea").find((m) => m.slug === "idea-black-granite-kitchen");
const leatherCounter = stock.find((m) => m.slug === "absolute-black-leathered-countertop");
const sourceMore = stoneCategories.find((c) => c.slug === "granite");

const applications = [
  { label: "Kitchen countertops & islands", image: kitchenIdea, href: "/search/?q=granite%20kitchen" },
  { label: "Staircases & entrances", image: staircase, href: "/search/?q=granite%20stairs" },
  { label: "Leathered worktops & vanities", image: leatherCounter, href: "/products/granite-absolute-black-leathered/" },
];

const finishes = [
  { name: "Polished", detail: "Mirror gloss that deepens colour and pattern. The classic choice for floors, counters and cladding." },
  { name: "Leathered", detail: "Soft, textured sheen that hides fingerprints and water marks. Popular for black kitchen worktops." },
  { name: "Honed", detail: "Smooth and matte, with a calmer look and less glare. Ask us which varieties we can supply honed." },
  { name: "Flamed", detail: "Rough, slip-resistant texture for outdoor steps, parking and pool surrounds. Available on request." },
];

const slabImage = (id: string) => products.find((p) => p.id === id);
const hero = stock.find((m) => m.slug === "black-markino-slab") ?? stock[0];
---

<BaseLayout
  title="Granite Slabs in Coimbatore & Karamadai | Elite Balaji Stones & Ceramics"
  description="Black Galaxy, Absolute Black, Tan Brown, Steel Grey, Blue Pearl and more granite slabs from our Karamadai yard, for kitchen countertops, flooring, staircases and cladding across Coimbatore."
  enquiryMessage="Hi Elite Balaji, I'm looking for granite. Please share photos of the slabs in your yard today."
  enquiry={{ label: "Ask about granite", shortLabel: "Granite", category: "Granite", intent: "Request a sample or photos" }}
>
  <section class="relative isolate flex min-h-[78svh] items-end overflow-hidden bg-charcoal-deep text-paper">
    <div data-depth="12" class="absolute inset-0 overflow-hidden">
      {videoZones.granite ? (
        <AmbientVideo poster={videoZones.granite.poster} posterAlt={hero.alt} src={videoZones.granite.src} webm={videoZones.granite.webm} mobileSrc={videoZones.granite.mobileSrc} eager aspectClass="h-full w-full" class="absolute inset-0 opacity-70" />
      ) : (
        <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} class="absolute inset-0 h-full w-full object-cover opacity-70" fetchpriority="high" />
      )}
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal-deep via-charcoal-deep/55 to-charcoal-deep/20" aria-hidden="true"></div>
    <div data-gsap-hero class="relative mx-auto w-full max-w-7xl px-5 pb-16 pt-40 lg:px-8">
      <p class="text-xs uppercase tracking-[0.45em] text-brass">01 · Material world</p>
      <h1 class="mt-5 font-display text-[clamp(3.25rem,11vw,8rem)] font-medium leading-[0.9]">Granite</h1>
      <p class="mt-5 max-w-xl text-lg text-paper/85 leading-relaxed">
        Slabs photographed in our own yard, for kitchen countertops, floors, staircases and cladding.
        Every slab is different, so see the real thing before you choose.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#specimens" class="border border-brass px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:bg-brass hover:text-charcoal-deep transition-colors">View the slabs</a>
        <a href={waLink("Hi Elite Balaji, I'm looking for granite. Please share photos of the slabs in your yard today.")} target="_blank" rel="noopener" class="bg-gradient-to-r from-brass to-mustard-dark px-7 py-3.5 text-xs uppercase tracking-[0.2em] hover:brightness-110">Ask for today's stock</a>
      </div>
      <p class="mt-10 text-[0.6rem] uppercase tracking-[0.2em] text-paper/45">{provenanceLabel.stock} · {hero.title}</p>
    </div>
  </section>

  <!-- Leathered & lappato collection: the textured finishes, surfaced first. -->
  {textured.length > 0 && (
    <section class="bg-charcoal-deep pb-16 pt-4 text-paper">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4 border-t border-paper/10 pt-12">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-brass">New in our yard</p>
            <h2 class="mt-3 font-display text-4xl sm:text-5xl">Leathered &amp; lappato collection</h2>
            <p class="mt-3 max-w-xl text-paper/70">Textured finishes with a soft sheen. They hide fingerprints and water marks, which suits busy kitchen worktops and vanities.</p>
          </div>
          <a href={waLink("Hi Elite Balaji, please share photos and rates for your leathered and lappato granite slabs.")} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center border border-brass px-6 py-3 text-xs uppercase tracking-[0.2em] hover:bg-brass hover:text-charcoal-deep transition-colors">Ask about this collection</a>
        </div>
        <ul data-gsap-stagger class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-5">
          {textured.map((p) => (
            <li class="group relative">
              <div class="absolute right-2 top-2 z-10"><SaveButton product={p} hallName="Granite & Marbles" variant="overlay" /></div>
              <a href={`/products/${p.id}/`} class="block overflow-hidden bg-charcoal">
                <img src={p.data.image.replace(/\.jpg$/, "-720.jpg")} alt={p.data.imageAlt} class="aspect-[3/4] w-full object-cover eb-img" loading="lazy" />
              </a>
              <a href={`/products/${p.id}/`} class="mt-3 block font-display text-xl leading-tight hover:text-brass">{p.data.name.replace(" Granite", "")}</a>
              <p class="text-[0.6rem] uppercase tracking-[0.18em] text-paper/50">From our stock</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Specimens: one large material photograph per variety. -->
  <section id="specimens" class="scroll-mt-24 bg-paper py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="reveal max-w-2xl">
          <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Specimens</p>
          <h2 class="mt-3 font-display text-4xl sm:text-5xl">From our slab yard</h2>
          <p class="mt-4 text-ink-soft leading-relaxed">
            Varieties identified from our own stock photographs. Natural granite changes from block to
            block, so ask us to confirm the current slab, size and finish.
          </p>
        </div>
      </div>

      <!-- Slab stage: choose a colour family, then finish, then use. The large
           real photograph crossfades to the first matching slab; the strip
           below it holds every match, like walking along a rack of slabs. -->
      {stageFirst && (
        <div data-family-stage class="mt-10 grid grid-cols-1 overflow-hidden bg-charcoal-deep text-paper lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
          <div class="relative aspect-[4/3] overflow-hidden bg-charcoal lg:aspect-auto lg:min-h-[34rem]">
            <img data-stage-img data-active="true" src={stageFirst.data.image} alt={stageFirst.data.imageAlt} class="stage-img absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <img data-stage-img data-active="false" src={stageFirst.data.image} alt="" aria-hidden="true" class="stage-img absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-charcoal-deep/80 via-transparent to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
              <p class="text-[0.55rem] uppercase tracking-[0.22em] text-paper/55">{provenanceLabel.stock} · <span data-stage-family>{families[0].label}</span></p>
              <p data-stage-name class="mt-1 font-display text-3xl leading-tight sm:text-5xl">{stageFirst.data.name.replace(" Granite", "")}</p>
              <p data-stage-meta class="mt-1 text-xs uppercase tracking-[0.16em] text-paper/70">{stageFirst.data.finish} · {stageFirst.data.applications.slice(0, 2).join(" · ")}</p>
            </div>
          </div>
          <div class="flex flex-col gap-6 p-5 sm:p-7 lg:p-9" data-granite-filters>
            {[
              { key: "colour", label: "1 · Colour family", options: families.map((f) => f.label) },
              { key: "finish", label: "2 · Finish", options: [...new Set(products.map((p) => p.data.finish))] },
              { key: "use", label: "3 · Where it goes", options: ["Kitchen countertops", "Flooring", "Staircases", "Wall cladding", "Vanity tops"] },
            ].map((g) => (
              <div role="group" aria-label={`Filter by ${g.label.replace(/^\d · /, "").toLowerCase()}`}>
                <p class="text-[0.6rem] uppercase tracking-[0.24em] text-brass">{g.label}</p>
                <div class="mt-2.5 flex flex-wrap gap-2">
                  {g.options.map((o) => (
                    <button type="button" data-filter-key={g.key} data-filter-value={o} data-family-pick={g.key === "colour" ? "" : undefined} aria-pressed="false" class="min-h-10 border border-paper/20 px-3 py-2 text-[0.65rem] uppercase tracking-[0.12em] text-paper/75 hover:border-brass aria-pressed:border-brass aria-pressed:bg-brass aria-pressed:text-charcoal-deep">{o}</button>
                  ))}
                </div>
              </div>
            ))}
            <div class="mt-auto">
              <ul data-stage-thumbs class="no-scrollbar flex gap-2 overflow-x-auto pb-1" aria-label="Matching slabs"></ul>
              <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
                <p class="text-sm text-paper/70" aria-live="polite"><span data-granite-count class="font-display text-2xl text-brass tabular-nums">{products.length}</span> of {products.length} slabs</p>
                <button type="button" data-granite-reset hidden class="inline-flex min-h-11 items-center text-xs uppercase tracking-[0.16em] text-paper/70 underline underline-offset-4 hover:text-brass">Reset</button>
                <a data-stage-link href={`/products/${stageFirst.id}/`} class="btn-arrow ml-auto inline-flex min-h-11 items-center gap-2 text-xs uppercase tracking-[0.18em] text-brass hover:text-paper">
                  View slab
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      )}

      {families.map((family) => (
        <div id={`family-${family.label.toLowerCase().replace(/[^a-z]+/g, "-")}`} data-family class="mt-16 scroll-mt-28">
          <p class="border-b border-line pb-3 text-xs uppercase tracking-[0.25em] text-ink-soft">{family.label}</p>
          <div data-gsap-stagger class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {family.items.map((p) => (
              <article class="specimen group relative" data-colour={family.label} data-finish={p.data.finish} data-use={p.data.applications.join("|")} data-name={p.data.name.replace(" Granite", "")} data-img={p.data.image} data-thumb={p.data.image.replace(/\.jpg$/, "-720.jpg")} data-href={`/products/${p.id}/`} data-meta={`${p.data.finish} · ${p.data.applications.slice(0, 2).join(" · ")}`}>
                <div class="absolute right-3 top-3 z-10"><SaveButton product={p} hallName="Granite & Marbles" variant="overlay" /></div>
                <a href={`/products/${p.id}/`} class="block overflow-hidden bg-charcoal-deep" aria-label={`${p.data.name}: view details`}>
                  <img src={p.data.image.replace(/\.jpg$/, "-720.jpg")} alt={p.data.imageAlt} class="aspect-[4/5] w-full object-cover eb-img" loading="lazy" width="720" height="900" />
                </a>
                <div class="relative pt-4">
                  <span class="eb-rule absolute left-0 top-0" aria-hidden="true"></span>
                  <h3 class="font-display text-2xl leading-tight"><a href={`/products/${p.id}/`} class="hover:text-mustard-dark transition-colors">{p.data.name.replace(" Granite", "")}</a></h3>
                  <p class="mt-1 text-xs uppercase tracking-[0.16em] text-ink-soft">{p.data.finish} · {p.data.applications.slice(0, 2).join(" · ")}</p>
                  <div class="mt-1 flex flex-wrap gap-x-5 text-xs font-medium uppercase tracking-[0.14em]">
                    <a href={`/products/${p.id}/`} class="inline-flex min-h-11 items-center text-ink hover:text-mustard-dark">Details</a>
                    <a href={waLink(productEnquiryMessage(p.data.name, p.data.category))} target="_blank" rel="noopener" data-enquire="Ask price & availability" data-product={p.data.name} data-category={p.data.category} data-url={`/products/${p.id}/`} class="inline-flex min-h-11 items-center text-mustard-dark hover:text-ink">Check availability</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Applications -->
  <section class="bg-charcoal-deep py-20 text-paper">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-brass">Where granite goes</p>
      <h2 class="mt-3 font-display text-4xl sm:text-5xl">Built for daily use</h2>
      <div data-gsap-stagger class="mt-10 grid gap-5 md:grid-cols-3">
        {applications.map((app) => app.image && (
          <a href={app.href} class="group block">
            <div class="overflow-hidden">
              <img src={app.image.thumb} alt={app.image.alt} class="aspect-[4/3] w-full object-cover eb-img" loading="lazy" />
            </div>
            <p class="mt-4 text-sm uppercase tracking-[0.14em]">{app.label}</p>
            <p class="mt-1 text-[0.6rem] uppercase tracking-[0.2em] text-paper/45">{provenanceLabel[app.image.provenance]}</p>
          </a>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-2 text-xs uppercase tracking-[0.14em] text-paper/70">
        {["Kitchen countertops", "Islands", "Staircases", "Flooring", "Wall cladding", "Vanity tops", "Window sills", "Commercial surfaces", "Custom fabrication"].map((a) => (
          <span class="border border-paper/15 px-3 py-1.5">{a}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Finishes -->
  <section class="bg-card py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div class="reveal">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Finishes</p>
        <h2 class="mt-3 font-display text-4xl">Same stone, different surface</h2>
        {slabImage("granite-absolute-black-leathered") && (
          <img src="/media/client/granite/absolute-black-leathered-countertop-720.jpg" alt="Close-up of a leathered black granite countertop" class="mt-8 aspect-[4/3] w-full object-cover" loading="lazy" />
        )}
      </div>
      <dl class="divide-y divide-line self-center border-y border-line">
        {finishes.map((f) => (
          <div class="grid gap-2 py-6 sm:grid-cols-[10rem_1fr]">
            <dt class="font-display text-2xl">{f.name}</dt>
            <dd class="text-ink-soft leading-relaxed">{f.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Custom fabrication -->
  <section class="bg-paper py-20">
    <div class="mx-auto flex max-w-7xl flex-col gap-10 px-5 lg:flex-row lg:items-center lg:px-8">
      <div class="grid flex-1 grid-cols-3 gap-3">
        {["/media/client/stonecraft/granite-dining-table-720.jpg", "/media/client/stonecraft/tulsi-madam-engraved-black-720.jpg", "/media/client/stonecraft/welcome-sign-720.jpg"].map((src) => (
          <img src={src} alt="" class="aspect-[3/4] w-full object-cover" loading="lazy" />
        ))}
      </div>
      <div class="max-w-md">
        <p class="text-xs uppercase tracking-[0.3em] text-mustard-dark">Custom stonecraft</p>
        <h2 class="mt-3 font-display text-4xl">Granite, cut to your idea</h2>
        <p class="mt-4 text-ink-soft leading-relaxed">Tables, benches, tulsi madams, engraved signs and name plates. This is our own work. Bring a pattern, drawing or idea and we'll help translate it into stone.</p>
        <a href="/custom/" class="mt-6 inline-block border-b border-brass pb-1 text-xs uppercase tracking-[0.2em] hover:text-mustard-dark">See our stonecraft &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Source more -->
  {sourceMore && (
    <section class="border-t border-line bg-card py-16">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <h2 class="font-display text-3xl">More varieties, on request</h2>
        <p class="mt-2 max-w-2xl text-ink-soft">We can help source other granites too. Ask us to confirm availability before planning around one.</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {sourceMore.varieties.map((v) => <li class="rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft">{v.name}</li>)}
        </ul>
      </div>
    </section>
  )}

  <script>
    const state: Record<string, string | null> = { colour: null, finish: null, use: null };
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter-key]");
    const cards = document.querySelectorAll<HTMLElement>(".specimen");
    const reset = document.querySelector<HTMLButtonElement>("[data-granite-reset]");
    const stage = document.querySelector<HTMLElement>("[data-family-stage]");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    let current = "";

    // Crossfade the large slab photo: load the next image into the hidden
    // layer, then swap which layer is active.
    function showSlab(card: HTMLElement) {
      if (!stage || card.dataset.img === current) return;
      current = card.dataset.img!;
      const [a, b] = stage.querySelectorAll<HTMLImageElement>("[data-stage-img]");
      const incoming = a.dataset.active === "true" ? b : a;
      const outgoing = incoming === a ? b : a;
      const swap = () => {
        incoming.dataset.active = "true";
        outgoing.dataset.active = "false";
        incoming.alt = card.querySelector("img")?.alt ?? "";
        incoming.removeAttribute("aria-hidden");
        outgoing.alt = "";
        outgoing.setAttribute("aria-hidden", "true");
      };
      incoming.src = card.dataset.img!;
      incoming.decode().then(swap, swap);
      stage.querySelector("[data-stage-name]")!.textContent = card.dataset.name ?? "";
      stage.querySelector("[data-stage-meta]")!.textContent = card.dataset.meta ?? "";
      stage.querySelector("[data-stage-family]")!.textContent = card.dataset.colour ?? "";
      stage.querySelector<HTMLAnchorElement>("[data-stage-link]")!.href = card.dataset.href ?? "#";
      stage.querySelectorAll<HTMLElement>("[data-stage-thumb]").forEach((t) => t.setAttribute("aria-pressed", String(t.dataset.stageThumb === card.dataset.img)));
    }

    function renderThumbs(matches: HTMLElement[]) {
      if (!stage) return;
      const list = stage.querySelector<HTMLElement>("[data-stage-thumbs]")!;
      list.innerHTML = matches
        .map((c, i) => `<li style="--i:${i}"><button type="button" data-stage-thumb="${c.dataset.img}" aria-pressed="false" aria-label="Show ${esc(c.dataset.name ?? "")}" class="group block h-16 w-14 flex-shrink-0 overflow-hidden border border-paper/15 opacity-70 hover:opacity-100 aria-pressed:border-brass aria-pressed:opacity-100"><img src="${c.dataset.thumb}" alt="" loading="lazy" class="eb-img h-full w-full object-cover" /></button></li>`)
        .join("");
      list.classList.remove("is-in");
      list.classList.add("eb-stagger");
      requestAnimationFrame(() => list.classList.add("is-in"));
    }

    function tweenCount(el: Element, to: number) {
      const from = Number(el.textContent) || 0;
      if (reduce || from === to) { el.textContent = String(to); return; }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 420);
        el.textContent = String(Math.round(from + (to - from) * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    function apply() {
      const matches: HTMLElement[] = [];
      cards.forEach((c) => {
        const ok =
          (!state.colour || c.dataset.colour === state.colour) &&
          (!state.finish || c.dataset.finish === state.finish) &&
          (!state.use || (c.dataset.use ?? "").split("|").some((u) => u.toLowerCase().includes(state.use!.toLowerCase().replace(/s$/, ""))));
        c.hidden = !ok;
        if (ok) matches.push(c);
      });
      document.querySelectorAll<HTMLElement>("[data-family]").forEach((f) => (f.hidden = !f.querySelector(".specimen:not([hidden])")));
      const count = document.querySelector("[data-granite-count]");
      if (count) tweenCount(count, matches.length);
      if (reset) reset.hidden = !Object.values(state).some(Boolean);
      renderThumbs(matches);
      if (matches[0]) showSlab(matches[0]);
      else if (stage) {
        stage.querySelector("[data-stage-name]")!.textContent = "No slab matches yet";
        stage.querySelector("[data-stage-meta]")!.textContent = "Try another finish or use, or ask us what's in the yard today";
      }
    }
    stage?.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>("[data-stage-thumb]");
      if (!t) return;
      const card = [...cards].find((c) => c.dataset.img === t.dataset.stageThumb);
      if (card) showSlab(card);
    });
    stage && renderThumbs([...cards]);
    stage?.querySelector<HTMLElement>("[data-stage-thumb]")?.setAttribute("aria-pressed", "true");
    if (cards[0]) current = cards[0].dataset.img ?? "";
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const key = b.dataset.filterKey!;
        const val = b.dataset.filterValue!;
        state[key] = state[key] === val ? null : val;
        buttons.forEach((x) => x.dataset.filterKey === key && x.setAttribute("aria-pressed", String(state[key] === x.dataset.filterValue)));
        apply();
      })
    );
    reset?.addEventListener("click", () => {
      Object.keys(state).forEach((k) => (state[k] = null));
      buttons.forEach((x) => x.setAttribute("aria-pressed", "false"));
      apply();
    });
  </script>

  <section class="marble-veins bg-charcoal py-20 text-center text-paper">
    <h2 class="font-display text-4xl sm:text-5xl">Found a granite you like?</h2>
    <p class="mx-auto mt-4 max-w-xl text-paper/75">Send us a photo, a name or a screenshot. We'll share what's in the yard today and a current rate.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={waLink("Hi Elite Balaji, I'm looking for this granite (photo/name attached):")} target="_blank" rel="noopener" class="bg-gradient-to-r from-brass to-mustard-dark px-8 py-4 text-xs uppercase tracking-[0.2em] hover:brightness-110">Send your requirement</a>
      <a href={telLink()} class="border border-paper/40 px-8 py-4 text-xs uppercase tracking-[0.2em] hover:border-brass">Call us</a>
    </div>
  </section>
</BaseLayout>
