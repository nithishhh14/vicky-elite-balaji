# Local Chrome profile for WhatsApp Web / Google sessions (created at runtime)
chrome_profile/

# Secrets
.env
google_creds.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.tmp

# Website (Astro) — and stray root-level caches from `astro --root website`
website/node_modules/
website/dist/
website/.astro/
website/npm-debug.log*
/node_modules/
/.astro/
website/qa-screens/

# Vicky data: runtime state, client media and backups stay on the machine.
# Only vicky_data/config/** and the folder skeleton (.gitkeep) are tracked.
# The `!.../` lines keep git descending into the folders, so the .gitkeep
# files survive and a fresh clone gets the same empty skeleton.
vicky_data/state/**
!vicky_data/state/**/
!vicky_data/state/**/.gitkeep
vicky_data/inbox/**
!vicky_data/inbox/**/
!vicky_data/inbox/**/.gitkeep
vicky_data/outbox/**
!vicky_data/outbox/**/
!vicky_data/outbox/**/.gitkeep
vicky_data/backups/**
!vicky_data/backups/**/
!vicky_data/backups/**/.gitkeep

# Credentials. Named files plus the shapes they arrive in, so a new one added
# next year is ignored by default instead of by someone remembering to.
google_creds.json
application_default_credentials.json
client_secret*.json
*service-account*.json
*credentials*.json
*.pem
*.p12
.env.*
!.env.example
token.json
*token*.json
.claude.json
.claude.json.bak-*

# Playwright MCP scratch output (page snapshots, console logs) — runtime only.
.playwright-mcp/
